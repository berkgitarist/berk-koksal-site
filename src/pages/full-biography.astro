---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";

const albums = [
  {
    year: "2024",
    title: "Tanrı'nın Hediyesi",
    description:
      "The first album-format Neo-Sacred Zikr release: three treatments of Tövbe Ettim, Estağfurullah Ya Gaffar through vocal, instrumental and piano/choir-centered forms."
  },
  {
    year: "2025",
    title: "Zikr Symphony",
    description:
      "The first large-scale concept album of the journey: 19 principal works, with the nineteenth work containing a further 19-part medley drawn from the wider pool of musical ideas created for the project."
  },
  {
    year: "2026",
    title: "Zikr Huu",
    description:
      "A nine-piece minimalist meditation centered on female voices, repetition, stillness and an intentionally sparse instrumental world."
  },
  {
    year: "2026",
    title: "Zikr Nur",
    description:
      "A 19-track ambient zikr album shaped by female vocals, rain atmosphere, distant thunder, piano, ney and gentle rhythm."
  },
  {
    year: "2026",
    title: "ZIKR ROCK",
    description:
      "A 19-track return to Köksal's rock and neoclassical guitar roots, with the energy and distortion gradually intensifying across the album."
  },
  {
    year: "2026",
    title: "Neo-Sacred Zikr: Classical Chorus",
    description:
      "A 19-track classical and choral work influenced by Köksal's long relationship with Mozart, Requiem writing and large sacred choir textures."
  },
  {
    year: "2026",
    title: "Neo-Sacred Zikr: One God One Love",
    description:
      "A 19-track children's choir project created from the idea that monotheist children should also have a contemporary musical language for remembering GOD."
  },
  {
    year: "2026",
    title: "ZIKR RAP",
    description:
      "A 19-track experiment that redirects the rhythmic language of rap toward remembrance and praise, opening with Bismillahirrahmanirrahim."
  },
  {
    year: "2026",
    title: "Zikr-i Batın",
    description:
      "A deeply personal 19-track work centered on inward remembrance, divine names and a final Huruf al-Muqatta'at composition."
  },
  {
    year: "2026",
    title: "ZIKR JAZZ",
    description:
      "A 19-track sacred jazz project using extended harmony, modal color and a warmer, more relaxed instrumental language."
  },
  {
    year: "2026",
    title: "ZIKR SYMPHONIC METAL",
    description:
      "A 19-movement concept album centered almost entirely on HÛ, with occasional Hay / Al-Hayy, uniting female voice, sacred choir, orchestra, pipe organ and progressive neoclassical metal."
  }
];

const productionSkills = [
  "Composition",
  "Songwriting",
  "Guitar Performance",
  "Vocals",
  "Arrangement",
  "Recording",
  "MIDI Programming",
  "Orchestration",
  "Sound Design",
  "Mixing",
  "Mastering",
  "Visual Concepts",
  "Software Development"
];

const archiveLinks = [
  ["SoundCloud Archive", "https://soundcloud.com/berkkoksal"],
  ["MüzikOnair Profile / Features", "https://muzikonair.com/baslik/berk-koksal/"],
  ["Cem Köksal — Life Tab", "http://www.akormerkezi.net/cem-koksal-life-tab_sarki-dvhnl.html"],
  ["Ahmet Kanneci — Aygız Tab", "https://tabs.ultimate-guitar.com/tab/ahmet-kanneci/aygiz-ay-giz-tabs-1498641"],
  ["Cem Köksal — Kalbim Bomboş Tab", "https://www.songsterr.com/a/wsa/cem-koksal-kalbim-bombos-tab-s28045t0"],
  ["Cem Köksal — Earthquake Part Tab", "https://e-akor.com/sarki/cem-koksal-earthquake-part-tab"]
];
---

<Layout
  title="Full Biography | Berk KÖKSAL"
  description="Read the complete life story of Berk KÖKSAL — from childhood guitar and the berkgitarist years to production, QUR'AN research, submission and the creation of Neo-Sacred Zikr."
  canonical="/full-biography/"
  ogImage="/artist/biography/hero-neo-sacred-zikr.webp"
>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="px-4 pb-12 pt-28 md:px-8 md:pb-16 md:pt-32">
      <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] border border-accent/25 shadow-2xl shadow-black/30">
        <div class="relative aspect-[4/5] sm:aspect-[16/10] md:aspect-[16/8] lg:aspect-[16/7]">
          <img
            src="/artist/biography/hero-neo-sacred-zikr.webp"
            alt="Berk Köksal and the Neo-Sacred Zikr artistic universe"
            class="absolute inset-0 h-full w-full object-cover object-center"
            fetchpriority="high"
          />

          <div class="absolute inset-0 bg-gradient-to-r from-background/95 via-background/60 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-background/20"></div>

          <div class="relative z-10 flex h-full items-end p-6 sm:p-9 md:p-12 lg:p-16">
            <div class="max-w-3xl">
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.4em] text-accent md:text-sm">
                The Complete Story
              </p>

              <h1 class="text-4xl font-heading font-bold leading-none text-maintext sm:text-5xl md:text-6xl lg:text-7xl">
                Berk KÖKSAL
              </h1>

              <p class="mt-5 text-base leading-7 text-maintext/90 sm:text-lg md:text-xl">
                Composer • Guitarist • Music Producer • Software Engineer
              </p>

              <p class="mt-1 text-lg font-bold text-accent md:text-2xl">
                Founder of Neo-Sacred Zikr
              </p>

              <a
                href="#biography"
                class="group mt-7 inline-flex items-center gap-3 rounded-full border border-maintext/25 bg-background/40 px-5 py-3 text-xs font-bold uppercase tracking-[0.2em] text-maintext backdrop-blur-md transition-all duration-300 hover:border-accent hover:bg-accent hover:text-background sm:text-sm"
              >
                <span>Discover the Journey</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div id="biography" class="mx-auto max-w-6xl space-y-10 px-5 pt-2 pb-8 md:space-y-20 md:px-8 md:pt-4 md:pb-24">

      <!-- I -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image">
          <img
            src="/artist/biography/berk-koksal-portrait.webp"
            alt="Portrait of Berk Köksal"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">I · Origins</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            A life shaped by sound, inquiry and transformation
          </h2>

          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>
              Berk Köksal was born in Istanbul on 19 December 1980. His earliest
              years were spent in the Rami area of Istanbul, where he lived until
              approximately the age of fourteen. His mother was Aynur, his father
              Hasan, and he grew up with one younger brother.
            </p>

            <p>
              Music entered his life almost as early as memory itself. His father's
              guitar was already present in the home when he was a child. Before he
              knew theory, technique or even the vocabulary of music, he was touching
              the instrument, experimenting with sound and treating it as something
              to be discovered.
            </p>

            <p>
              At one stage he explored the guitar with only a single string. What may
              appear to be a small childhood detail later became symbolic of his way
              of learning: start with what is available, listen closely, investigate
              the structure and build outward from there.
            </p>
          </div>
        </div>
      </section>

      <!-- II -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">II · Childhood and Classical Guitar</p>
        <h2 class="mb-9 max-w-4xl text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          The first formal steps
        </h2>

        <div class="grid grid-cols-1 gap-8 text-lg leading-8 text-subtext lg:grid-cols-2">
          <div class="space-y-6">
            <p>
              Around the age of twelve or thirteen, Köksal began private classical
              guitar lessons in Gaziosmanpaşa. The lessons took place in a small
              private teaching environment beneath a local commercial building and
              gave him his first systematic instrumental foundation.
            </p>
            <p>
              After leaving Rami, he lived for a period in the Yeni Doğan Çeşme area
              of Gaziosmanpaşa. When he later entered Haydarpaşa Endüstri Meslek
              Lisesi, he also spent time living with his maternal grandmother in
              Kayışdağı in order to attend school more easily.
            </p>
          </div>

          <div class="space-y-6">
            <p>
              Classical guitar soon opened the door to something larger than
              instrumental technique. Polyphony, harmony and the architecture of
              classical music increasingly attracted him. He was interested not only
              in how to play a piece, but in why the notes worked together and how a
              complete musical system was constructed.
            </p>
            <p>
              That curiosity would later connect naturally with computers, MIDI and
              the first generation of music software available to independent
              musicians.
            </p>
          </div>
        </div>
      </section>

      <!-- III -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image lg:order-2">
          <img
            src="/artist/biography/berk-koksal-metal-era.webp"
            alt="Berk Köksal during his guitar and rock music years"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="lg:order-1">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">III · MIDI, Guitar Pro and berkgitarist</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            Learning music by reconstructing it
          </h2>

          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>
              Köksal's formative years coincided with the rapid development of MIDI
              and personal-computer music tools. Guitar Pro — especially Guitar Pro 3
              — became far more than a tablature reader. It became a laboratory in
              which he could rebuild songs from the inside out.
            </p>

            <p>
              He transcribed music by ear, entering guitar, bass, drums, strings and
              other parts into MIDI and tablature. In the early internet era he used
              the online name <strong class="text-maintext">berkgitarist</strong>,
              sharing tabs, chords, MIDI files and Guitar Pro arrangements across
              music communities and archive sites.
            </p>

            <p>
              His work included transcriptions connected with Yngwie Malmsteen,
              Jason Becker, Steve Vai, Cem Köksal and other guitar-centered music.
              Rather than simply reading existing notation, he trained his ear by
              finding the notes himself. This process became one of the most
              important forms of musical education in his life.
            </p>

            <p>
              To reconstruct a complete arrangement, he had to understand not only
              the guitar but the relationship between rhythm, bass, harmony, drums,
              strings and counterpoint. In this way, transcription gradually became
              composition training.
            </p>
          </div>
        </div>
      </section>

      <!-- ARCHIVE -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">Early Internet Archive</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          Traces of the berkgitarist years
        </h2>
        <p class="mb-8 max-w-4xl text-lg leading-8 text-subtext">
          Some of Köksal's early internet activity and later independent work can
          still be found across music archives and artist platforms. These links are
          preserved as part of the public record of that period.
        </p>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {archiveLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-2xl border border-accent/20 bg-accent/5 p-5 font-bold text-maintext transition-all hover:-translate-y-1 hover:border-accent/50 hover:bg-accent/10"
            >
              <span>{label}</span>
              <span class="text-accent transition-transform group-hover:translate-x-1">↗</span>
            </a>
          ))}
        </div>
      </section>

      <!-- IV -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">IV · Paganini, Malmsteen and Classical Music</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          Virtuosity became a language, not an end in itself
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            One of Köksal's early ambitious experiments was a heavy-metal treatment
            of Niccolò Paganini's <em>Caprice No. 24</em>. Working with technically
            demanding classical material strengthened the bridge he was building
            between virtuosity, composition and heavy guitar music.
          </p>

          <p>
            The discovery of Yngwie Malmsteen was another decisive moment. Köksal
            heard in Malmsteen's early music a close relative of the sound he had
            already been searching for: neoclassical phrasing, diminished harmony,
            harmonic-minor color, rapid arpeggios, expressive solo guitar and the
            darker character produced by tuning the guitar down a half step.
          </p>

          <p>
            At the same time, his classical interests deepened. Bach's structural and
            mathematical polyphony fascinated him, while Handel and Chopin remained
            important references. Mozart, however, formed a particularly deep
            emotional connection. Köksal has said that if he had to choose a single
            work from the history of music outside his own catalogue, Mozart's
            <em>Requiem</em> would be his choice.
          </p>

          <p>
            Ian Anderson and Jethro Tull also left a mark on his musical imagination.
            Anderson's use of flute inside rock music demonstrated how an instrument
            could escape its conventional role and become an intensely individual
            voice.
          </p>
        </div>
      </section>

      <!-- V -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image">
          <img
            src="/artist/biography/berk-koksal-outdoor.webp"
            alt="Berk Köksal in an outdoor portrait"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">V · 1996: Loss and the Emotional Language of Music</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            A loss that remained inside the songs
          </h2>

          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>
              In 1996, at the age of sixteen, Berk Köksal lost his mother Aynur in a
              traffic accident. At the time, his parents were separated and he was
              living with his mother and younger brother. After her death, the two
              brothers had to return to their father's home; his father later formed
              a new marriage and the family structure changed again.
            </p>

            <p>
              Köksal now sees his mother's death as one of the major emotional
              fractures of his early life. Before his later period of submission, the
              longing for his mother appeared repeatedly in his work as an unspoken
              subject. Songs that could be heard as romantic separation songs often
              carried a different private meaning.
            </p>

            <p>
              <em>Ne Olur Geri Dön</em> and <em>Git Hadi Durma</em> belong to this
              emotional world. The unfinished work <em>Kurtuluş Ölümde</em> became an
              even more direct expression of grief. Köksal returned to it repeatedly
              for roughly two decades and made numerous recording attempts, but never
              felt able to bring it to a final form that satisfied him.
            </p>

            <p>
              Looking back from adulthood, he interprets that inability to finish the
              work not only as a technical problem, but as evidence of how deeply the
              loss remained unresolved in his inner world.
            </p>
          </div>
        </div>
      </section>

      <!-- VI -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">VI · Bands, Performance and the Electric Guitar</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          From rehearsal rooms to stages
        </h2>

        <div class="grid grid-cols-1 gap-8 text-lg leading-8 text-subtext lg:grid-cols-2">
          <div class="space-y-6">
            <p>
              Köksal's first electric guitar was a Prince model purchased in
              Unkapanı, Istanbul. He used the instrument for many years as his musical
              focus moved increasingly toward rock, metal and solo guitar.
            </p>
            <p>
              From approximately 1998–1999 and again after military service from 2001
              until the years preceding his move to İzmir, he worked in different band
              settings. Gökmen Erkal and Enver Meriç were among the musicians with
              whom he spent significant time developing two- and sometimes
              three-guitar arrangements.
            </p>
          </div>

          <div class="space-y-6">
            <p>
              Köksal generally worked as a lead guitarist and vocalist. School
              concerts, bar performances, rehearsals and large repertoires gave him a
              practical performance education that was very different from solitary
              MIDI work.
            </p>
            <p>
              Even after composition, arrangement and production became more central
              to his work, that lead-guitar background remained an important part of
              his musical identity.
            </p>
          </div>
        </div>
      </section>

      <!-- VII -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image lg:order-2">
          <img
            src="/artist/biography/berk-koksal-home-studio.webp"
            alt="Berk Köksal in his home music studio"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="lg:order-1">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">VII · One-Man Production</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            From playing an instrument to building the entire record
          </h2>

          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>
              As Köksal's MIDI knowledge expanded, he discovered that he could write
              bass, drums, strings and other layers himself. This gradually reduced
              his dependence on a traditional band structure and opened a path toward
              what would become his One-Man Production vision.
            </p>

            <p>
              Early virtual instruments were far less realistic than today's tools,
              and many early productions retained an audible MIDI character. Yet the
              limitations forced him to learn. Instead of specializing in only one
              instrument, he had to think about the entire arrangement.
            </p>

            <p>
              Recording technology then revealed another world. Knowing how to write
              a song did not automatically mean knowing how to record, mix and master
              it. Köksal began with Cool Edit, then worked with Cubase — a major
              favorite through the Cubase 5 era — as well as Propellerhead Reason and
              Pro Tools, eventually moving much of his workflow to Studio One.
            </p>

            <p>
              As his financial resources improved, he invested more seriously in
              studio equipment and continued studying mixing, mastering and modern
              production. What had begun with guitar and tablature became a complete
              independent production system.
            </p>
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section class="pro-glass p-8 md:p-14">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">Production Practice</p>
            <h2 class="text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
              One artistic vision across every stage
            </h2>
          </div>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {productionSkills.map((skill) => (
              <div class="rounded-2xl border border-accent/20 bg-accent/5 p-5 font-bold text-maintext">{skill}</div>
            ))}
          </div>
        </div>
      </section>

      <!-- VIII -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">VIII · İzmir, Family and a Period of Pause</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          Life outside the studio also shaped the music
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            After major changes in his family life, Köksal spent a period living with
            his grandmother and later entered his first marriage. In 2008 he moved
            into the İzmir period of his life. The marriage lasted approximately seven
            years, ending in 2015.
          </p>

          <p>
            Köksal describes these years as an important period of personal maturing,
            but also as a time in which musical production became much less active.
            His daughter <strong class="text-maintext">Bernaz Su Köksal</strong> was
            born from this marriage, and he later composed music in her name.
          </p>

          <p>
            After returning to Istanbul in 2015, he later met and married
            <strong class="text-maintext">Hümeyra Can Köksal</strong>. His creative
            production accelerated again during this period. Their daughter
            <strong class="text-maintext">Arya Belinda Köksal</strong> also became
            part of his musical story through compositions and, later, through her
            own childhood voice in a zikr recording.
          </p>
        </div>
      </section>

      <!-- IX -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image">
          <img
            src="/artist/biography/berk-koksal-studio-portrait.webp"
            alt="Berk Köksal working with music and software technologies"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">IX · Professional Production and Collaboration</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            Mixing, mastering, film music and work for other artists
          </h2>

          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>
              As his studio knowledge grew, Köksal began applying it to the work of
              other artists. He mixed and mastered projects across different styles,
              including pop, rap and saz-based music. He collaborated with the saz
              musician known as Derdali and worked on multiple independent music
              projects for other performers.
            </p>

            <p>
              He also worked with lyricist <strong class="text-maintext">Armağan Ünlü</strong>,
              composing some of Ünlü's lyrics and taking responsibility in different
              projects for arrangement, vocals, mixing and mastering.
            </p>

            <p>
              Film-oriented works including <em>Ölümün Gölgesinde</em>,
              <em>Başlangıç</em>, <em>İhanet</em> and <em>Korku</em> expanded his
              experience beyond conventional song form and into dramatic, cinematic
              writing.
            </p>

            <p>
              Earlier works such as <em>Bebeğim</em>, <em>Tutkunum</em> and
              <em>Kalbimi Verdim Sana</em> were also brought into professional release
              processes, helping establish a more visible public artist identity.
            </p>
          </div>
        </div>
      </section>

      <!-- X -->
      <section class="relative overflow-hidden rounded-[2rem] border border-accent/20">
        <div class="relative min-h-[560px]">
          <img
            src="/artist/biography/hero-neo-sacred-zikr-alt.webp"
            alt="Sacred and symphonic artistic concept"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-background/25"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-background/20"></div>

          <div class="relative z-10 flex min-h-[560px] items-center p-8 md:p-14">
            <div class="max-w-3xl">
              <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">X · Requiem Concerto</p>
              <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
                The great threshold before submission
              </h2>

              <div class="space-y-6 text-lg leading-8 text-maintext/80">
                <p>
                  Köksal's long relationship with Mozart's <em>Requiem</em> eventually
                  contributed to his own <strong class="text-maintext">Requiem Concerto</strong>,
                  released in 2022.
                </p>

                <p>
                  He sees the work as one of the major artistic statements of his
                  pre-submission period: a piece in which neoclassical guitar,
                  dramatic form and spiritual longing were directed upward toward
                  GOD. The guitar solos were conceived not merely as technical
                  displays but as emotional lines reaching toward the sky.
                </p>

                <p>
                  In retrospect, Requiem Concerto stands at the edge of two periods:
                  the culmination of one musical identity and the approach of a much
                  deeper religious transformation.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- XI -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image lg:order-2">
          <img
            src="/artist/biography/kuranteyit-interface.webp"
            alt="QUR'AN research software interface"
            class="aspect-[4/5] w-full object-cover object-left"
            loading="lazy"
          />
        </div>

        <div class="lg:order-1">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">XI · QUR'AN Research</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            The question became: What does GOD actually ask of us?
          </h2>

          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>
              Alongside music, Köksal increasingly focused on the QUR'AN. He wanted
              to know what GOD actually asks of human beings, what the right path is
              and what a person should do with regard to the Hereafter.
            </p>

            <p>
              Being told that he was Hanafi led him to ask a simple but important
              question: <strong class="text-maintext">Why am I Hanafi?</strong> He
              studied different schools of thought and, for a period, followed a
              Hanbali-oriented practice. Continued investigation of hadith,
              sectarian traditions and inherited religious assumptions eventually
              led him to question the framework itself.
            </p>

            <p>
              Around 2019, Köksal encountered the QUR'AN's 19-based mathematical
              system as presented in the work of Rashad Khalifa. He studied the
              system extensively and came to regard it as compelling evidence of the
              divine authorship of the QUR'AN.
            </p>

            <p>
              Accepting Rashad Khalifa's messenger claim was much more difficult. For
              roughly five years Köksal continued to investigate while remaining
              unconvinced. During this period he also spent considerable time
              discussing religion with atheists, deists and agnostics, and even
              helped administer online discussion communities where conflicting
              worldviews could be examined directly.
            </p>

            <p>
              He describes the central prayer of this period simply: asking GOD to
              show him the right path when he felt unable to reach certainty by his
              own effort.
            </p>
          </div>
        </div>
      </section>

      <!-- XII -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">XII · Submission</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          “The Book opened to us.”
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            After approximately five years of research, Köksal says he became fully
            convinced, through his reading of the QUR'AN, of Rashad Khalifa's
            messenger claim. He identifies this as the beginning of his period of
            submission, around 2024.
          </p>

          <p>
            Köksal describes the change with the phrase
            <strong class="text-maintext">“The Book opened to us.”</strong> The
            transformation was not simply the addition of new information. He felt he
            had to re-examine decades of inherited religious ideas and rebuild his
            understanding from the QUR'AN itself.
          </p>

          <p>
            His wife Hümeyra Can Köksal later embraced the same path, turning the
            process into a shared family journey of reading and learning. Köksal
            regards that shared direction as one of GOD's gifts to their family.
          </p>

          <p>
            A new question then emerged: after decades spent learning music,
            production and technology, how could those abilities be used in service
            to GOD?
          </p>
        </div>
      </section>

      <!-- XIII -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">XIII · The First Zikr Works</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          The purpose of music changed
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            Köksal concluded that contemporary monotheist zikr music represented an
            area in which he could contribute directly. He wanted to build music in
            which the remembrance and glorification of GOD remained the center, while
            using the full musical vocabulary of the present age.
          </p>

          <p>
            The foundational work of this period was
            <strong class="text-maintext">Zikir (La ilahe illa Allah)</strong>,
            released on YouTube on 31 August 2024. Köksal remembers the production as
            unusually difficult: tempo problems, recording failures, VST and plug-in
            problems, interruptions and even power cuts repeatedly obstructed the
            process.
          </p>

          <p>
            When he came close to abandoning the project, he says he prayed to GOD,
            explaining that his intention was to glorify Him and asking for help to
            complete the work. He later interpreted the successful completion of the
            piece as the moment permission was given, in his own spiritual
            understanding, for the wider musical journey that followed.
          </p>

          <p>
            The musical memory of a zikr he had heard in a mosque in Üsküdar also
            contributed to the idea, but Köksal deliberately re-centered the form on
            the remembrance of GOD alone according to his monotheistic understanding.
          </p>
        </div>
      </section>

      <!-- XIV -->
      <section class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <article class="pro-card p-7 md:p-9">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.35em] text-accent">A Family Voice in the Recording</p>
          <h2 class="mb-5 text-3xl font-heading font-bold text-maintext">Allah Allah La ilahe illa Allah</h2>
          <div class="space-y-5 leading-8 text-subtext">
            <p>
              Köksal created a later zikr work with Derdali / Ali. During an informal
              moment at home, his daughter Arya Belinda — then around four years old —
              climbed into his lap and joined the repeated zikr.
            </p>
            <p>
              Her child's voice was preserved at the end of the finished recording,
              turning a studio work into a permanent family memory as well.
            </p>
          </div>
        </article>

        <article class="pro-card p-7 md:p-9">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.35em] text-accent">Repentance as Participation</p>
          <h2 class="mb-5 text-3xl font-heading font-bold text-maintext">Tövbe Ettim, Estağfurullah Ya Gaffar</h2>
          <div class="space-y-5 leading-8 text-subtext">
            <p>
              Köksal says the central idea arrived late at night. He woke, opened the
              voice recorder on his phone and captured the piece in a spontaneous
              flow.
            </p>
            <p>
              When recording the vocal, he adopted a prayer-like seated posture and
              opened his hands toward GOD. He imagined the piece as more than a song:
              a listener could play it, join the words and personally participate in
              repentance.
            </p>
          </div>
        </article>
      </section>

      <!-- XV -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">XV · Allahu Lena, Tanrıya Övgüler and the Early Singles</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          A sacred vocabulary begins to expand
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            Köksal later encountered older zikr recordings associated with Rashad
            Khalifa's community, including recordings made before Khalifa's death in
            1990. One of the forms that inspired him was <em>Allahu Lena</em>, which
            he developed into <strong class="text-maintext">Allahu Lena – Tanrı Bizimle</strong>,
            connecting the phrase with the Turkish meaning “GOD is with us.”
          </p>

          <p>
            <strong class="text-maintext">Tanrıya Övgüler</strong> explored a more
            collective and polyphonic form, beginning gently and growing into a more
            energetic rock-oriented praise structure. Later theological differences
            ended the collaboration with some participants, leaving the recording as
            a document of a specific moment in the journey.
          </p>

          <p>
            Other singles — including <em>Subhanallah</em>,
            <em>Ya Baki Entel Baki</em>, <em>Allahu Ekber</em> and related works —
            continued to broaden the sound. In another early piece centered on
            <em>Allah / La ilahe illa Allah</em>, Köksal explored poetry and discovered
            a higher, lighter vocal register than he had expected from his own voice.
          </p>
        </div>
      </section>

      <!-- XVI -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">XVI · Tanrı'nın Hediyesi</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          The first album-format release
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            <strong class="text-maintext">Tanrı'nın Hediyesi</strong> became Köksal's
            first album-format release in this new period. Rather than a conventional
            long album, it presented the central work
            <em>Tövbe Ettim, Estağfurullah Ya Gaffar</em> in three complementary
            treatments: a vocal version, a vocal-free version and a piano/choir-based
            form.
          </p>

          <p>
            The release established the idea that a sacred musical concept could be
            examined through multiple arrangements. The first truly large-scale
            album architecture would follow with <em>Zikr Symphony</em>.
          </p>
        </div>
      </section>

      <!-- XVII -->
      <section class="relative overflow-hidden rounded-[2rem] border border-accent/20">
        <div class="relative min-h-[620px]">
          <img
            src="/artist/neo-sacred-zikr-banner-2.webp"
