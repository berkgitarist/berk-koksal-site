<!-- PHOTO JOURNEY SCRIPT START -->
<script>
  const openPhotoJourneyButton =
    document.getElementById('open-photo-journey');

  const closePhotoJourneyButton =
    document.getElementById('close-photo-journey');

  const photoJourneyLightbox =
    document.getElementById('photo-journey-lightbox');

  const photoJourneyImage =
    document.querySelector<HTMLImageElement>(
      '.photo-journey-full-image'
    );

  function openPhotoJourney(): void {
    if (!photoJourneyLightbox) {
      return;
    }

    photoJourneyLightbox.classList.add('is-open');

    photoJourneyLightbox.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.classList.add(
      'photo-journey-open'
    );

    closePhotoJourneyButton?.focus();
  }

  function closePhotoJourney(): void {
    if (!photoJourneyLightbox) {
      return;
    }

    photoJourneyLightbox.classList.remove(
      'is-open'
    );

    photoJourneyLightbox.setAttribute(
      'aria-hidden',
      'true'
    );

    document.body.classList.remove(
      'photo-journey-open'
    );

    if (photoJourneyImage) {
      photoJourneyImage.classList.remove(
        'is-zoomed'
      );

      photoJourneyImage.style.transformOrigin =
        'center center';
    }

    openPhotoJourneyButton?.focus();
  }

  function togglePhotoJourneyZoom(
    event: MouseEvent
  ): void {
    event.stopPropagation();

    if (!photoJourneyImage) {
      return;
    }

    const imageRectangle =
      photoJourneyImage.getBoundingClientRect();

    const clickX =
      event.clientX - imageRectangle.left;

    const clickY =
      event.clientY - imageRectangle.top;

    const originX =
      (clickX / imageRectangle.width) * 100;

    const originY =
      (clickY / imageRectangle.height) * 100;

    if (
      photoJourneyImage.classList.contains(
        'is-zoomed'
      )
    ) {
      photoJourneyImage.classList.remove(
        'is-zoomed'
      );

      photoJourneyImage.style.transformOrigin =
        'center center';

      return;
    }

    photoJourneyImage.style.transformOrigin =
      `${originX}% ${originY}%`;

    photoJourneyImage.classList.add(
      'is-zoomed'
    );
  }

  openPhotoJourneyButton?.addEventListener(
    'click',
    openPhotoJourney
  );

  closePhotoJourneyButton?.addEventListener(
    'click',
    closePhotoJourney
  );

  photoJourneyImage?.addEventListener(
    'click',
    togglePhotoJourneyZoom
  );

  photoJourneyLightbox?.addEventListener(
    'click',
    (event: MouseEvent) => {
      if (event.target === photoJourneyLightbox) {
        closePhotoJourney();
      }
    }
  );

  document.addEventListener(
    'keydown',
    (event: KeyboardEvent) => {
      if (
        event.key === 'Escape' &&
        photoJourneyLightbox?.classList.contains(
          'is-open'
        )
      ) {
        closePhotoJourney();
      }
    }
  );
</script>
<!-- PHOTO JOURNEY SCRIPT END -->