<style is:global>

  :root {

    --bg: #0b0d10;

    --bg-soft: #101318;

    --panel: #13171d;

    --panel-2: #171c23;

    --text: #f2f2ef;

    --muted: #9ca3ad;

    --line: rgba(255, 255, 255, 0.11);

    --gold: #d7b46a;

    --gold-soft: #f0dca5;

    --green: #88d39a;

    --shell: min(1180px, calc(100% - 40px));

    --radius: 22px;

  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {

    margin: 0;

    background: var(--bg);

    color: var(--text);

    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

    line-height: 1.6;

    -webkit-font-smoothing: antialiased;

  }

  a { color: inherit; text-decoration: none; }

  h1, h2, h3, p { margin-top: 0; }

  .shell { width: var(--shell); margin-inline: auto; }

  .skip-link {

    position: fixed;

    left: 16px;

    top: -80px;

    z-index: 999;

    background: var(--gold);

    color: #111;

    padding: 10px 14px;

    border-radius: 10px;

    font-weight: 800;

  }

  .skip-link:focus { top: 16px; }

  .site-header {

    position: sticky;

    top: 0;

    z-index: 50;

    background: rgba(11, 13, 16, 0.84);

    border-bottom: 1px solid var(--line);

    backdrop-filter: blur(18px);

  }

  .header-inner {

    min-height: 78px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 32px;

  }

  .brand { display: inline-flex; align-items: center; gap: 12px; }

  .brand-mark {

    width: 42px;

    height: 42px;

    display: grid;

    place-items: center;

    border: 1px solid rgba(215, 180, 106, 0.55);

    color: var(--gold-soft);

    font-size: 13px;

    font-weight: 900;

    letter-spacing: 0.08em;

    border-radius: 50%;

  }

  .brand-copy { display: grid; line-height: 1.15; }

  .brand-copy strong { font-size: 14px; letter-spacing: 0.04em; }

  .brand-copy small { margin-top: 5px; color: var(--muted); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }

  .top-nav { display: flex; gap: 28px; }

  .top-nav a { color: #c5c9cf; font-size: 13px; font-weight: 700; transition: color .2s ease; }

  .top-nav a:hover, .top-nav a:focus-visible { color: var(--gold-soft); }

    .header-actions {

    display: flex;

    align-items: center;

    gap: 24px;

  }

  .language-switch {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 7px 10px;

    border: 1px solid var(--line);

    border-radius: 999px;

    background: rgba(255,255,255,.025);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .08em;

  }

  .language-switch a {

    color: #747c87;

    transition: color .2s ease;

  }

  .language-switch a:hover,

  .language-switch a:focus-visible {

    color: var(--gold-soft);

  }

  .language-switch a.active {

    color: var(--gold-soft);

  }

  .language-switch span {

    color: #4f5660;

  }

  .hero {

    position: relative;

    overflow: hidden;

    min-height: 760px;

    display: flex;

    align-items: center;

    border-bottom: 1px solid var(--line);

  }

  .hero-grid {

    position: absolute;

    inset: 0;

    opacity: .15;

    background-image:

      linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),

      linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);

    background-size: 54px 54px;

    mask-image: linear-gradient(to bottom, black, transparent 90%);

  }

  .hero-glow { position: absolute; border-radius: 50%; filter: blur(10px); pointer-events: none; }

  .hero-glow-one {

    width: 520px; height: 520px; right: -220px; top: 80px;

    background: radial-gradient(circle, rgba(215,180,106,.16), transparent 68%);

  }

  .hero-glow-two {

    width: 420px; height: 420px; left: -220px; bottom: -170px;

    background: radial-gradient(circle, rgba(62,86,119,.17), transparent 70%);

  }

  .hero-inner {

    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns: minmax(0, 1.42fr) minmax(310px, .58fr);

    gap: 72px;

    align-items: center;

    padding: 92px 0;

  }

  .eyebrow, .section-kicker {

    color: var(--gold-soft);

    text-transform: uppercase;

    letter-spacing: .16em;

    font-weight: 800;

    font-size: 11px;

  }

  .eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 26px; }

  .eyebrow span { width: 28px; height: 1px; background: var(--gold); }

  .hero h1 {

    margin-bottom: 28px;

    max-width: 800px;

    font-size: clamp(48px, 6.6vw, 87px);

    line-height: .95;

    letter-spacing: -.06em;

    font-weight: 760;

  }

  .hero h1 em { color: var(--gold-soft); font-style: normal; font-weight: 520; }

  .hero-lead { max-width: 720px; color: #b8bec7; font-size: clamp(17px, 2vw, 21px); line-height: 1.7; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    min-height: 50px;

    padding: 0 19px;

    border-radius: 999px;

    font-size: 13px;

    font-weight: 800;

    border: 1px solid transparent;

    cursor: pointer;

    font-family: inherit;

    transition: transform .2s ease, border-color .2s ease, background .2s ease;

  }

  .button:hover { transform: translateY(-2px); }

  .button-primary { background: var(--gold-soft); color: #14110a; }

  .button-primary:hover { background: #fff0c4; }

  .button-secondary { background: rgba(255,255,255,.035); border-color: var(--line); color: #e6e8eb; }

  .button-secondary:hover { border-color: rgba(215,180,106,.45); }

  .hero-meta {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 1px;

    margin-top: 56px;

    border: 1px solid var(--line);

    background: var(--line);

    border-radius: 18px;

    overflow: hidden;

  }

  .hero-meta > div { background: rgba(10,12,15,.84); padding: 18px; }

  .hero-meta strong { display: block; color: #f7f3e9; font-size: 14px; }

  .hero-meta span { display: block; margin-top: 5px; color: var(--muted); font-size: 11px; line-height: 1.45; }

  .profile-card {

    position: relative;

    padding: 28px;

    background: linear-gradient(145deg, rgba(25,30,37,.96), rgba(16,19,24,.96));

    border: 1px solid rgba(255,255,255,.12);

    border-radius: 28px;

    box-shadow: 0 34px 80px rgba(0,0,0,.28);

  }

  .profile-card::before {

    content: '';

    position: absolute;

    inset: 0;

    border-radius: inherit;

    padding: 1px;

    background: linear-gradient(145deg, rgba(215,180,106,.32), transparent 35%, transparent 70%, rgba(255,255,255,.08));

    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);

    -webkit-mask-composite: xor;

    mask-composite: exclude;

    pointer-events: none;

  }

  .profile-topline { display: flex; justify-content: space-between; gap: 12px; color: #8f96a0; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }

  .status-dot {

    color: var(--green);

    white-space: nowrap;

  }

  .status-dot::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 6px; background: var(--green); border-radius: 50%; box-shadow: 0 0 12px rgba(136,211,154,.5); }

.profile-photo {

  display: block;

  width: 118px;

  height: 118px;

  margin: 34px 0 26px;

  object-fit: cover;

  object-position: center top;

  border-radius: 50%;

  border: 1px solid rgba(215,180,106,.55);

  box-shadow:

    0 16px 38px rgba(0,0,0,.34),

    0 0 0 5px rgba(215,180,106,.05);

}

  .profile-card h2 { margin-bottom: 4px; font-size: 28px; letter-spacing: -.03em; }

  .profile-title { color: var(--gold-soft); font-weight: 700; }

  .profile-list { list-style: none; padding: 0; margin: 30px 0 0; border-top: 1px solid var(--line); }

  .profile-list li { padding: 14px 0; border-bottom: 1px solid var(--line); display: grid; gap: 4px; }

  .profile-list span { color: #747c87; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }

  .profile-list strong { color: #d9dde2; font-size: 12px; font-weight: 650; }

  .profile-link { display: flex; justify-content: space-between; margin-top: 22px; color: var(--gold-soft); font-size: 13px; font-weight: 800; }

  .section-pad { padding: 112px 0; }

  .section-muted { background: var(--bg-soft); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  .section-kicker { margin-bottom: 15px; }

  .section-title { margin-bottom: 0; font-size: clamp(34px, 4.5vw, 58px); line-height: 1.08; letter-spacing: -.045em; font-weight: 700; }

  .intro-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 100px; align-items: start; }

  .intro-copy { color: #b7bdc5; font-size: 18px; }

  .intro-copy p { margin-bottom: 22px; }

  .focus-strip { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line); }

  .focus-strip span { display: block; color: #727b86; font-size: 10px; text-transform: uppercase; letter-spacing: .14em; }

  .focus-strip strong { display: block; margin-top: 9px; color: #e7e9ec; font-size: 13px; }

  .section-heading-row { display: grid; grid-template-columns: 1.3fr .7fr; gap: 80px; align-items: end; margin-bottom: 56px; }

  .section-heading-row > p { color: var(--muted); margin-bottom: 7px; }

  .capability-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }

  .capability-card { min-height: 260px; padding: 30px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(255,255,255,.012); transition: background .2s ease; }

  .capability-card:hover { background: rgba(215,180,106,.035); }

  .capability-number { color: #6f7781; font-size: 10px; letter-spacing: .12em; }

  .capability-card h3 { margin: 56px 0 14px; font-size: 20px; letter-spacing: -.02em; }

  .capability-card p { color: #9199a4; font-size: 14px; margin-bottom: 0; }

  .experience-layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: 86px; }

  .experience-intro > p:not(.section-kicker) { margin-top: 26px; color: var(--muted); }

  .education-card { margin-top: 44px; padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.018); }

  .education-card span { color: #727b86; font-size: 10px; text-transform: uppercase; letter-spacing: .14em; }

  .education-card strong { display: block; margin-top: 10px; font-size: 18px; }

  .education-card p { margin: 3px 0 0; color: var(--muted); font-size: 13px; }

  .timeline { position: relative; }

  .timeline::before { content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 1px; background: var(--line); }

  .timeline-item { position: relative; display: grid; grid-template-columns: 140px 1fr; gap: 26px; padding: 0 0 46px 34px; }

  .timeline-item:last-child { padding-bottom: 0; }

  .timeline-marker { position: absolute; left: 0; top: 7px; width: 13px; height: 13px; border-radius: 50%; background: var(--bg); border: 2px solid var(--gold); box-shadow: 0 0 0 6px rgba(215,180,106,.06); }

  .timeline-period { padding-top: 1px; color: #747c87; font-size: 11px; font-weight: 750; letter-spacing: .06em; }

  .timeline-company { margin-bottom: 5px; color: var(--gold-soft); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .11em; }

  .timeline-content h3 { margin-bottom: 12px; font-size: 22px; letter-spacing: -.025em; }

  .timeline-content > p:last-child { margin-bottom: 0; color: #959da8; font-size: 14px; }

  .section-tech { background: #0d1014; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  .tech-heading { max-width: 830px; }

  .tech-heading > p:last-child { margin: 24px 0 0; color: var(--muted); font-size: 17px; }

  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 58px; }

  .project-card { min-height: 330px; display: flex; flex-direction: column; padding: 34px; border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.012)); }

  .project-label { color: var(--gold-soft); font-size: 10px; text-transform: uppercase; letter-spacing: .14em; font-weight: 800; }

  .project-card h3 { margin: 55px 0 12px; font-size: 32px; letter-spacing: -.04em; }

  .project-card p { color: #9ba3ae; font-size: 14px; }

  .project-links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: auto; padding-top: 28px; border-top: 1px solid var(--line); }

  .project-links a { color: #e6e9ec; font-size: 12px; font-weight: 800; }

  .project-links a:hover { color: var(--gold-soft); }

  .tech-stack { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; }

  .tech-stack span { padding: 9px 12px; border: 1px solid var(--line); border-radius: 999px; color: #aab1ba; font-size: 11px; }

  .value-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; }

  .value-list { border-top: 1px solid var(--line); }

  .value-list > div { display: grid; grid-template-columns: 42px 1fr; gap: 14px; padding: 22px 0; border-bottom: 1px solid var(--line); }

  .value-list span { color: #6f7781; font-size: 10px; }

  .value-list p { color: #a2a9b3; margin: 0; }

  .value-list strong { color: #e9eaec; }

  .contact-section { padding: 100px 0; background: linear-gradient(135deg, #171711, #0d1014 54%, #10161d); border-top: 1px solid rgba(215,180,106,.16); }

  .contact-inner { display: grid; grid-template-columns: 1fr auto; gap: 70px; align-items: end; }

  .contact-inner h2 { max-width: 850px; margin-bottom: 18px; font-size: clamp(36px, 5vw, 64px); line-height: 1.05; letter-spacing: -.05em; }

  .contact-inner p:not(.section-kicker) { max-width: 780px; color: #a2a9b3; margin-bottom: 0; }

  .contact-actions { display: grid; gap: 10px; min-width: 220px; }

  .site-footer { padding: 28px 0; border-top: 1px solid var(--line); background: #090b0d; }

  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }

  .footer-inner > div:first-child { display: grid; }

  .footer-inner strong { font-size: 13px; }

  .footer-inner span { color: #707883; font-size: 10px; margin-top: 3px; }

  .footer-links { display: flex; gap: 18px; }

  .footer-links a { color: #8d95a0; font-size: 11px; }

  .footer-links a:hover { color: var(--gold-soft); }

  a:focus-visible, button:focus-visible { outline: 2px solid var(--gold-soft); outline-offset: 4px; }

  @media (max-width: 980px) {

    .top-nav { display: none; }

    .hero-inner { grid-template-columns: 1fr; gap: 50px; }

    .hero { min-height: auto; }

    .profile-card { max-width: 560px; }

    .intro-grid, .experience-layout, .value-grid { grid-template-columns: 1fr; gap: 46px; }

