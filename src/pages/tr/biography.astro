              />
            </svg>
          </a>
        </div>

        <!-- FINAL -->
        <section class="py-0 text-center md:py-20">
          <p class="mb-8 text-xs font-bold uppercase tracking-[0.45em] text-accent">Son Söz</p>
          <h2 class="mx-auto max-w-5xl text-4xl font-heading font-bold leading-tight text-maintext md:text-6xl">
            Müzik benim varış noktam değil.<br />
            TANRI'yı yüceltme biçimimdir.
          </h2>
        </section>

        <a
          href="https://qurantft.com"
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-[2rem] border border-accent/30 bg-accent/5 p-6 text-center transition-all hover:bg-accent/10 md:p-14"
        >
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">KURAN: SON AHİT</p>
          <p class="mb-6 text-sm text-subtext">Yetkili İngilizce Sürüm · Rashad Khalifa tarafından çevrilmiştir</p>
          <h2 class="text-3xl font-heading font-bold leading-tight text-maintext md:text-5xl">
            [87:1] Yüce Rabbinin adını yücelt.
          </h2>
          <p class="mt-6 text-sm text-accent">Quran: The Final Testament ↗</p>
        </a>

      </div>
    </section>
  </main>
