---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/nav.astro";

const albums = [
  {
    year: "2024",
    title: "Tanrı'nın Hediyesi",
    description: "Albüm formatında yayımlanan ilk Neo-Sacred Zikr çalışması: Tövbe Ettim, Estağfurullah Ya Gaffar'ın vokalli, enstrümantal ve piyano-koro merkezli üç farklı yorumu."
  },
  {
    year: "2025",
    title: "Zikr Symphony",
    description: "Yolculuğun ilk büyük ölçekli konsept albümü: 19 ana eser ve on dokuzuncu eserin içinde proje için üretilen diğer müzikal fikirlerden oluşan ek bir 19 bölümlük medley."
  },
  {
    year: "2026",
    title: "Zikr Huu",
    description: "Kadın vokaller, tekrar, dinginlik ve bilinçli olarak seyrek tutulan enstrümantasyon etrafında şekillenen dokuz parçalık minimalist bir meditasyon."
  },
  {
    year: "2026",
    title: "Zikr Nur",
    description: "Kadın vokaller, yağmur atmosferi, uzaktaki gök gürültüsü, piyano, ney ve yumuşak ritimlerle şekillenen 19 parçalık ambient zikir albümü."
  },
  {
    year: "2026",
    title: "ZIKR ROCK",
    description: "Enerji ve distorsiyonun albüm boyunca giderek yükseldiği, Köksal'ın rock ve neoklasik gitar köklerine 19 parçalık dönüşü."
  },
  {
    year: "2026",
    title: "Neo-Sacred Zikr: Classical Chorus",
    description: "Köksal'ın Mozart, Requiem yazımı ve büyük kutsal koro düzenlemeleriyle yıllara yayılan ilişkisinden beslenen 19 parçalık klasik ve koral çalışma."
  },
  {
    year: "2026",
    title: "Neo-Sacred Zikr: One God One Love",
    description: "TEK TANRI'ya inanan çocukların da O'nu anabilecekleri ve yüceltebilecekleri çağdaş müziklere sahip olması fikrinden doğan 19 parçalık çocuk korosu projesi."
  },
  {
    year: "2026",
    title: "ZIKR RAP",
    description: "Bismillahirrahmanirrahim ile başlayan ve rap müziğinin ritmik enerjisini zikir, hatırlama ve TANRI'ya övgü için kullanan 19 parçalık proje."
  },
  {
    year: "2026",
    title: "Zikr-i Batın",
    description: "İçsel hatırlama, ilahî isimler ve KURAN'ın Huruf-u Mukattaa harflerinden kurulan final kompozisyonu etrafında şekillenen son derece kişisel 19 parçalık çalışma."
  },
  {
    year: "2026",
    title: "ZIKR JAZZ",
    description: "Genişletilmiş ve modal armoniyi daha sıcak ve sakin bir ses dünyasıyla kullanan 19 parçalık kutsal caz projesi."
  },
  {
    year: "2026",
    title: "ZIKR SYMPHONIC METAL",
    description: "Neredeyse bütünüyle HÛ etrafında kurulan; seçili bölümlerde Hay / Al-Hayy kullanılan; kadın sesi, kutsal koro, orkestra, borulu org ve progresif neoklasik metali birleştiren 19 bölümlük konsept albüm."
  }
];

const productionSkills = [
  "Beste",
  "Şarkı Yazımı",
  "Gitar Performansı",
  "Vokal",
  "Aranjman",
  "Kayıt",
  "MIDI Programlama",
  "Orkestrasyon",
  "Ses Tasarımı",
  "Miks",
  "Mastering",
  "Görsel Konseptler",
  "Yazılım Geliştirme"
];

const archiveLinks = [
  ["SoundCloud Arşivi", "https://soundcloud.com/berkkoksal"],
  ["MüzikOnair Profili / İçerikler", "https://muzikonair.com/baslik/berk-koksal/"],
  ["Cem Köksal — Life Tab", "http://www.akormerkezi.net/cem-koksal-life-tab_sarki-dvhnl.html"],
  ["Ahmet Kanneci — Aygız Tab", "https://tabs.ultimate-guitar.com/tab/ahmet-kanneci/aygiz-ay-giz-tabs-1498641"],
  ["Cem Köksal — Kalbim Bomboş Tab", "https://www.songsterr.com/a/wsa/cem-koksal-kalbim-bombos-tab-s28045t0"],
  ["Cem Köksal — Earthquake Part Tab", "https://e-akor.com/sarki/cem-koksal-earthquake-part-tab"]
];
---

<Layout
  title="Tam Biyografi | Berk KÖKSAL"
  description="Berk KÖKSAL'ın çocukluk yıllarındaki gitardan berkgitarist dönemine, prodüksiyondan KURAN araştırmalarına, TANRI'ya teslimiyetten Neo-Sacred Zikr ve QURANIC CONCEPTS'e uzanan kapsamlı yaşam öyküsü."
  canonical="/tr/full-biography/"
  ogImage="/artist/biography/hero-neo-sacred-zikr.webp"
  lang="tr"
>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="px-4 pb-12 pt-28 md:px-8 md:pb-16 md:pt-32">
      <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] border border-accent/25 shadow-2xl shadow-black/30">
        <div class="relative aspect-[4/5] sm:aspect-[16/10] md:aspect-[16/8] lg:aspect-[16/7]">
          <img
            src="/artist/biography/hero-neo-sacred-zikr.webp"
            alt="Berk Köksal ve Neo-Sacred Zikr sanatsal evreni"
            class="absolute inset-0 h-full w-full object-cover object-center"
            fetchpriority="high"
          />

          <div class="absolute inset-0 bg-gradient-to-r from-background/95 via-background/60 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-background/20"></div>

          <div class="relative z-10 flex h-full items-end p-6 sm:p-9 md:p-12 lg:p-16">
            <div class="max-w-3xl">
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.4em] text-accent md:text-sm">
                Tüm Hikâye
              </p>

              <h1 class="text-4xl font-heading font-bold leading-none text-maintext sm:text-5xl md:text-6xl lg:text-7xl">
                Berk KÖKSAL
              </h1>

              <p class="mt-5 text-base leading-7 text-maintext/90 sm:text-lg md:text-xl">
                Besteci • Gitarist • Müzik Prodüktörü • Yazılım Mühendisi
              </p>

              <p class="mt-1 text-lg font-bold text-accent md:text-2xl">
                Neo-Sacred Zikr'in Kurucusu<br />
                QURANIC CONCEPTS'in Yaratıcısı
              </p>

              <a
                href="#biography"
                class="group mt-7 inline-flex items-center gap-3 rounded-full border border-maintext/25 bg-background/40 px-5 py-3 text-xs font-bold uppercase tracking-[0.2em] text-maintext backdrop-blur-md transition-all duration-300 hover:border-accent hover:bg-accent hover:text-background sm:text-sm"
              >
                <span>Yolculuğu Keşfet</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div id="biography" class="mx-auto max-w-6xl space-y-10 px-5 pt-2 pb-8 md:space-y-20 md:px-8 md:pt-4 md:pb-24">

      <!-- I -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image">
          <img src="/artist/biography/berk-koksal-portrait.webp" alt="Berk Köksal portresi" class="aspect-[4/5] w-full object-cover" loading="lazy" />
        </div>
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">I · Kökenler</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Ses, sorgulama ve dönüşümle şekillenen bir yaşam</h2>
          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>Berk Köksal, 19 Aralık 1980'de İstanbul'da doğdu. Çocukluk yıllarının önemli bir bölümünü yaklaşık on dört yaşına kadar Rami'de geçirdi. Annesi Aynur, babası Hasan'dı; kendisinden küçük bir erkek kardeşiyle büyüdü.</p>
            <p>Müzik hayatına neredeyse ilk anıları kadar erken girdi. Çocukken evde babasının gitarı vardı. Teoriyi, tekniği ve müziğin kavramlarını bilmeden önce enstrümana dokunuyor, sesleri deniyor ve gitarı keşfedilecek bir dünya gibi görüyordu.</p>
            <p>Bir dönem gitarı yalnızca tek tel üzerinden keşfetmeye çalıştı. Küçük bir çocukluk ayrıntısı gibi görünen bu deneyim, daha sonra öğrenme biçiminin simgesine dönüştü: elde olanla başla, dikkatle dinle, yapıyı incele ve oradan dışarı doğru büyüt.</p>
          </div>
        </div>
      </section>

      <!-- II -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">II · Çocukluk ve Klasik Gitar</p>
        <h2 class="mb-9 max-w-4xl text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">İlk sistemli adımlar</h2>
        <div class="grid grid-cols-1 gap-8 text-lg leading-8 text-subtext lg:grid-cols-2">
          <div class="space-y-6">
            <p>Yaklaşık on iki-on üç yaşlarında Gaziosmanpaşa'da özel klasik gitar derslerine başladı. Küçük bir özel eğitim ortamında aldığı bu dersler, enstrümanla kurduğu ilişkinin ilk sistematik teknik temelini oluşturdu.</p>
            <p>Rami'den ayrıldıktan sonra bir süre Gaziosmanpaşa Yeni Doğan Çeşme bölgesinde yaşadı. Haydarpaşa Endüstri Meslek Lisesi'ne başladığında okula daha rahat devam edebilmek için Kayışdağı'nda anneannesiyle de bir dönem yaşadı.</p>
          </div>
          <div class="space-y-6">
            <p>Klasik gitar kısa sürede yalnızca enstrüman tekniğinin ötesinde bir kapı açtı. Çok seslilik, armoni ve klasik müziğin yapısı giderek daha fazla ilgisini çekti. Bir eserin yalnızca nasıl çalındığını değil, notaların neden birlikte çalıştığını ve bütün bir müzik sisteminin nasıl kurulduğunu merak ediyordu.</p>
            <p>Bu merak ilerleyen yıllarda bilgisayarlar, MIDI ve bağımsız müzisyenlerin erişebildiği ilk kuşak müzik yazılımlarıyla doğal biçimde birleşti.</p>
          </div>
        </div>
      </section>

      <!-- III -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image lg:order-2">
          <img src="/artist/biography/berk-koksal-metal-era.webp" alt="Berk Köksal'ın gitar ve rock müzik yılları" class="aspect-[4/5] w-full object-cover" loading="lazy" />
        </div>
        <div class="lg:order-1">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">III · MIDI, Guitar Pro ve berkgitarist</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Müziği yeniden kurarak öğrenmek</h2>
          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>Köksal'ın gelişim yılları MIDI'nin ve kişisel bilgisayar tabanlı müzik araçlarının hızla geliştiği döneme denk geldi. Özellikle Guitar Pro 3, onun için yalnızca tablatür okuyan bir program değil, şarkıları içten dışa yeniden kurabildiği bir laboratuvara dönüştü.</p>
            <p>Müzikleri kulaktan çıkarıyor; gitar, bas, davul, yaylılar ve diğer partileri MIDI ve tablatür olarak yazıyordu. İnternetin erken döneminde <strong class="text-maintext">berkgitarist</strong> adını kullanarak tab, akor, MIDI dosyaları ve Guitar Pro düzenlemeleri paylaştı.</p>
            <p>Yngwie Malmsteen, Jason Becker, Steve Vai, Cem Köksal ve başka gitar merkezli müziklerle bağlantılı transkripsiyonlar yaptı. Hazır notaları okumak yerine sesleri kulaktan bulması, yaşamındaki en önemli müzik eğitimlerinden birine dönüştü.</p>
            <p>Bir düzenlemeyi bütünüyle yeniden kurabilmek için yalnız gitarı değil; ritim, bas, armoni, davul, yaylılar ve kontrpuan arasındaki ilişkiyi de anlaması gerekiyordu. Böylece transkripsiyon giderek kompozisyon eğitimine dönüştü.</p>
          </div>
        </div>
      </section>

      <!-- ARCHIVE -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">Erken İnternet Arşivi</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">berkgitarist yıllarının izleri</h2>
        <p class="mb-8 max-w-4xl text-lg leading-8 text-subtext">Köksal'ın erken internet dönemindeki bazı çalışmaları ve daha sonraki bağımsız üretimleri hâlâ çeşitli müzik arşivlerinde ve sanatçı platformlarında görülebiliyor. Bu bağlantılar o dönemin kamusal kayıtlarının bir parçası olarak korunuyor.</p>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {archiveLinks.map(([label, href]) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-2xl border border-accent/20 bg-accent/5 p-5 font-bold text-maintext transition-all hover:-translate-y-1 hover:border-accent/50 hover:bg-accent/10">
              <span>{label}</span><span class="text-accent transition-transform group-hover:translate-x-1">↗</span>
            </a>
          ))}
        </div>
      </section>

      <!-- IV -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">IV · Paganini, Malmsteen ve Klasik Müzik</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Virtüözite bir amaç değil, bir dile dönüştü</h2>
        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>Erken dönemindeki iddialı denemelerden biri Niccolò Paganini'nin <em>Caprice No. 24</em> eserine heavy-metal yaklaşımıydı. Teknik açıdan zorlayıcı klasik materyalle çalışmak, virtüözite, kompozisyon ve ağır gitar müziği arasında kurduğu köprüyü güçlendirdi.</p>
          <p>Yngwie Malmsteen'i keşfetmesi bir başka belirleyici dönüm noktası oldu. Malmsteen'in erken dönem müziğinde kendisinin de aradığı sese yakın bir dil buldu: neoklasik cümleler, diminished armoni, armonik minör renkleri, hızlı arpejler, ifade gücü yüksek solo gitar ve gitarın yarım ses aşağı akort edilmesiyle oluşan daha karanlık karakter.</p>
          <p>Aynı dönemde klasik müzik ilgisi derinleşti. Bach'ın yapısal ve matematiksel çok sesliliği onu etkilerken Handel ve Chopin de önemli referanslar olarak kaldı. Mozart ise çok daha güçlü bir duygusal bağ kurdu. Köksal, kendi eserleri dışında müzik tarihinden tek bir eser seçmesi gerekse Mozart'ın <em>Requiem</em>'ini seçeceğini ifade eder.</p>
          <p>Ian Anderson ve Jethro Tull da müzikal hayal dünyasında iz bıraktı. Anderson'ın flütü rock müziğinin içine yerleştirme biçimi, bir enstrümanın geleneksel rolünden çıkıp son derece kişisel bir sese dönüşebileceğini gösterdi.</p>
        </div>
      </section>

      <!-- V -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image"><img src="/artist/biography/berk-koksal-outdoor.webp" alt="Berk Köksal dış mekân portresi" class="aspect-[4/5] w-full object-cover" loading="lazy" /></div>
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">V · 1996: Kayıp ve Müziğin Duygusal Dili</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Şarkıların içinde kalan bir kayıp</h2>
          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>1996'da, on altı yaşındayken Berk Köksal annesi Aynur'u bir trafik kazasında kaybetti. O dönemde anne ve babası ayrıydı; annesi ve küçük kardeşiyle yaşıyordu. Annesinin ölümünden sonra iki kardeş yeniden babalarının evine dönmek zorunda kaldı; babasının daha sonra yeniden evlenmesiyle aile yapısı bir kez daha değişti.</p>
            <p>Köksal bugün annesinin ölümünü erken yaşamındaki en büyük duygusal kırılmalardan biri olarak görür. Daha sonraki TANRI'ya teslimiyetinden önce, annesine duyduğu özlem eserlerinde çoğu zaman adı konmamış bir tema olarak tekrar tekrar ortaya çıktı.</p>
            <p><em>Ne Olur Geri Dön</em> ve <em>Git Hadi Durma</em> bu duygusal dünyanın parçalarıdır. Tamamlanamayan <em>Kurtuluş Ölümde</em> ise yasın daha doğrudan bir ifadesine dönüştü. Yaklaşık yirmi yıl boyunca esere tekrar tekrar döndü ve çok sayıda kayıt denemesi yaptı; fakat hiçbirinde tatmin olduğu son biçime ulaşamadı.</p>
            <p>Yetişkinlikten geriye baktığında bu tamamlayamama hâlini yalnız teknik bir sorun değil, kaybın iç dünyasında ne kadar derin ve çözümsüz kaldığının bir göstergesi olarak da yorumlar.</p>
          </div>
        </div>
      </section>

      <!-- VI -->
      <section class="pro-glass p-8 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">VI · Gruplar, Sahne ve Elektro Gitar</p>
        <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Prova odalarından sahnelere</h2>
        <div class="grid grid-cols-1 gap-8 text-lg leading-8 text-subtext lg:grid-cols-2">
          <div class="space-y-6"><p>Köksal'ın ilk elektro gitarı İstanbul Unkapanı'ndan aldığı Prince modeliydi. Müzikal odağı giderek rock, metal ve solo gitara yönelirken bu enstrümanı uzun yıllar kullandı.</p><p>Yaklaşık 1998–1999 döneminden başlayarak ve askerlik sonrasında 2001'den İzmir'e taşınmasından önceki yıllara kadar farklı grup yapılanmalarında yer aldı. Gökmen Erdal ve Enver Meriç, iki ve zaman zaman üç gitar için düzenlemeler üzerinde uzun süre çalıştığı müzisyenler arasındaydı.</p></div>
          <div class="space-y-6"><p>Köksal çoğunlukla solo gitarist ve vokalist olarak çalıştı. Okul konserleri, bar performansları, provalar ve geniş repertuvarlar ona yalnız başına yaptığı MIDI çalışmalarından çok farklı bir pratik sahne eğitimi kazandırdı.</p><p>Kompozisyon, aranjman ve prodüksiyon zamanla daha merkezi hâle gelse de solo gitar geçmişi müzikal kimliğinin önemli bir parçası olarak kaldı.</p></div>
        </div>
      </section>

      <!-- VII -->
      <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="biography-image lg:order-2"><img src="/artist/biography/berk-koksal-home-studio.webp" alt="Berk Köksal ev stüdyosunda" class="aspect-[4/5] w-full object-cover" loading="lazy" /></div>
        <div class="lg:order-1">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">VII · One-Man Production</p>
          <h2 class="mb-8 text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Bir enstrüman çalmaktan bütün kaydı inşa etmeye</h2>
          <div class="space-y-6 text-lg leading-8 text-subtext">
            <p>MIDI bilgisi geliştikçe bas, davul, yaylılar ve diğer katmanları da kendisinin yazabileceğini fark etti. Bu durum geleneksel grup yapısına bağımlılığını giderek azalttı ve zamanla One-Man Production yaklaşımına dönüşecek yolu açtı.</p>
            <p>İlk sanal enstrümanlar günümüz araçlarından çok daha az gerçekçiydi ve erken dönem prodüksiyonlarının önemli bir bölümü belirgin bir MIDI karakteri taşıyordu. Ancak bu sınırlamalar onu öğrenmeye zorladı; tek enstrümanda uzmanlaşmak yerine bütün aranjmanı düşünmek zorundaydı.</p>
            <p>Kayıt teknolojisi yeni bir dünya açtı. Şarkı yazabilmek, onu kaydetmeyi, mikslemeyi ve master etmeyi otomatik olarak bilmeyi sağlamıyordu. Cool Edit ile başladı; Cubase, Propellerhead Reason ve Pro Tools kullandı; ilerleyen yıllarda iş akışının büyük bölümünü Studio One'a taşıdı.</p>
            <p>Maddi imkânları geliştikçe stüdyo ekipmanına daha ciddi yatırım yaptı ve miks, mastering ve modern prodüksiyon çalışmaya devam etti. Gitar ve tablatür ile başlayan süreç, bağımsız ve bütüncül bir prodüksiyon sistemine dönüştü.</p>
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section class="pro-glass p-8 md:p-14">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.8fr_1.2fr]">
          <div><p class="mb-5 text-xs font-bold uppercase tracking-[0.4em] text-accent">Prodüksiyon Pratiği</p><h2 class="text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">Her aşamada tek bir sanatsal vizyon</h2></div>
