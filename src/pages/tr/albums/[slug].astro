---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/nav.astro";
import { Icon } from "astro-icon/components";
import albums from "../../../data/albums.tr.json";
import {
  helllManifesto,
  helllTaglines,
  helllTracks,
  nineteenArchitecture,
  quranicSourceMap,
} from "../../../data/helll.tr";

export async function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const isHelll = album.slug === "helll";
const spotifyPlaceholder =
  "spotifyPlaceholder" in album && album.spotifyPlaceholder === true;

const currentIndex = albums.findIndex((item) => item.slug === album.slug);
const previous = albums[currentIndex - 1] ?? albums[albums.length - 1];
const next = albums[currentIndex + 1] ?? albums[0];

const genreItems = album.genre?.split("/").map((item) => item.trim()) ?? [];

const credits = [
  "Bestecilik",
  "Söz Yazımı",
  "Aranjman",
  "Prodüksiyon",
  "Vokaller",
  "Gitarlar",
  "Orkestrasyon",
  "Korolar",
  "Programlama",
  "Ses Tasarımı",
  "Miks",
  "Mastering",
  "Görsel Tasarım",
  "Konsept",
];

const features = genreItems.slice(0, 4);

const spotifyEmbedSource = album.spotifyEmbed || album.spotify;
const spotifyAlbumId = spotifyEmbedSource
  ?.split("/album/")
  ?.at(1)
  ?.split("?")
  ?.at(0)
  ?.split("/")
  ?.at(0);

const spotifyEmbedUrl = spotifyAlbumId
  ? `https://open.spotify.com/embed/album/${spotifyAlbumId}?utm_source=generator`
  : null;


const albumVisuals = {
  "zikr-symphonic-metal": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 BÖLÜM",
    variant: "monumental",
    accent: "#D6B56B",
    symbolOpacity: "0.105",
  },
  "zikr-jazz": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "jazz",
    accent: "#C9A77C",
    symbolOpacity: "0.09",
  },
  "zikr-i-batin": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "inner",
    accent: "#9B8CC7",
    symbolOpacity: "0.08",
  },
  "zikr-rap": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "rhythm",
    accent: "#D9B64D",
    symbolOpacity: "0.115",
  },
  "one-god-one-love": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "bright",
    accent: "#E3C98E",
    symbolOpacity: "0.085",
  },
  "classical-chorus": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "cathedral",
    accent: "#D4AF37",
    symbolOpacity: "0.10",
  },
  "zikr-rock": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "rock",
    accent: "#C86A4C",
    symbolOpacity: "0.11",
  },
  "zikr-nur": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 PARÇA",
    variant: "light",
    accent: "#E4DFA8",
    symbolOpacity: "0.085",
  },
  "zikr-huu": {
    symbol: "HÛ",
    secondarySymbol: "HÛ",
    structureLabel: "HÛ • 9 PARÇA",
    variant: "breath",
    accent: "#B9C9D8",
    symbolOpacity: "0.075",
  },
  "zikr-symphony": {
    symbol: "XIX",
    secondarySymbol: "XIX × XIX",
    structureLabel: "XIX × XIX • 19 + 19",
    variant: "symphony",
    accent: "#D4AF37",
    symbolOpacity: "0.11",
  },
  "tanrinin-hediyesi": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "III • 3 PARÇA",
    variant: "origin",
    accent: "#CFAD78",
    symbolOpacity: "0.075",
  },
} as const;

const defaultAlbumVisual = {
  symbol: album.tracksCount === "19" ? "XIX" : album.tracksCount,
  secondarySymbol: album.tracksCount === "19" ? "XIX" : album.tracksCount,
  structureLabel: `${album.tracksCount} PARÇA`,
  variant: "default",
  accent: "#D4AF37",
  symbolOpacity: "0.09",
};

const albumVisual =
  albumVisuals[album.slug as keyof typeof albumVisuals] ?? defaultAlbumVisual;
---

<Layout
  title={`${album.title} | Berk KÖKSAL`}
  description={album.description}
  canonical={`/tr/albums/${album.slug}/`}
  ogImage={album.cover}
  ogType="music.album"
  twitterCard="summary_large_image"
  lang="tr"
  pageClass={isHelll ? "helll-theme" : ""}
  disableAmbient={isHelll}
>
  <Nav />

  {isHelll && (
    <>
      <!-- HELLL HERO -->
      <section class="relative overflow-hidden pb-8 pt-28 md:pt-32">
        <div class="absolute inset-0 -z-30 bg-black"></div>
        <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_50%_18%,rgba(104,0,0,0.12),transparent_34%),linear-gradient(to_bottom,#000_0%,#030101_58%,#000_100%)]"></div>

        <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 md:px-6 lg:grid-cols-[minmax(420px,0.85fr)_minmax(0,1.3fr)] lg:gap-12">
          <button
            type="button"
            class="album-cover-button group relative"
            aria-label={`${album.title} kapağını aç`}
          >
            <div class="absolute -inset-8 rounded-full bg-[#730000]/10 blur-3xl transition-opacity duration-700 group-hover:bg-[#920000]/15"></div>
            <img
              src={album.cover}
              alt={album.title}
              class="relative mx-auto w-full max-w-xl rounded-[2rem] border border-white/10 bg-black shadow-[0_0_100px_rgba(120,0,0,0.14)] transition-transform duration-700 group-hover:scale-[1.018]"
            />
          </button>

          <div class="min-w-0 text-center lg:text-left">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.48em] text-[#b74a4a]">
              QURANIC CONCEPTS • CEHENNEM • 2026
            </p>

            <h1 class="max-w-full whitespace-nowrap font-heading text-[clamp(4rem,6vw,7rem)] font-bold leading-none tracking-[-0.04em] text-white">
  CEHENNEMM
</h1>

            <p class="mt-5 text-sm font-bold uppercase tracking-[0.35em] text-white/40">
              19 PARÇA • TEK İNİŞ • TEK SON HATIRLATMA
            </p>

            <h2 class="mt-9 text-2xl font-heading font-bold uppercase leading-9 text-white md:text-3xl">
              {helllTaglines[0]}
            </h2>

            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/58 lg:mx-0">
              {album.description}
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start">
              <span class="rounded-full border border-[#8f1c1c]/45 bg-[#7f1212]/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-[#d16c6c]">
                Muhteşem Bir Rahatsız Edicilik.
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">XIX</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">19 × 19</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">NINETEEN • 19:19</span>
            </div>

            <div class="mt-9 flex flex-wrap justify-center gap-4 lg:justify-start">
              <!-- TODO: Replace HELLL's temporary Spotify URL and set spotifyPlaceholder to false after release. -->
              <a
                href={album.spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 rounded-full border border-[#1DB954]/30 bg-[#1DB954]/10 px-7 py-3 font-bold text-white transition hover:bg-[#1DB954]/20"
              >
                <Icon name="mdi:spotify" class="h-5 w-5 text-[#1DB954]" />
                Spotify
              </a>

              <a
                href="/tr/quranic-concepts/"
                class="inline-flex items-center gap-3 rounded-full border border-[#8f1c1c]/45 bg-[#7f1212]/10 px-7 py-3 font-bold text-white transition hover:bg-[#7f1212]/20"
              >
                QURANIC CONCEPTS
              </a>
            </div>
          </div>
        </div>
      </section>

      {spotifyEmbedUrl && (
        <div class="max-w-6xl mx-auto px-4 mt-6 mb-16 md:mt-8 md:mb-24">
          <div class="rounded-[2rem] border border-[#1DB954]/25 bg-[#1DB954]/5 p-4 md:p-5 shadow-[0_0_60px_rgba(29,185,84,0.08)]">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="mdi:spotify" class="w-5 h-5 text-[#1DB954]" />
              <p class="text-[#1DB954] text-xs uppercase tracking-[0.35em] font-bold">
                Resmî Spotify Yayını
              </p>
            </div>

            <div class="overflow-hidden rounded-[1.25rem] border border-[#1DB954]/20 bg-background/40">
              <iframe
                src={spotifyEmbedUrl}
                width="100%"
                height="492"
                frameborder="0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                class="block h-[352px] sm:h-[420px] lg:h-[492px]"
              ></iframe>
            </div>
          </div>
        </div>
      )}

      <div class="mx-auto max-w-6xl space-y-20 pb-28 md:space-y-28">
        <!-- OPENING -->
        <section class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.018] p-7 md:p-14">
          <div
            class="pointer-events-none absolute -right-10 -top-10 select-none text-[16rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.055] md:-right-16 md:-top-16 md:text-[26rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">I · İlk Sözden Önce</p>
            <h2 class="max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
              Önce kalp durur. Sonra sesler başlar.
            </h2>

            <div class="mt-10 grid grid-cols-1 gap-7 lg:grid-cols-[0.8fr_1.2fr]">
            <div class="rounded-2xl border border-[#8f1c1c]/35 bg-black p-7">
              <div class="space-y-3 font-mono text-xl font-bold uppercase tracking-[0.18em] text-white/80 md:text-2xl">
                <p>KALP ATIŞI.</p>
                <p>HASTANE MONİTÖRÜ.</p>
                <p>DÜZ ÇİZGİ.</p>
                <p class="text-[#c24f4f]">ÖLÜM.</p>
              </div>
            </div>

            <div class="space-y-5 text-lg leading-8 text-white/58">
              <p>
                HELLL ilk sözden önce başlar. Kalp atışı ve hastane monitörü sıradan yaşamın son saniyelerini kurar. Nabız zayıflar. Monitör kesintisiz bir tona dönüşür. Kişi ölür.
              </p>
              <p>
                Ancak bu geçişten sonra HELLL’in koroları, ateşi ve sesleri devreye girer. Bunların altında iki tekrar eden varlık zaten çalışmaktadır: felaket boyunca çalmayı sürdüren yalnız bir kemancı ve müziğin daha da altından yükseliyormuş gibi duyulan gömülü bir koro. Ölüm albümün son sahnesi olarak kullanılmaz; albümün başladığı eşiktir.
              </p>
              <p class="font-heading text-2xl font-bold leading-9 text-white">
                HELLL ölümle başlar. Uyarı yaşayanlar içindir.
              </p>
            </div>
          </div>
          </div>
        </section>

        <!-- ABOUT -->
        <section class="relative grid grid-cols-1 gap-10 overflow-hidden lg:grid-cols-[0.75fr_1.25fr]">
          <div
            class="pointer-events-none absolute -right-10 -top-12 select-none text-[15rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.05] md:-right-14 md:-top-16 md:text-[24rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">II</p>
            <h2 class="text-4xl font-heading font-bold text-white md:text-5xl">
              Cehennemin bir tasviri değil. İşitilebilir hâle getirilmiş bir uyarı.
            </h2>
          </div>

          <div class="relative z-10 space-y-6 text-lg leading-8 text-white/58">
            <p>
              HELLL, Berk Köksal’ın QURANIC CONCEPTS serisindeki ilk albümdür. Kavramsal mimarisi; yargı, ceza, pişmanlık, susuzluk, açlık, hapsedilme, tanıklık, sorumluluk ve kalıcılığa ilişkin KURAN sahneleri ve tekrar eden imgeler üzerine kuruludur.
            </p>
            <p>
              Proje KURAN’ı estetik bir dekor olarak kullanmaz. Doğrudan kaynak referansları KURAN kaynağı olarak belirtilir; bağlayıcı diyaloglar, dramatik çerçeve ve ses tasarımı ise sanatsal yorum olarak kalır.
            </p>
            <p class="font-heading text-2xl font-bold uppercase leading-9 text-white">
              {helllTaglines[2]}
            </p>
          </div>
        </section>

        <!-- MANIFESTO -->
        <section class="relative overflow-hidden rounded-[2rem] border border-[#8f1c1c]/35 bg-[#5b0909]/[0.06] p-7 md:p-14">
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none text-[16rem] font-heading font-bold leading-none tracking-[-0.06em] text-[#8f1c1c]/[0.12] md:text-[26rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">III · Manifesto</p>
          <h2 class="max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
            UYARI DUYULMALI.
          </h2>

          <div class="mt-10 grid grid-cols-1 gap-6 text-lg leading-8 text-white/58 lg:grid-cols-2">
            {helllManifesto.map((paragraph, index) => (
              <p class={index === helllManifesto.length - 1 ? "lg:col-span-2" : ""}>{paragraph}</p>
            ))}
          </div>

          <blockquote class="mt-12 border-l-2 border-[#a62d2d] pl-6 font-heading text-2xl font-bold italic leading-9 text-white md:text-3xl">
            “Şeytanın bile gözyaşları içinde dinleyeceği kadar sarsıcı bir albüm.”
          </blockquote>
          </div>
        </section>

        <!-- MUSICAL IDENTITY -->
        <section class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-8 top-10 select-none text-[15rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.055] md:-right-14 md:text-[24rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">IV · Müzikal Kimlik</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            Uç ses dünyasıyla ifade edilen kutsal bir uyarı.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            HELLL; progresif metal, senfonik ekstrem metal, funeral doom, endüstriyel dokular, thrash, neoklasik biçimler, kutsal ve lanetlenmiş korolar, sinematik ses tasarımı ve sessizlik arasında hareket eder. Sahne değiştiği için türler değişir. Uyarı değişmez.
          </p>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {[
              'Qur\'anic Concept Metal',
              'Progresif Metal',
              'Senfonik / Ekstrem Metal',
              'Kutsal & Lanetlenmiş Korolar',
              'Sinematik Ses Tasarımı',
              'Barok & Neoklasik Biçimler',
              'Funeral Doom',
              'Endüstriyel Metal',
            ].map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-5 font-heading font-bold text-white/75">
                {item}
              </div>
            ))}
          </div>

          <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
            <article class="rounded-[2rem] border border-[#8f1c1c]/35 bg-[#650c0c]/[0.06] p-7 md:p-9">
              <p class="text-xs font-bold uppercase tracking-[0.35em] text-[#b74a4a]">Tekrar Eden Figür · Sarsılmayan Kemancı</p>
              <h3 class="mt-4 text-3xl font-heading font-bold leading-tight text-white md:text-4xl">
                Her şey çökerken o çalmaya devam eder.
              </h3>
              <div class="mt-5 space-y-4 leading-7 text-white/52">
                <p>
                  On dokuz eserin tamamında yalnız bir kemancı arka planda kalır. Çevresindeki şiddete tepki vermez; dış dünya çöküyor olsa bile yay hareket etmeye devam eder. İcra, felaketten bilinçli biçimde kopuktur; sanki bu müzisyen oradan korkmak yerine o yere aitmiş gibidir.
                </p>
                <p>
                  Bu figür, Niccolò Paganini’ye ve onun virtüözitesi çevresinde oluşan şeytani mitolojiye bilinçli bir göndermedir. 19. yüzyılda — HELLL’in on dokuz mimarisini sessizce yansıtan tarihsel bir ayrıntı — Paganini’nin insanüstü görünen icrası, Şeytan’la anlaşma yaptığına dair yaygın efsaneleri besledi; dönemin bir anlatısında bir dinleyicinin onun dirseğinin yanında yayı yönlendiren Şeytan’ı gördüğünü iddia ettiği bile aktarılır. HELLL bu efsaneyi tarihsel gerçek olarak sunmaz. Efsanenin geride bıraktığı imgeyi kullanır: çevresindeki felakete kayıtsız, sanki Cehennemin içinden çalıyormuş gibi duyulan bir kemancı.
                </p>
              </div>
            </article>

            <article class="rounded-[2rem] border border-white/10 bg-white/[0.02] p-7 md:p-9">
              <p class="text-xs font-bold uppercase tracking-[0.35em] text-white/40">Tekrar Eden Katman · Cehennem Korosu</p>
              <h3 class="mt-4 text-3xl font-heading font-bold leading-tight text-white md:text-4xl">
                Koronun altında başka bir koro bekliyor.
              </h3>
              <div class="mt-5 space-y-4 leading-7 text-white/52">
                <p>
                  HELLL, ana müzikal korolarının altında ikinci bir koro varlığı taşır: Cehennem Korosu. Sesleri bilinçli biçimde miksin çok derinine yerleştirilir; neredeyse yeraltındaki bir ses katmanı gibi, uzak, örtülü ve görünür müziğin altından yükseliyormuş gibi duyulur.
                </p>
                <p>
                  Bu gizli koro, geleneksel bir ön plan performansı olmaktan çok albümün çevresinin bir parçası olarak on dokuz eserin tamamına yerleştirilmiştir. Amacı Cehennemin kendisine ilişkin imgeyi yoğunlaştırmaktır: şarkılar yalnızca mekânı anlatmaz; içeriden geliyormuş gibi duyulan seslerle çevrilir.
                </p>
              </div>
            </article>
          </div>
          </div>
        </section>

        <!-- 19 TRACK DESCENT -->
        <section class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-6 top-4 select-none text-[17rem] font-heading font-bold leading-none tracking-[-0.06em] text-[#8f1c1c]/[0.12] md:-right-10 md:text-[26rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">V · 19 Parçalık İniş</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            On dokuz aşama. Geri döndürülemez tek bir hareket.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            Her parça farklı bir KURAN imgesini veya tekrar eden fikri ayırarak ele alır. Aşağıdaki kartlar her şarkının kavramsal rolünü ve kaynak haritasında kullanılan ayet referanslarını gösterir.
          </p>

          <div class="space-y-4">
            {helllTracks.map((track) => (
              <article class={`rounded-2xl border p-6 md:p-7 ${track.no === '19' ? 'border-[#9d2929]/60 bg-[#6d0d0d]/10' : 'border-white/10 bg-white/[0.018]'}`}>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-[72px_1fr_auto] md:items-start">
                  <div class="font-mono text-2xl font-bold text-[#9e3232]">{track.no}</div>
                  <div>
                    <h3 class="text-2xl font-heading font-bold text-white md:text-3xl">{track.title}</h3>
                    <p class="mt-2 font-heading font-bold text-white/75">{track.hook}</p>
                    <p class="mt-4 max-w-4xl leading-7 text-white/50">{track.concept}</p>
                  </div>
                  <div class="flex flex-wrap gap-2 md:max-w-[260px] md:justify-end">
                    {track.references.map((reference) => (
                      <span class="rounded-full border border-[#8f1c1c]/35 bg-[#7f1212]/10 px-3 py-1.5 text-xs font-bold text-[#d16c6c]">
                        {reference}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
          </div>
        </section>

        <!-- QURAN SOURCE MAP -->
        <section class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-8 top-2 select-none text-[15rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.055] md:-right-12 md:-top-4 md:text-[24rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">VI · KURAN Kaynak Haritası</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
