      color: color-mix(in srgb, var(--album-accent) 80%, white 20%);
      font-size: 0.75rem;
    }

    .album-primary-button {
      border-color: color-mix(in srgb, var(--album-accent) 48%, transparent);
      box-shadow: 0 0 34px color-mix(in srgb, var(--album-accent) 12%, transparent);
    }

    .album-primary-button:hover,
    .album-secondary-button:hover,
    .album-nav-card:hover {
      border-color: color-mix(in srgb, var(--album-accent) 66%, transparent);
      background: color-mix(in srgb, var(--album-accent) 13%, transparent);
      box-shadow: 0 0 42px color-mix(in srgb, var(--album-accent) 14%, transparent);
    }

    .album-panel,
    .album-final {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.035),
        0 24px 80px rgba(0, 0, 0, 0.2);
    }

    .album-feature-card,
    .album-credit-card {
      background: color-mix(in srgb, var(--color-background) 78%, transparent);
      backdrop-filter: blur(10px);
    }

    .album-track-list {
      background: linear-gradient(
        145deg,
        color-mix(in srgb, var(--album-accent) 7%, transparent),
        color-mix(in srgb, var(--color-background) 84%, transparent)
      );
      backdrop-filter: blur(10px);
    }

    .album-track-row {
      border-bottom: 1px solid color-mix(in srgb, var(--album-accent) 12%, transparent);
    }

    .album-track-row:hover {
      background: color-mix(in srgb, var(--album-accent) 8%, transparent);
    }

    .album-track-icon {
      color: color-mix(in srgb, var(--album-accent) 48%, transparent);
    }

    .album-track-row:hover .album-track-icon {
      color: var(--album-accent);
    }

    .album-final {
      background:
        radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--album-accent) 8%, transparent), transparent 64%),
        color-mix(in srgb, var(--color-background) 92%, black 8%);
    }

    .album-watermark {
      position: absolute;
      z-index: 0;
      pointer-events: none;
      user-select: none;
      font-family: var(--font-heading);
      font-weight: 800;
      line-height: 0.78;
      letter-spacing: -0.07em;
      color: var(--album-accent);
      opacity: var(--album-symbol-opacity);
      white-space: nowrap;
    }

    .album-watermark--hero {
      right: -0.07em;
      top: 13%;
      font-size: clamp(15rem, 35vw, 38rem);
    }

    .album-watermark--about {
      right: -0.08em;
      top: 50%;
      transform: translateY(-50%);
      font-size: clamp(13rem, 27vw, 29rem);
    }

    .album-watermark--identity {
      right: -0.08em;
      top: -0.05em;
      font-size: clamp(15rem, 30vw, 31rem);
    }

    .album-watermark--tracks {
      left: -0.08em;
      top: 0.04em;
      font-size: clamp(12rem, 23vw, 24rem);
    }

    .album-watermark--production {
      right: -0.08em;
      top: 50%;
      transform: translateY(-50%);
      font-size: clamp(13rem, 25vw, 26rem);
    }

    .album-watermark--final {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      font-size: clamp(15rem, 34vw, 36rem);
    }

    /* Symphonic Metal: monumental and vertical. */
    .album-world--monumental .album-watermark {
      letter-spacing: -0.1em;
      text-shadow: 0 0 70px color-mix(in srgb, var(--album-accent) 24%, transparent);
    }

    .album-world--monumental .album-watermark--hero {
      top: 8%;
      transform: scaleY(1.08);
    }

    /* Jazz: looser, slanted and more fluid. */
    .album-world--jazz .album-watermark {
      font-weight: 560;
      letter-spacing: -0.03em;
      font-style: italic;
    }

    .album-world--jazz .album-watermark--hero,
    .album-world--jazz .album-watermark--identity {
      transform: rotate(-8deg);
      transform-origin: center;
    }

    .album-world--jazz .album-watermark--tracks {
      transform: rotate(6deg);
    }

    /* Zikr-i Batin: symbol sits deeper, as if inside the page. */
    .album-world--inner .album-watermark {
      filter: blur(0.6px);
      mask-image: radial-gradient(circle, black 25%, transparent 78%);
      -webkit-mask-image: radial-gradient(circle, black 25%, transparent 78%);
    }

    .album-world--inner .album-watermark--hero,
    .album-world--inner .album-watermark--identity {
      right: 50%;
      transform: translateX(50%);
    }

    /* Rap: blocky and offset. */
    .album-world--rhythm .album-watermark {
      letter-spacing: -0.12em;
      transform: skewX(-7deg);
    }

    .album-world--rhythm .album-watermark--tracks {
      left: auto;
      right: -0.08em;
    }

    /* One God One Love: softer and more open. */
    .album-world--bright .album-watermark {
      letter-spacing: 0.01em;
      text-shadow: 0 0 90px color-mix(in srgb, var(--album-accent) 28%, transparent);
    }

    .album-world--bright .album-watermark--about,
    .album-world--bright .album-watermark--final {
      opacity: 0.07;
    }

    /* Classical Chorus: symmetrical cathedral-like placement. */
    .album-world--cathedral .album-watermark {
      letter-spacing: 0.035em;
      font-weight: 700;
    }

    /* Keep Classical Chorus readable like Zikr Nur: XIX stays right-anchored instead of being centered/cropped. */
    .album-world--cathedral .album-watermark--hero {
      right: -0.07em;
      left: auto;
      top: 13%;
      transform: none;
      font-size: clamp(15rem, 35vw, 38rem);
    }

    .album-world--cathedral .album-watermark--identity {
      right: -0.08em;
      left: auto;
      transform: none;
    }

    .album-world--cathedral .album-watermark--final {
      left: 50%;
      right: auto;
      transform: translate(-50%, -50%);
    }

    /* Rock: sharper, skewed, stage-like. */
    .album-world--rock .album-watermark {
      transform: skewX(-9deg) rotate(2deg);
      letter-spacing: -0.11em;
      text-shadow: 0 0 65px color-mix(in srgb, var(--album-accent) 24%, transparent);
    }

    .album-world--rock .album-watermark--about,
    .album-world--rock .album-watermark--production {
      transform: translateY(-50%) skewX(-9deg) rotate(2deg);
    }

    .album-world--rock .album-watermark--final {
      transform: translate(-50%, -50%) skewX(-9deg) rotate(2deg);
    }

    /* Nur: luminous, fading toward the edges. */
    .album-world--light .album-watermark {
      text-shadow:
        0 0 45px color-mix(in srgb, var(--album-accent) 45%, transparent),
        0 0 110px color-mix(in srgb, var(--album-accent) 20%, transparent);
      mask-image: linear-gradient(90deg, transparent 0%, black 25%, black 72%, transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 25%, black 72%, transparent 100%);
    }

    /* Huu: breath-like spacing instead of an XIX motif. */
    .album-world--breath .album-watermark {
      letter-spacing: 0.12em;
      font-weight: 560;
      filter: blur(0.25px);
      text-shadow: 0 0 80px color-mix(in srgb, var(--album-accent) 24%, transparent);
    }

    .album-world--breath .album-watermark--hero {
      right: 7%;
      top: 23%;
      font-size: clamp(9rem, 20vw, 21rem);
    }

    .album-world--breath .album-watermark--about {
      font-size: clamp(9rem, 18vw, 19rem);
    }

    .album-world--breath .album-watermark--identity {
      font-size: clamp(10rem, 20vw, 21rem);
    }

    .album-world--breath .album-watermark--tracks {
      font-size: clamp(8rem, 16vw, 17rem);
    }

    .album-world--breath .album-watermark--production {
      font-size: clamp(9rem, 18vw, 19rem);
    }

    .album-world--breath .album-watermark--final {
      font-size: clamp(11rem, 23vw, 24rem);
    }

    /* Zikr Symphony: strongest non-HELLL XIX architecture. */
    .album-world--symphony .album-watermark {
      letter-spacing: -0.045em;
      text-shadow: 0 0 80px color-mix(in srgb, var(--album-accent) 20%, transparent);
    }

    .album-world--symphony .album-watermark--tracks {
      left: -0.03em;
      font-size: clamp(9rem, 17vw, 19rem);
      opacity: 0.13;
    }

    /* Tanrinin Hediyesi: XIX is a quiet universe signature; the factual chip still says III / 3 tracks. */
    .album-world--origin .album-watermark {
      letter-spacing: -0.05em;
      font-weight: 700;
    }

    .album-world--origin .album-watermark--hero {
      right: -0.04em;
      top: 15%;
      font-size: clamp(13rem, 31vw, 33rem);
    }

    .album-world--origin .album-watermark--identity {
      right: -0.06em;
      font-size: clamp(13rem, 27vw, 28rem);
    }

    @media (max-width: 767px) {
      .album-watermark {
        opacity: 0.055;
      }

      .album-watermark--hero {
        top: 18%;
        right: -0.12em;
      }

      .album-watermark--about,
      .album-watermark--production {
        right: -0.12em;
      }

      .album-watermark--tracks {
        left: -0.12em;
      }
    }
  </style>

  <script>
    const openButton = document.querySelector(".album-cover-button");
    const lightbox = document.querySelector("#cover-lightbox");
    const closeButton = document.querySelector("#close-lightbox");

    openButton?.addEventListener("click", () => {
      lightbox?.classList.remove("hidden");
      lightbox?.classList.add("flex");
    });

    const closeLightbox = () => {
      lightbox?.classList.add("hidden");
      lightbox?.classList.remove("flex");
    };

    closeButton?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeLightbox();
    });
  </script>
</Layout>
