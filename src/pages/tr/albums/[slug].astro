          id="close-lightbox"
          class="album-accent-text absolute right-6 top-6 transition hover:text-maintext"
          aria-label="Kapağı kapat"
        >
          <Icon name="mdi:close" class="h-9 w-9" />
        </button>
        <img
          src={album.cover}
          alt={album.title}
          class="album-lightbox-image max-h-[90vh] max-w-[90vw] rounded-3xl"
        />
      </div>
    </div>
  )}

  <style>
    .album-world {
      --album-accent: #D4AF37;
      --album-symbol-opacity: 0.09;
    }

    .album-accent-text {
      color: var(--album-accent);
