    .album-hero-glow,
    .album-cover-glow {
      background: color-mix(in srgb, var(--album-accent) 22%, transparent);
    }

    .album-cover-image,
    .album-lightbox-image {
      border: 1px solid color-mix(in srgb, var(--album-accent) 42%, transparent);
      box-shadow:
        0 0 90px color-mix(in srgb, var(--album-accent) 24%, transparent),
        0 24px 80px rgba(0, 0, 0, 0.38);
    }

    .album-structure-chip,
    .album-genre-chip,
    .album-structure-note,
    .album-primary-button,
    .album-secondary-button,
    .album-feature-card,
    .album-track-list,
    .album-credit-card,
    .album-final,
    .album-nav-card {
      border: 1px solid color-mix(in srgb, var(--album-accent) 26%, transparent);
      background: color-mix(in srgb, var(--album-accent) 7%, transparent);
    }

    .album-structure-chip {
      border-radius: 9999px;
      padding: 0.55rem 0.9rem;
      color: var(--album-accent);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .album-genre-chip {
