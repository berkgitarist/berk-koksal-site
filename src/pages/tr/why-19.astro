        <div class="xix-fact-desktop mt-10 overflow-hidden rounded-2xl border border-accent/15 bg-background/25">
          <table class="xix-table">
            <thead><tr><th class="w-[72px]">{copy.tableNum}</th><th>{copy.tableObs}</th><th class="w-[190px]">{copy.tableRel}</th></tr></thead>
            <tbody>
              {simpleFacts.map((fact) => (
                <tr><td class="font-mono font-bold text-[#D4AF37]">{fact.no}</td><td class="leading-7 text-subtext">{fact.observation}</td><td class="font-heading font-bold text-maintext">{fact.relation}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="xix-fact-mobile mt-8 gap-3">
          {simpleFacts.map((fact) => (
            <article class="rounded-2xl border border-accent/15 bg-background/30 p-5">
              <div class="flex items-center justify-between gap-4"><span class="font-mono text-sm font-bold text-[#D4AF37]">{fact.no.padStart(2,'0')}</span><span class="rounded-full border border-[#D4AF37]/25 bg-[#D4AF37]/[0.06] px-3 py-1 text-xs font-bold text-[#E7C966]">{fact.relation}</span></div>
              <p class="mt-4 text-sm leading-7 text-subtext">{fact.observation}</p>
