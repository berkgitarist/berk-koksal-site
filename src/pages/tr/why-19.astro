<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogImage="/artist/berk-portrait.webp"
  lang={pageLang}
>
  <Nav />

  <section class="why19-shell py-10 md:py-28">
    <div class="mx-auto max-w-6xl space-y-10 md:space-y-24">
      <header class="relative overflow-hidden rounded-[2rem] border border-accent/20 bg-accent/[0.045] px-6 py-14 shadow-2xl shadow-black/20 md:px-12 md:py-20 lg:px-16">
        <div class="pointer-events-none absolute -right-8 -top-14 select-none font-heading text-[11rem] font-bold leading-none text-[#D4AF37]/[0.07] sm:text-[15rem] md:text-[22rem]" aria-hidden="true">XIX</div>
        <div class="pointer-events-none absolute inset-x-12 top-0 h-px xix-rule" aria-hidden="true"></div>
        <div class="relative z-10 max-w-4xl">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.42em] text-[#D4AF37]">{copy.eyebrow}</p>
          <h1 class="xix-glow text-5xl font-heading font-bold leading-none text-maintext sm:text-6xl md:text-8xl">{copy.h1}</h1>
          <p class="mt-7 max-w-3xl text-lg leading-8 text-subtext md:text-xl md:leading-9">{copy.hero}</p>
          <div class="mt-8 rounded-2xl border border-[#D4AF37]/20 bg-[#D4AF37]/[0.055] p-5 text-sm leading-7 text-subtext md:p-6">
            <strong class="text-[#E7C966]">{copy.noteLabel}:</strong> {copy.source}
          </div>
          <div class="mt-8 flex flex-wrap gap-3 text-xs font-bold uppercase tracking-[0.14em]">
            <a href="#quran-74" class="rounded-full border border-accent/25 bg-accent/5 px-4 py-2.5 text-accent transition hover:border-accent/55 hover:bg-accent/10">{copy.jump1}</a>
            <a href="#simple-facts" class="rounded-full border border-accent/25 bg-accent/5 px-4 py-2.5 text-accent transition hover:border-accent/55 hover:bg-accent/10">{copy.jump2}</a>
            <a href="#closer-look" class="rounded-full border border-accent/25 bg-accent/5 px-4 py-2.5 text-accent transition hover:border-accent/55 hover:bg-accent/10">{copy.jump3}</a>
            <a href="#why-i-use-it" class="rounded-full border border-accent/25 bg-accent/5 px-4 py-2.5 text-accent transition hover:border-accent/55 hover:bg-accent/10">{copy.jump4}</a>
          </div>
        </div>
      </header>

      <section id="quran-74" class="scroll-mt-28">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-12">
          <div>
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.4em] text-[#D4AF37]">{copy.sec1}</p>
            <h2 class="text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">{copy.sec1h}</h2>
            <p class="mt-6 text-lg leading-8 text-subtext">{copy.sec1p}</p>
          </div>
          <div class="overflow-hidden rounded-[2rem] border border-accent/15 bg-background/35">
            {verses.map((verse, index) => (
              <div class:list={[
                'grid grid-cols-[64px_1fr] gap-4 px-5 py-5 md:grid-cols-[82px_1fr] md:px-7 md:py-6',
                index !== verses.length - 1 && 'border-b border-accent/10',
                verse.ref === '74:30' && 'bg-[#D4AF37]/[0.055]',
                verse.ref === '74:35' && 'bg-accent/[0.04]'
              ]}>
                <div class="font-mono text-sm font-bold text-[#D4AF37]">{verse.ref}</div>
                <p class:list={[
                  'leading-7 text-subtext md:text-lg md:leading-8',
                  (verse.ref === '74:30' || verse.ref === '74:35') && 'font-heading text-xl font-bold text-maintext md:text-2xl'
                ]}>{verse.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-7 rounded-2xl border border-accent/15 bg-accent/[0.035] p-6 text-sm leading-7 text-subtext md:px-8">
          <span class="font-bold text-accent">{copy.noteLabel} — 74:30–35:</span> {sourceNote}
        </div>
      </section>

      <section id="simple-facts" class="scroll-mt-28 rounded-[2rem] border border-accent/15 bg-accent/[0.025] p-6 md:p-10 lg:p-12">
        <div class="max-w-4xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.4em] text-[#D4AF37]">{copy.sec2}</p>
