        <article class="mt-5 rounded-[2rem] border border-accent/15 bg-background/30 p-6 md:p-9">
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.75fr_1.25fr]">
            <div><p class="text-xs font-bold uppercase tracking-[0.35em] text-accent">1:1–7</p><h3 class="mt-3 text-3xl font-heading font-bold text-maintext">{copy.fatihaTitle}</h3><p class="mt-5 leading-8 text-subtext">{copy.fatihaP}</p></div>
            <div class="overflow-hidden rounded-2xl border border-accent/15"><table class="xix-table"><thead><tr><th>{copy.fcol1}</th><th>{copy.fcol2}</th><th>{copy.fcol3}</th></tr></thead><tbody>{fatihaRows.map((row) => (<tr><td class="font-mono font-bold text-[#D4AF37]">{row.verse}</td><td class="text-subtext">{row.letters}</td><td class="font-heading font-bold text-maintext">{row.value}</td></tr>))}</tbody></table></div>
          </div>
        </article>

        <details class="mt-5 rounded-2xl border border-accent/15 bg-accent/[0.025] p-6 open:bg-accent/[0.035]">
          <summary class="cursor-pointer font-heading text-lg font-bold text-maintext">{copy.noteLabel} · Q / XIX</summary>
          <div class="mt-5 space-y-4 text-sm leading-7 text-subtext">{qExampleSource.map((line) => <p>{line}</p>)}<p class="border-t border-accent/10 pt-4">{discoveryNote}</p></div>
        </details>
      </section>

      <section id="why-i-use-it" class="scroll-mt-28 relative overflow-hidden rounded-[2rem] border border-[#D4AF37]/25 bg-[#D4AF37]/[0.04] p-7 md:p-12">
        <div class="pointer-events-none absolute -bottom-14 -right-8 select-none font-heading text-[12rem] font-bold leading-none text-[#D4AF37]/[0.055] md:text-[20rem]" aria-hidden="true">19</div>
        <div class="relative z-10 max-w-4xl"><p class="mb-4 text-xs font-bold uppercase tracking-[0.4em] text-[#D4AF37]">{copy.sec4}</p><h2 class="text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">{copy.sec4h}</h2><div class="mt-7 space-y-5 text-lg leading-8 text-subtext"><p>{copy.personal1}</p><p>{copy.personal2}</p></div><div class="mt-9 inline-flex max-w-full flex-wrap items-center rounded-2xl border border-[#D4AF37]/25 bg-background/25 px-5 py-4 font-heading text-base font-bold text-[#E7C966] md:text-xl">{copy.path}</div></div>
      </section>

      <section class="rounded-[2rem] border border-accent/15 bg-accent/[0.025] p-7 text-center md:p-12">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.4em] text-[#D4AF37]">{copy.sec5}</p><h2 class="mx-auto max-w-4xl text-4xl font-heading font-bold leading-tight text-maintext md:text-5xl">{copy.sec5h}</h2><p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-subtext">{copy.sec5p}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="https://qurantft.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full border border-accent/40 bg-accent/10 px-6 py-3 text-sm font-bold text-accent transition hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-background">{copy.quranBtn}</a><a href="https://kuranteyit.com/#appendices" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full border border-[#D4AF37]/35 bg-[#D4AF37]/[0.06] px-6 py-3 text-sm font-bold text-[#E7C966] transition hover:-translate-y-0.5 hover:border-[#D4AF37]/70 hover:bg-[#D4AF37]/10">{copy.evidenceBtn}</a></div>
        <p class="mx-auto mt-8 max-w-3xl text-xs leading-6 text-subtext/65">{copy.footer}</p>
      </section>
    </div>
  </section>

  <style>
    .why19-shell { --xix-gold: #D4AF37; }
    .xix-glow { text-shadow: 0 0 42px rgba(212,175,55,.18); }
    .xix-rule { background: linear-gradient(90deg, transparent, rgba(212,175,55,.55), transparent); }
    .xix-table { width:100%; border-collapse:collapse; }
    .xix-table th,.xix-table td { padding:1rem 1.1rem; vertical-align:top; border-bottom:1px solid color-mix(in srgb,var(--color-accent),transparent 84%); }
    .xix-table th { text-align:left; font-size:.72rem; line-height:1rem; text-transform:uppercase; letter-spacing:.18em; color:color-mix(in srgb,var(--color-accent),white 18%); background:color-mix(in srgb,var(--color-accent),transparent 94%); }
    .xix-table tbody tr:last-child td { border-bottom:0; }
    .xix-table tbody tr:hover td { background:color-mix(in srgb,var(--color-accent),transparent 96%); }
    .xix-fact-mobile { display:none; }
    @media (max-width:767px) { .xix-fact-desktop{display:none}.xix-fact-mobile{display:grid} }
  </style>
</Layout>
