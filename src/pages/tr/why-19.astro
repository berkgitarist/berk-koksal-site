            <div class="mt-7 grid grid-cols-2 gap-3"><div class="rounded-2xl border border-accent/10 bg-background/35 p-4"><div class="text-3xl font-heading font-bold text-[#D4AF37]">2698</div><div class="mt-1 text-xs text-subtext">19 × 142</div></div><div class="rounded-2xl border border-accent/10 bg-background/35 p-4"><div class="text-3xl font-heading font-bold text-[#D4AF37]">118123</div><div class="mt-1 text-xs text-subtext">19 × 6217</div></div></div>
          </article>
          <article class="rounded-[2rem] border border-accent/15 bg-accent/[0.035] p-7 md:p-9">
            <p class="text-xs font-bold uppercase tracking-[0.35em] text-accent">57 + 57 = 114</p><h3 class="mt-3 text-3xl font-heading font-bold text-maintext">{copy.qTitle}</h3><p class="mt-5 leading-8 text-subtext">{copy.qText}</p>
            <div class="mt-7 grid grid-cols-3 gap-3 text-center"><div class="rounded-2xl border border-accent/10 bg-background/35 p-4"><div class="text-2xl font-heading font-bold text-[#D4AF37]">57</div><div class="mt-1 text-[11px] text-subtext">Q · 42</div></div><div class="rounded-2xl border border-accent/10 bg-background/35 p-4"><div class="text-2xl font-heading font-bold text-[#D4AF37]">57</div><div class="mt-1 text-[11px] text-subtext">Q · 50</div></div><div class="rounded-2xl border border-accent/10 bg-background/35 p-4"><div class="text-2xl font-heading font-bold text-[#D4AF37]">114</div><div class="mt-1 text-[11px] text-subtext">19 × 6</div></div></div>
          </article>
