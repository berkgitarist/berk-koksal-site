---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/nav.astro";
import { Icon } from "astro-icon/components";
import albums from "../../data/albums.json";
import {
  helllManifesto,
  helllTaglines,
  helllTracks,
  nineteenArchitecture,
  quranicSourceMap,
} from "../../data/helll";

export async function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const isHelll = album.slug === "helll";
const spotifyPlaceholder =
  "spotifyPlaceholder" in album && album.spotifyPlaceholder === true;

const currentIndex = albums.findIndex((item) => item.slug === album.slug);
const previous = albums[currentIndex - 1] ?? albums[albums.length - 1];
const next = albums[currentIndex + 1] ?? albums[0];

const genreItems = album.genre?.split("/").map((item) => item.trim()) ?? [];

const credits = [
  "Composition",
  "Lyrics",
  "Arrangement",
  "Production",
  "Vocals",
  "Guitars",
  "Orchestration",
  "Choirs",
  "Programming",
  "Sound Design",
  "Mix",
  "Mastering",
  "Artwork",
  "Concept",
];

const features = genreItems.slice(0, 4);

const spotifyEmbedSource = album.spotifyEmbed || album.spotify;
const spotifyAlbumId = spotifyEmbedSource
  ?.split("/album/")
  ?.at(1)
  ?.split("?")
  ?.at(0)
  ?.split("/")
  ?.at(0);

const spotifyEmbedUrl = spotifyAlbumId
  ? `https://open.spotify.com/embed/album/${spotifyAlbumId}?utm_source=generator`
  : null;
---

<Layout
  title={`${album.title} | Berk KÖKSAL`}
  description={album.description}
  canonical={`/albums/${album.slug}`}
  ogImage={album.cover}
  ogType="music.album"
  twitterCard="summary_large_image"
  pageClass={isHelll ? "helll-theme" : ""}
  disableAmbient={isHelll}
>
  <Nav />

  {isHelll && (
    <>
      <!-- HELLL HERO -->
      <section class="relative overflow-hidden pb-8 pt-28 md:pt-32">
        <div class="absolute inset-0 -z-30 bg-black"></div>
        <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_50%_18%,rgba(104,0,0,0.12),transparent_34%),linear-gradient(to_bottom,#000_0%,#030101_58%,#000_100%)]"></div>

        <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-3 md:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <button
            type="button"
            class="album-cover-button group relative"
            aria-label={`Open ${album.title} cover`}
          >
            <div class="absolute -inset-8 rounded-full bg-[#730000]/10 blur-3xl transition-opacity duration-700 group-hover:bg-[#920000]/15"></div>
            <img
              src={album.cover}
              alt={album.title}
              class="relative mx-auto w-full max-w-xl rounded-[2rem] border border-white/10 bg-black shadow-[0_0_100px_rgba(120,0,0,0.14)] transition-transform duration-700 group-hover:scale-[1.018]"
            />
          </button>

          <div class="text-center lg:text-left">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.48em] text-[#b74a4a]">
              QURANIC CONCEPTS • HELL • 2026
            </p>

            <h1 class="text-7xl font-heading font-bold leading-none text-white sm:text-8xl md:text-9xl">
              HELLL
            </h1>

            <p class="mt-5 text-sm font-bold uppercase tracking-[0.35em] text-white/40">
              19 TRACKS • ONE DESCENT • ONE FINAL REMINDER
            </p>

            <h2 class="mt-9 text-2xl font-heading font-bold uppercase leading-9 text-white md:text-3xl">
              {helllTaglines[0]}
            </h2>

            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/58 lg:mx-0">
              {album.description}
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start">
              <span class="rounded-full border border-[#8f1c1c]/45 bg-[#7f1212]/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-[#d16c6c]">
                A Magnificent Disturbance
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">XIX</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">19 × 19</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">NINETEEN • 19:19</span>
            </div>

            <div class="mt-9 flex flex-wrap justify-center gap-4 lg:justify-start">
              <!-- TODO: Replace HELLL's temporary Spotify URL and set spotifyPlaceholder to false after release. -->
              <a
                href={album.spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 rounded-full border border-[#1DB954]/30 bg-[#1DB954]/10 px-7 py-3 font-bold text-white transition hover:bg-[#1DB954]/20"
              >
                <Icon name="mdi:spotify" class="h-5 w-5 text-[#1DB954]" />
                Spotify
              </a>

              <a
                href="/quranic-concepts/"
                class="inline-flex items-center gap-3 rounded-full border border-[#8f1c1c]/45 bg-[#7f1212]/10 px-7 py-3 font-bold text-white transition hover:bg-[#7f1212]/20"
              >
                QURANIC CONCEPTS
              </a>
            </div>
          </div>
        </div>
      </section>

      {spotifyEmbedUrl && (
        <div class="max-w-6xl mx-auto px-4 mt-6 mb-16 md:mt-8 md:mb-24">
          <div class="rounded-[2rem] border border-[#1DB954]/25 bg-[#1DB954]/5 p-4 md:p-5 shadow-[0_0_60px_rgba(29,185,84,0.08)]">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="mdi:spotify" class="w-5 h-5 text-[#1DB954]" />
              <p class="text-[#1DB954] text-xs uppercase tracking-[0.35em] font-bold">
                Official Spotify Stream
              </p>
            </div>

            <div class="overflow-hidden rounded-[1.25rem] border border-[#1DB954]/20 bg-background/40">
              <iframe
                src={spotifyEmbedUrl}
                width="100%"
                height="492"
                frameborder="0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                class="block h-[352px] sm:h-[420px] lg:h-[492px]"
              ></iframe>
            </div>
          </div>
        </div>
      )}

      <div class="mx-auto max-w-6xl space-y-20 pb-28 md:space-y-28">
        <!-- OPENING -->
        <section class="rounded-[2rem] border border-white/10 bg-white/[0.018] p-7 md:p-14">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">I · Before the First Lyric</p>
          <h2 class="max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
            First the heart stops. Then the voices begin.
          </h2>

          <div class="mt-10 grid grid-cols-1 gap-7 lg:grid-cols-[0.8fr_1.2fr]">
            <div class="rounded-2xl border border-[#8f1c1c]/35 bg-black p-7">
              <div class="space-y-3 font-mono text-xl font-bold uppercase tracking-[0.18em] text-white/80 md:text-2xl">
                <p>HEARTBEAT.</p>
                <p>HOSPITAL MONITOR.</p>
                <p>FLATLINE.</p>
                <p class="text-[#c24f4f]">DEATH.</p>
              </div>
            </div>

            <div class="space-y-5 text-lg leading-8 text-white/58">
              <p>
                HELLL begins before the first lyric. A heartbeat and hospital monitor establish the last seconds of ordinary life. The pulse weakens. The monitor becomes a continuous tone. The person dies.
              </p>
              <p>
                Only after that transition do the choirs, fire and voices of HELLL enter. Death is not used as the final scene of the album. It is the threshold through which the album begins.
              </p>
              <p class="font-heading text-2xl font-bold leading-9 text-white">
                HELLL begins with death. The warning is for the living.
              </p>
            </div>
          </div>
        </section>

        <!-- ABOUT -->
        <section class="grid grid-cols-1 gap-10 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">II</p>
            <h2 class="text-4xl font-heading font-bold text-white md:text-5xl">
              Not a depiction of Hell. A warning made audible.
            </h2>
          </div>

          <div class="space-y-6 text-lg leading-8 text-white/58">
            <p>
              HELLL is the first album within Berk Köksal's QURANIC CONCEPTS series. Its conceptual architecture is built from Quranic scenes and recurring images of judgment, punishment, regret, thirst, hunger, confinement, testimony, responsibility and permanence.
            </p>
            <p>
              The project does not treat the Quran as aesthetic decoration. Direct source references are identified as Quranic source; connective dialogue, dramatic framing and sound design remain artistic interpretation.
            </p>
            <p class="font-heading text-2xl font-bold uppercase leading-9 text-white">
              {helllTaglines[2]}
            </p>
          </div>
        </section>

        <!-- MANIFESTO -->
        <section class="rounded-[2rem] border border-[#8f1c1c]/35 bg-[#5b0909]/[0.06] p-7 md:p-14">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">III · Manifesto</p>
          <h2 class="max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
            THE WARNING MUST BE HEARD.
          </h2>

          <div class="mt-10 grid grid-cols-1 gap-6 text-lg leading-8 text-white/58 lg:grid-cols-2">
            {helllManifesto.map((paragraph, index) => (
              <p class={index === helllManifesto.length - 1 ? "lg:col-span-2" : ""}>{paragraph}</p>
            ))}
          </div>

          <blockquote class="mt-12 border-l-2 border-[#a62d2d] pl-6 font-heading text-2xl font-bold italic leading-9 text-white md:text-3xl">
            “An album so harrowing that even the Devil would listen in tears.”
          </blockquote>
        </section>

        <!-- MUSICAL IDENTITY -->
        <section>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">IV · Musical Identity</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            A sacred warning expressed through extreme sound.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            HELLL moves through progressive metal, symphonic extreme metal, funeral doom, industrial textures, thrash, neoclassical forms, sacred and damned choirs, cinematic sound design and silence. The genres change because the scene changes. The warning does not.
          </p>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {[
              'Qur\'anic Concept Metal',
              'Progressive Metal',
              'Symphonic / Extreme Metal',
              'Sacred & Damned Choirs',
              'Cinematic Sound Design',
              'Baroque & Neoclassical Forms',
              'Funeral Doom',
              'Industrial Metal',
            ].map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-5 font-heading font-bold text-white/75">
                {item}
              </div>
            ))}
          </div>
        </section>

        <!-- 19 TRACK DESCENT -->
        <section>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">V · The 19-Track Descent</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            Nineteen stages. One irreversible movement.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            Each track isolates a different Quranic image or recurring idea. The cards below show the conceptual role of each song and the verses used as its source map.
          </p>

          <div class="space-y-4">
            {helllTracks.map((track) => (
              <article class={`rounded-2xl border p-6 md:p-7 ${track.no === '19' ? 'border-[#9d2929]/60 bg-[#6d0d0d]/10' : 'border-white/10 bg-white/[0.018]'}`}>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-[72px_1fr_auto] md:items-start">
                  <div class="font-mono text-2xl font-bold text-[#9e3232]">{track.no}</div>
                  <div>
                    <h3 class="text-2xl font-heading font-bold text-white md:text-3xl">{track.title}</h3>
                    <p class="mt-2 font-heading font-bold text-white/75">{track.hook}</p>
                    <p class="mt-4 max-w-4xl leading-7 text-white/50">{track.concept}</p>
                  </div>
                  <div class="flex flex-wrap gap-2 md:max-w-[260px] md:justify-end">
                    {track.references.map((reference) => (
                      <span class="rounded-full border border-[#8f1c1c]/35 bg-[#7f1212]/10 px-3 py-1.5 text-xs font-bold text-[#d16c6c]">
                        {reference}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- QURAN SOURCE MAP -->
        <section>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">VI · Quranic Source Map</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            The verses behind the descent.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            This map lists the Quranic passages used to build HELLL and identifies the role each passage plays in the album. The wording below is explanatory summary, not a substitute for the source text.
          </p>

          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            {quranicSourceMap.map((item) => (
              <details class="group rounded-2xl border border-white/10 bg-white/[0.018] p-6 open:border-[#8f1c1c]/40 open:bg-[#650c0c]/[0.06]">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-heading font-bold text-white">
                  <span>{item.reference}</span>
                  <span class="text-[#a53b3b] transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-5 leading-7 text-white/52">{item.idea}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.tracks.map((track) => (
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs uppercase tracking-wider text-white/50">{track}</span>
                  ))}
                </div>
              </details>
            ))}
          </div>

          <a
            href="https://qurantft.com"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-[#d16c6c] transition hover:text-white"
          >
            Read the Quran source text — Quran: The Final Testament <span aria-hidden="true">↗</span>
          </a>
        </section>

        <!-- NINETEEN -->
        <section class="relative overflow-hidden rounded-[2rem] border border-[#9d2929]/55 bg-black p-7 shadow-[0_0_100px_rgba(120,0,0,0.10)] md:p-14">
          <div class="pointer-events-none absolute -right-20 -top-20 text-[16rem] font-heading font-bold leading-none text-white/[0.018] md:text-[24rem]">
            XIX
          </div>

          <div class="relative z-10">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">VII · The Final Architecture</p>
            <h2 class="text-5xl font-heading font-bold leading-none text-white md:text-8xl">
              19 — NINETEEN
            </h2>
            <p class="mt-7 max-w-4xl text-xl leading-9 text-white/65">
              {nineteenArchitecture.lead}
            </p>

            <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
              {nineteenArchitecture.pillars.map((pillar) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-5 text-center font-heading font-bold text-white/75">
                  {pillar}
                </div>
              ))}
            </div>

            <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
              <div class="rounded-[2rem] border border-[#8f1c1c]/40 bg-[#6d0d0d]/10 p-8 md:p-10">
                <p class="text-xs font-bold uppercase tracking-[0.35em] text-[#b74a4a]">Quran 74:30</p>
                <p class="mt-5 text-4xl font-heading font-bold leading-tight text-white md:text-5xl">
                  {nineteenArchitecture.verse30}
                </p>
              </div>

              <div class="rounded-[2rem] border border-white/10 bg-white/[0.025] p-8 md:p-10">
                <p class="text-xs font-bold uppercase tracking-[0.35em] text-white/40">Quran 74:31</p>
                <p class="mt-5 text-4xl font-heading font-bold leading-tight text-white md:text-5xl">
                  {nineteenArchitecture.verse31}
                </p>
              </div>
            </div>

            <div class="mt-12 space-y-6 text-lg leading-8 text-white/58">
              <p>
                The number is embedded in the track order, the composition, the title, the duration and the artwork. Within Berk Köksal's own Quran research framework, this 19 × 19 architecture deliberately engages with the Quran's 19-based mathematical system.
              </p>
              <p>
                The final track moves through nineteen independently composed musical worlds. One composition dissolves into the next rather than ending conventionally, allowing the final work to behave as one continuous structure rather than nineteen separate songs placed side by side.
              </p>
            </div>

            <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
              {nineteenArchitecture.finalMovements.map((movement) => (
                <article class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                  <p class="font-mono text-sm font-bold text-[#a83c3c]">MOVEMENT {movement.no}</p>
                  <h3 class="mt-3 text-2xl font-heading font-bold text-white">{movement.title}</h3>
                  <p class="mt-4 leading-7 text-white/50">{movement.text}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- HIDDEN COVER -->
        <section class="grid grid-cols-1 gap-10 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">VIII · XIX / Hidden Cover</p>
            <h2 class="text-4xl font-heading font-bold leading-tight text-white md:text-5xl">
              The number is visible. The message is not.
            </h2>
          </div>

          <div class="space-y-6 text-lg leading-8 text-white/58">
            <p>
              The XIX on the HELLL artwork is the Roman numeral for 19, but it also functions as the first key to the visual structure. Another layer points toward the Quranic concepts of Sijjin and Illiyyin.
            </p>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#b74a4a]">Quran 83:7–9</p>
                <h3 class="mt-3 text-3xl font-heading font-bold text-white">SIJJIN</h3>
                <p class="mt-3 text-sm leading-6 text-white/45">Associated with the record of the wicked.</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/40">Quran 83:18–21</p>
                <h3 class="mt-3 text-3xl font-heading font-bold text-white">ILLIYYIN</h3>
                <p class="mt-3 text-sm leading-6 text-white/45">Associated with the record of the righteous.</p>
              </div>
            </div>
            <p class="font-heading text-2xl font-bold uppercase leading-9 text-white">
              XIX is the first key. The rest must be discovered.
            </p>
          </div>
        </section>

        <!-- PRODUCTION -->
        <section>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">IX · Production</p>
          <h2 class="mb-10 text-4xl font-heading font-bold text-white md:text-5xl">
            One-Man Production Vision
          </h2>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {credits.map((credit) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
                <p class="text-[11px] uppercase tracking-widest text-[#a83c3c]">{credit}</p>
                <p class="mt-2 font-bold text-white">Berk KÖKSAL</p>
              </div>
            ))}
          </div>
        </section>

        <!-- FINAL -->
        <section class="rounded-[2rem] border border-[#8f1c1c]/40 bg-black px-6 py-16 text-center md:px-12 md:py-24">
          <p class="text-xs font-bold uppercase tracking-[0.5em] text-[#b74a4a]">The Final Reminder</p>
          <p class="mx-auto mt-8 max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
            OVER IT IS NINETEEN.
          </p>
          <p class="mt-4 text-sm text-white/35">Quran 74:30</p>

          <div class="mx-auto my-10 h-px max-w-xl bg-gradient-to-r from-transparent via-[#8f1c1c]/60 to-transparent"></div>

          <p class="mx-auto max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
            THIS IS A REMINDER FOR THE PEOPLE.
          </p>
          <p class="mt-4 text-sm text-white/35">Quran 74:31</p>

          <p class="mx-auto mt-14 max-w-4xl text-2xl font-heading font-bold uppercase leading-10 text-white/80 md:text-3xl">
            HELLL BEGINS WITH DEATH.<br />THE WARNING IS FOR THE LIVING.
          </p>
        </section>

        <!-- NAVIGATION -->
        <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <a
            href="/quranic-concepts/"
            class="group rounded-[2rem] border border-[#8f1c1c]/30 bg-[#7f1212]/10 p-8 transition-all hover:border-[#b33a3a]/55"
          >
            <p class="mb-3 text-xs uppercase tracking-widest text-[#b74a4a]">Parent Series</p>
            <h3 class="text-2xl font-heading font-bold text-white transition-colors group-hover:text-[#d16c6c]">QURANIC CONCEPTS</h3>
          </a>

          <a
            href={`/albums/${next.slug}`}
            class="group rounded-[2rem] border border-white/10 bg-white/[0.02] p-8 text-right transition-all hover:border-white/20"
          >
            <p class="mb-3 text-xs uppercase tracking-widest text-white/35">Next Album in Discography</p>
            <h3 class="text-2xl font-heading font-bold text-white transition-colors group-hover:text-white/70">{next.title}</h3>
          </a>
        </section>
      </div>

      <div id="cover-lightbox" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/95 p-6">
        <button
          id="close-lightbox"
          class="absolute right-6 top-6 text-white/70 transition hover:text-white"
          aria-label="Close cover"
        >
          <Icon name="mdi:close" class="h-9 w-9" />
        </button>

        <img
          src={album.cover}
          alt={album.title}
          class="max-h-[90vh] max-w-[90vw] rounded-3xl border border-white/10 bg-black shadow-[0_0_100px_rgba(120,0,0,0.18)]"
        />
      </div>
    </>
  )}

  {!isHelll && (
    <>
      <section class="relative min-h-screen pt-32 pb-24 overflow-hidden">
        <div class="absolute inset-0 -z-30">
          <img src={album.cover} alt="" class="w-full h-full object-cover blur-3xl scale-125 opacity-30" />
        </div>

        <div class="absolute inset-0 -z-20 bg-gradient-to-b from-background/70 via-background/95 to-background"></div>
        <div class="absolute left-1/2 top-1/2 -z-10 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#D4AF37]/10 blur-3xl"></div>

        <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-14 items-center">
          <button type="button" class="album-cover-button relative group" aria-label={`Open ${album.title} cover`}>
            <div class="absolute -inset-8 rounded-full bg-[#D4AF37]/20 blur-3xl opacity-70 group-hover:opacity-100 transition-opacity duration-700"></div>
            <img src={album.cover} alt={album.title} class="relative w-full max-w-xl mx-auto rounded-[2rem] border border-[#D4AF37]/30 shadow-[0_0_90px_rgba(212,175,55,0.25)] transition-transform duration-700 group-hover:scale-[1.025]" />
          </button>

          <div class="space-y-7 text-center lg:text-left">
            <p class="text-[#D4AF37] uppercase tracking-[0.45em] text-xs font-bold">Album • {album.year}</p>
            <h1 class="text-5xl md:text-7xl font-heading font-bold text-maintext leading-tight">{album.title}</h1>
            <p class="text-xl text-accent leading-8">{album.tracksCount} Tracks • {album.duration}</p>
            <p class="text-subtext text-lg leading-8 max-w-2xl">{album.description}</p>

            <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
              {genreItems.map((item) => (
                <span class="rounded-full border border-accent/20 bg-accent/5 px-4 py-2 text-xs text-accent">{item}</span>
              ))}
            </div>

            <div class="flex flex-wrap gap-4 justify-center lg:justify-start pt-4">
              <a href={album.spotify} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-full border border-[#D4AF37]/40 bg-[#D4AF37]/10 px-7 py-3 text-maintext hover:bg-[#D4AF37]/20 hover:shadow-[0_0_35px_rgba(212,175,55,0.25)] hover:scale-105 transition-all">
                <Icon name="mdi:spotify" class="w-5 h-5" />
                Listen on Spotify
              </a>

              <a href="/#projects" class="inline-flex items-center gap-3 rounded-full border border-accent/30 bg-accent/10 px-7 py-3 text-maintext hover:bg-accent/20 hover:scale-105 transition-all">Back to Discography</a>
            </div>
          </div>
        </div>

        {spotifyEmbedUrl && (
          <div class="max-w-6xl mx-auto px-4 mt-16">
            <div class="rounded-[2rem] border border-[#1DB954]/25 bg-[#1DB954]/5 p-4 md:p-5 shadow-[0_0_60px_rgba(29,185,84,0.08)]">
              <div class="flex items-center gap-3 mb-4">
                <Icon name="mdi:spotify" class="w-5 h-5 text-[#1DB954]" />
                <p class="text-[#1DB954] text-xs uppercase tracking-[0.35em] font-bold">Official Spotify Stream</p>
              </div>
              <div class="overflow-hidden rounded-[1.25rem] border border-[#1DB954]/20 bg-background/40">
                <iframe src={spotifyEmbedUrl} width="100%" height="492" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" class="block h-[352px] sm:h-[420px] lg:h-[492px]"></iframe>
              </div>
            </div>
          </div>
        )}
      </section>

      <section class="section-container max-w-6xl mx-auto space-y-28">
        <section class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.25fr] gap-12">
          <div>
            <p class="text-accent text-xs uppercase tracking-[0.45em] font-bold mb-4">I</p>
            <h2 class="text-4xl md:text-5xl font-heading font-bold text-maintext">About the Album</h2>
          </div>

          <div class="space-y-6 text-subtext text-lg leading-8">
            <p class="whitespace-pre-line">{album.story}</p>
            <p>This album is part of Berk KÖKSAL's Neo-Sacred Zikr universe, where music is used as a way of remembrance, reflection and glorification of GOD.</p>
            <p>Its sound world brings together sacred atmosphere, modern production and spiritual intention while keeping the focus on zikr, contemplation and inner awareness.</p>
          </div>
        </section>

        <section class="rounded-[2rem] border border-accent/20 bg-accent/5 p-10 md:p-14">
          <p class="text-accent text-xs uppercase tracking-[0.45em] font-bold mb-5">II · Musical Identity</p>
          <h2 class="text-4xl md:text-6xl font-heading font-bold text-maintext mb-10">A sacred sound language shaped by remembrance.</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {features.map((feature) => (
              <div class="rounded-2xl border border-accent/20 bg-background/40 p-6">
                <p class="text-[#D4AF37] text-xs uppercase tracking-[0.3em] font-bold mb-3">Neo-Sacred Element</p>
                <h3 class="text-2xl font-heading font-bold text-maintext">{feature}</h3>
              </div>
            ))}
          </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-12">
          <div>
            <p class="text-accent text-xs uppercase tracking-[0.45em] font-bold mb-5">III · Track List</p>
            <h2 class="text-4xl md:text-5xl font-heading font-bold text-maintext">{album.tracksCount} Sacred Works</h2>
          </div>

          <ol class="rounded-[2rem] border border-[#D4AF37]/20 bg-[#D4AF37]/5 p-6 md:p-8 space-y-1">
            {album.tracks.map((track, index) => (
              <li class="group flex items-center gap-4 rounded-xl border-b border-white/5 px-2 py-4 text-subtext hover:bg-white/5 transition-colors">
                <span class="text-[#D4AF37] font-mono text-sm w-8">{String(index + 1).padStart(2, "0")}</span>
                <Icon name="mdi:play-circle-outline" class="w-5 h-5 text-[#D4AF37]/50 group-hover:text-[#D4AF37] transition-colors" />
                <span class="group-hover:text-maintext transition-colors">{track}</span>
              </li>
            ))}
          </ol>
        </section>

        <section>
          <p class="text-accent text-xs uppercase tracking-[0.45em] font-bold mb-5">V · Production</p>
          <h2 class="text-4xl md:text-5xl font-heading font-bold text-maintext mb-10">One-Man Production Vision</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {credits.map((credit) => (
              <div class="rounded-2xl border border-accent/20 bg-accent/5 p-5">
                <p class="text-[#D4AF37] text-xs uppercase tracking-widest mb-2">{credit}</p>
                <p class="text-maintext font-bold">Berk KÖKSAL</p>
              </div>
            ))}
          </div>
        </section>

        <section class="rounded-[2rem] border border-[#D4AF37]/20 bg-[#D4AF37]/5 p-10 md:p-14 text-center">
          <p class="text-[#D4AF37] text-xs uppercase tracking-[0.45em] font-bold mb-8">The Final Testament</p>
          <blockquote class="max-w-4xl mx-auto">
            <p class="text-3xl md:text-5xl font-heading font-bold text-maintext leading-tight italic whitespace-pre-line">{album.verse.text}</p>
            <p class="mt-8 text-subtext text-sm whitespace-pre-line">{album.verse.reference} — {album.verse.source}</p>
          </blockquote>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href={`/albums/${previous.slug}`} class="group rounded-[2rem] border border-accent/10 bg-accent/5 p-8 hover:border-[#D4AF37]/30 transition-all">
            <p class="text-accent text-xs uppercase tracking-widest mb-3">Previous Album</p>
            <h3 class="text-2xl font-heading font-bold group-hover:text-[#D4AF37] transition-colors">{previous.title}</h3>
          </a>

          <a href={`/albums/${next.slug}`} class="group rounded-[2rem] border border-accent/10 bg-accent/5 p-8 text-right hover:border-[#D4AF37]/30 transition-all">
            <p class="text-accent text-xs uppercase tracking-widest mb-3">Next Album</p>
            <h3 class="text-2xl font-heading font-bold group-hover:text-[#D4AF37] transition-colors">{next.title}</h3>
          </a>
        </section>
      </section>

      <div id="cover-lightbox" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/90 p-6">
        <button id="close-lightbox" class="absolute top-6 right-6 text-maintext hover:text-[#D4AF37]" aria-label="Close cover">
          <Icon name="mdi:close" class="w-9 h-9" />
        </button>
        <img src={album.cover} alt={album.title} class="max-h-[90vh] max-w-[90vw] rounded-3xl border border-[#D4AF37]/30 shadow-[0_0_100px_rgba(212,175,55,0.25)]" />
      </div>
    </>
  )}

  <script>
    const openButton = document.querySelector(".album-cover-button");
    const lightbox = document.querySelector("#cover-lightbox");
    const closeButton = document.querySelector("#close-lightbox");

    openButton?.addEventListener("click", () => {
      lightbox?.classList.remove("hidden");
      lightbox?.classList.add("flex");
    });

    const closeLightbox = () => {
      lightbox?.classList.add("hidden");
      lightbox?.classList.remove("flex");
    };

    closeButton?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeLightbox();
    });
  </script>
</Layout>
