---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/nav.astro";
import { Icon } from "astro-icon/components";
import albums from "../../data/albums.json";
import {
  helllManifesto,
  helllTaglines,
  helllTracks,
  nineteenArchitecture,
  quranicSourceMap,
} from "../../data/helll";

export async function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const isHelll = album.slug === "helll";

const currentIndex = albums.findIndex((item) => item.slug === album.slug);
const previous = albums[currentIndex - 1] ?? albums[albums.length - 1];
const next = albums[currentIndex + 1] ?? albums[0];

const genreItems = album.genre?.split("/").map((item) => item.trim()) ?? [];

const credits = [
  "Composition",
  "Lyrics",
  "Arrangement",
  "Production",
  "Vocals",
  "Guitars",
  "Orchestration",
  "Choirs",
  "Programming",
  "Sound Design",
  "Mix",
  "Mastering",
  "Artwork",
  "Concept",
];

const features = genreItems.slice(0, 4);

const spotifyEmbedSource = album.spotifyEmbed || album.spotify;
const spotifyAlbumId = spotifyEmbedSource
  ?.split("/album/")
  ?.at(1)
  ?.split("?")
  ?.at(0)
  ?.split("/")
  ?.at(0);

const spotifyEmbedUrl = spotifyAlbumId
  ? `https://open.spotify.com/embed/album/${spotifyAlbumId}?utm_source=generator`
  : null;


const albumVisuals = {
  "zikr-symphonic-metal": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 MOVEMENTS",
    variant: "monumental",
    accent: "#D6B56B",
    symbolOpacity: "0.105",
  },
  "zikr-jazz": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "jazz",
    accent: "#C9A77C",
    symbolOpacity: "0.09",
  },
  "zikr-i-batin": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "inner",
    accent: "#9B8CC7",
    symbolOpacity: "0.08",
  },
  "zikr-rap": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "rhythm",
    accent: "#D9B64D",
    symbolOpacity: "0.115",
  },
  "one-god-one-love": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "bright",
    accent: "#E3C98E",
    symbolOpacity: "0.085",
  },
  "classical-chorus": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "cathedral",
    accent: "#D4AF37",
    symbolOpacity: "0.10",
  },
  "zikr-rock": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "rock",
    accent: "#C86A4C",
    symbolOpacity: "0.11",
  },
  "zikr-nur": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "XIX • 19 TRACKS",
    variant: "light",
    accent: "#E4DFA8",
    symbolOpacity: "0.085",
  },
  "zikr-huu": {
    symbol: "HÛ",
    secondarySymbol: "HÛ",
    structureLabel: "HÛ • 9 TRACKS",
    variant: "breath",
    accent: "#B9C9D8",
    symbolOpacity: "0.075",
  },
  "zikr-symphony": {
    symbol: "XIX",
    secondarySymbol: "XIX × XIX",
    structureLabel: "XIX × XIX • 19 + 19",
    variant: "symphony",
    accent: "#D4AF37",
    symbolOpacity: "0.11",
  },
  "tanrinin-hediyesi": {
    symbol: "XIX",
    secondarySymbol: "XIX",
    structureLabel: "III • 3 TRACKS",
    variant: "origin",
    accent: "#CFAD78",
    symbolOpacity: "0.075",
  },
} as const;

const defaultAlbumVisual = {
  symbol: album.tracksCount === "19" ? "XIX" : album.tracksCount,
  secondarySymbol: album.tracksCount === "19" ? "XIX" : album.tracksCount,
  structureLabel: `${album.tracksCount} TRACKS`,
  variant: "default",
  accent: "#D4AF37",
  symbolOpacity: "0.09",
};

const albumVisual =
  albumVisuals[album.slug as keyof typeof albumVisuals] ?? defaultAlbumVisual;
---

<Layout
  title={`${album.title} | Berk KÖKSAL`}
  description={album.description}
  canonical={`/albums/${album.slug}/`}
  ogImage={album.cover}
  ogType="music.album"
  twitterCard="summary_large_image"
  pageClass={isHelll ? "helll-theme" : ""}
  disableAmbient={isHelll}
>
  <Nav />

  {isHelll && (
    <>
      <!-- HELLL HERO -->
      <section class="relative overflow-hidden pb-8 pt-28 md:pt-32">
        <div class="absolute inset-0 -z-30 bg-black"></div>
        <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_50%_18%,rgba(104,0,0,0.12),transparent_34%),linear-gradient(to_bottom,#000_0%,#030101_58%,#000_100%)]"></div>

        <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-3 md:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <button
            type="button"
            class="album-cover-button group relative"
            aria-label={`Open ${album.title} cover`}
          >
            <div class="absolute -inset-8 rounded-full bg-[#730000]/10 blur-3xl transition-opacity duration-700 group-hover:bg-[#920000]/15"></div>
            <img
              src={album.cover}
              alt={album.title}
              class="relative mx-auto w-full max-w-xl rounded-[2rem] border border-white/10 bg-black shadow-[0_0_100px_rgba(120,0,0,0.14)] transition-transform duration-700 group-hover:scale-[1.018]"
            />
          </button>

          <div class="text-center lg:text-left">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.48em] text-[#b74a4a]">
              QURANIC CONCEPTS • HELL • 2026
            </p>

            <h1 class="text-7xl font-heading font-bold leading-none text-white sm:text-8xl md:text-9xl">
              HELLL
            </h1>

            <p class="mt-5 text-sm font-bold uppercase tracking-[0.35em] text-white/40">
              19 TRACKS • ONE DESCENT • ONE FINAL REMINDER
            </p>

            <h2 class="mt-9 text-2xl font-heading font-bold uppercase leading-9 text-white md:text-3xl">
              {helllTaglines[0]}
            </h2>

            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/58 lg:mx-0">
              {album.description}
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start">
              <span class="rounded-full border border-[#8f1c1c]/45 bg-[#7f1212]/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-[#d16c6c]">
                A Magnificent Disturbance
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">XIX</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">19 × 19</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-white/60">NINETEEN • 19:19</span>
            </div>

            <div class="mt-9 flex flex-wrap justify-center gap-4 lg:justify-start">
              <!-- TODO: Replace HELLL's temporary Spotify URL after release. -->
              <a
                href={album.spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 rounded-full border border-[#1DB954]/30 bg-[#1DB954]/10 px-7 py-3 font-bold text-white transition hover:bg-[#1DB954]/20"
              >
                <Icon name="mdi:spotify" class="h-5 w-5 text-[#1DB954]" />
                Spotify
              </a>

              <a
                href="/quranic-concepts/"
                class="inline-flex items-center gap-3 rounded-full border border-[#8f1c1c]/45 bg-[#7f1212]/10 px-7 py-3 font-bold text-white transition hover:bg-[#7f1212]/20"
              >
                QURANIC CONCEPTS
              </a>
            </div>
          </div>
        </div>
      </section>

      {spotifyEmbedUrl && (
        <div class="max-w-6xl mx-auto px-4 mt-6 mb-16 md:mt-8 md:mb-24">
          <div class="rounded-[2rem] border border-[#1DB954]/25 bg-[#1DB954]/5 p-4 md:p-5 shadow-[0_0_60px_rgba(29,185,84,0.08)]">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="mdi:spotify" class="w-5 h-5 text-[#1DB954]" />
              <p class="text-[#1DB954] text-xs uppercase tracking-[0.35em] font-bold">
                Official Spotify Stream
              </p>
            </div>

            <div class="overflow-hidden rounded-[1.25rem] border border-[#1DB954]/20 bg-background/40">
              <iframe
                src={spotifyEmbedUrl}
                width="100%"
                height="492"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                class="block border-0 h-[352px] sm:h-[420px] lg:h-[492px]"
              ></iframe>
            </div>
          </div>
        </div>
      )}

      <div class="mx-auto max-w-6xl space-y-20 pb-28 md:space-y-28">
        <!-- OPENING -->
        <section class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.018] p-7 md:p-14">
          <div
            class="pointer-events-none absolute -right-10 -top-10 select-none text-[16rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.055] md:-right-16 md:-top-16 md:text-[26rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">I · Before the First Lyric</p>
            <h2 class="max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
              First the heart stops. Then the voices begin.
            </h2>

            <div class="mt-10 grid grid-cols-1 gap-7 lg:grid-cols-[0.8fr_1.2fr]">
            <div class="rounded-2xl border border-[#8f1c1c]/35 bg-black p-7">
              <div class="space-y-3 font-mono text-xl font-bold uppercase tracking-[0.18em] text-white/80 md:text-2xl">
                <p>HEARTBEAT.</p>
                <p>HOSPITAL MONITOR.</p>
                <p>FLATLINE.</p>
                <p class="text-[#c24f4f]">DEATH.</p>
              </div>
            </div>

            <div class="space-y-5 text-lg leading-8 text-white/58">
              <p>
                HELLL begins before the first lyric. A heartbeat and hospital monitor establish the last seconds of ordinary life. The pulse weakens. The monitor becomes a continuous tone. The person dies.
              </p>
              <p>
                Only after that transition do the choirs, fire and voices of HELLL enter. Beneath them, two recurring presences are already at work: a solitary violinist who keeps playing through the catastrophe, and a buried choir that seems to rise from somewhere below the music itself. Death is not used as the final scene of the album. It is the threshold through which the album begins.
              </p>
              <p class="font-heading text-2xl font-bold leading-9 text-white">
                HELLL begins with death. The warning is for the living.
              </p>
            </div>
          </div>
          </div>
        </section>

        <!-- ABOUT -->
        <section class="relative grid grid-cols-1 gap-10 overflow-hidden lg:grid-cols-[0.75fr_1.25fr]">
          <div
            class="pointer-events-none absolute -right-10 -top-12 select-none text-[15rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.05] md:-right-14 md:-top-16 md:text-[24rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">II</p>
            <h2 class="text-4xl font-heading font-bold text-white md:text-5xl">
              Not a depiction of Hell. A warning made audible.
            </h2>
          </div>

          <div class="relative z-10 space-y-6 text-lg leading-8 text-white/58">
            <p>
              HELLL is the first album within Berk Köksal's QURANIC CONCEPTS series. Its conceptual architecture is built from Quranic scenes and recurring images of judgment, punishment, regret, thirst, hunger, confinement, testimony, responsibility and permanence.
            </p>
            <p>
              The project does not treat the Quran as aesthetic decoration. Direct source references are identified as Quranic source; connective dialogue, dramatic framing and sound design remain artistic interpretation.
            </p>
            <p class="font-heading text-2xl font-bold uppercase leading-9 text-white">
              {helllTaglines[2]}
            </p>
          </div>
        </section>

        <!-- MANIFESTO -->
        <section class="relative overflow-hidden rounded-[2rem] border border-[#8f1c1c]/35 bg-[#5b0909]/[0.06] p-7 md:p-14">
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none text-[16rem] font-heading font-bold leading-none tracking-[-0.06em] text-[#8f1c1c]/[0.12] md:text-[26rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">III · Manifesto</p>
          <h2 class="max-w-5xl text-4xl font-heading font-bold leading-tight text-white md:text-6xl">
            THE WARNING MUST BE HEARD.
          </h2>

          <div class="mt-10 grid grid-cols-1 gap-6 text-lg leading-8 text-white/58 lg:grid-cols-2">
            {helllManifesto.map((paragraph, index) => (
              <p class={index === helllManifesto.length - 1 ? "lg:col-span-2" : ""}>{paragraph}</p>
            ))}
          </div>

          <blockquote class="mt-12 border-l-2 border-[#a62d2d] pl-6 font-heading text-2xl font-bold italic leading-9 text-white md:text-3xl">
            “An album so harrowing that even the Devil would listen in tears.”
          </blockquote>
          </div>
        </section>

        <!-- MUSICAL IDENTITY -->
        <section class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-8 top-10 select-none text-[15rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.055] md:-right-14 md:text-[24rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">IV · Musical Identity</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            A sacred warning expressed through extreme sound.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            HELLL moves through progressive metal, symphonic extreme metal, funeral doom, industrial textures, thrash, neoclassical forms, sacred and damned choirs, cinematic sound design and silence. The genres change because the scene changes. The warning does not.
          </p>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {[
              'Qur\'anic Concept Metal',
              'Progressive Metal',
              'Symphonic / Extreme Metal',
              'Sacred & Damned Choirs',
              'Cinematic Sound Design',
              'Baroque & Neoclassical Forms',
              'Funeral Doom',
              'Industrial Metal',
            ].map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-5 font-heading font-bold text-white/75">
                {item}
              </div>
            ))}
          </div>

          <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
            <article class="rounded-[2rem] border border-[#8f1c1c]/35 bg-[#650c0c]/[0.06] p-7 md:p-9">
              <p class="text-xs font-bold uppercase tracking-[0.35em] text-[#b74a4a]">Recurring Figure · The Unmoved Violinist</p>
              <h3 class="mt-4 text-3xl font-heading font-bold leading-tight text-white md:text-4xl">
                He keeps playing while everything else collapses.
              </h3>
              <div class="mt-5 space-y-4 leading-7 text-white/52">
                <p>
                  Across all nineteen works, a solitary violinist remains in the background. He does not react to the violence around him; even if the world outside were collapsing, the bow continues. The performance is intentionally detached from the catastrophe, as though this musician belongs to the place rather than fears it.
                </p>
                <p>
                  The figure is a deliberate allusion to Niccolò Paganini and to the demonic mythology that formed around his virtuosity. In the 19th century — a historical detail that quietly mirrors HELLL's own architecture of nineteen — Paganini's seemingly superhuman playing fed widespread legends that he had made a pact with the Devil; one period account even described a listener claiming to have seen the Devil at his elbow, guiding his bow. HELLL does not present that legend as historical fact. It uses the image the legend left behind: a violinist who sounds as if he is playing from Hell itself, indifferent to the catastrophe surrounding him.
                </p>
              </div>
            </article>

            <article class="rounded-[2rem] border border-white/10 bg-white/[0.02] p-7 md:p-9">
              <p class="text-xs font-bold uppercase tracking-[0.35em] text-white/40">Recurring Layer · The Hell Choir</p>
              <h3 class="mt-4 text-3xl font-heading font-bold leading-tight text-white md:text-4xl">
                Beneath the choir, another choir is waiting.
              </h3>
              <div class="mt-5 space-y-4 leading-7 text-white/52">
                <p>
                  HELLL contains a second choral presence beneath its principal musical choirs: the Hell Choir. Its voices are deliberately mixed deep into the background, almost as a subterranean layer of sound — distant, obscured and seemingly rising from somewhere below the visible music.
                </p>
                <p>
                  This hidden choir is placed throughout all nineteen works as part of the album's environment rather than as a conventional foreground performance. Its purpose is to intensify the image of Hell itself: the songs do not merely describe the place; they are surrounded by voices that seem to come from within it.
                </p>
              </div>
            </article>
          </div>
          </div>
        </section>

        <!-- 19 TRACK DESCENT -->
        <section class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-6 top-4 select-none text-[17rem] font-heading font-bold leading-none tracking-[-0.06em] text-[#8f1c1c]/[0.12] md:-right-10 md:text-[26rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">V · The 19-Track Descent</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            Nineteen stages. One irreversible movement.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            Each track isolates a different Quranic image or recurring idea. The cards below show the conceptual role of each song and the verses used as its source map.
          </p>

          <div class="space-y-4">
            {helllTracks.map((track) => (
              <article class={`rounded-2xl border p-6 md:p-7 ${track.no === '19' ? 'border-[#9d2929]/60 bg-[#6d0d0d]/10' : 'border-white/10 bg-white/[0.018]'}`}>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-[72px_1fr_auto] md:items-start">
                  <div class="font-mono text-2xl font-bold text-[#9e3232]">{track.no}</div>
                  <div>
                    <h3 class="text-2xl font-heading font-bold text-white md:text-3xl">{track.title}</h3>
                    <p class="mt-2 font-heading font-bold text-white/75">{track.hook}</p>
                    <p class="mt-4 max-w-4xl leading-7 text-white/50">{track.concept}</p>
                  </div>
                  <div class="flex flex-wrap gap-2 md:max-w-[260px] md:justify-end">
                    {track.references.map((reference) => (
                      <span class="rounded-full border border-[#8f1c1c]/35 bg-[#7f1212]/10 px-3 py-1.5 text-xs font-bold text-[#d16c6c]">
                        {reference}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
          </div>
        </section>

        <!-- QURAN SOURCE MAP -->
        <section class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-8 top-2 select-none text-[15rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.055] md:-right-12 md:-top-4 md:text-[24rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">VI · Quranic Source Map</p>
          <h2 class="mb-6 text-4xl font-heading font-bold text-white md:text-6xl">
            The verses behind the descent.
          </h2>
          <p class="mb-10 max-w-4xl text-lg leading-8 text-white/55">
            This map lists the Quranic passages used to build HELLL and identifies the role each passage plays in the album. The wording below is explanatory summary, not a substitute for the source text.
          </p>

          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            {quranicSourceMap.map((item) => (
              <details class="group rounded-2xl border border-white/10 bg-white/[0.018] p-6 open:border-[#8f1c1c]/40 open:bg-[#650c0c]/[0.06]">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-heading font-bold text-white">
                  <span>{item.reference}</span>
                  <span class="text-[#a53b3b] transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-5 leading-7 text-white/52">{item.idea}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.tracks.map((track) => (
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs uppercase tracking-wider text-white/50">{track}</span>
                  ))}
                </div>
              </details>
            ))}
          </div>

          <a
            href="https://qurantft.com"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-[#d16c6c] transition hover:text-white"
          >
            Read the Quran source text — Quran: The Final Testament <span aria-hidden="true">↗</span>
          </a>
          </div>
        </section>

        <!-- NINETEEN -->
        <section class="relative overflow-hidden rounded-[2rem] border border-[#9d2929]/55 bg-black p-7 shadow-[0_0_100px_rgba(120,0,0,0.10)] md:p-14">
          <div
            class="pointer-events-none absolute -right-16 -top-16 select-none text-[17rem] font-heading font-bold leading-none tracking-[-0.06em] text-white/[0.05] md:text-[25rem]"
            aria-hidden="true"
          >
            XIX
          </div>

          <div class="relative z-10">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-[#b74a4a]">VII · The Final Architecture</p>
            <h2 class="text-5xl font-heading font-bold leading-none text-white md:text-8xl">
              19 — NINETEEN
            </h2>
            <p class="mt-7 max-w-4xl text-xl leading-9 text-white/65">
              {nineteenArchitecture.lead}
            </p>

            <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
              {nineteenArchitecture.pillars.map((pillar) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-5 text-center font-heading font-bold text-white/75">
                  {pillar}
                </div>
              ))}
            </div>

