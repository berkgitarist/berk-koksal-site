                <div class="project-label">{project.label}</div>

                <h3>{project.title}</h3>

                <p>{project.text}</p>

                <div class="project-links">

                  <a href={project.url} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>

                  <a href={project.live} target="_blank" rel="noreferrer">Live project <span aria-hidden="true">↗</span></a>

                </div>

