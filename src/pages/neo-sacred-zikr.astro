---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";

const principles = [
  "To glorify the ONE GOD",
  "To keep remembrance centered on GOD alone",
  "To express zikr through the sounds of the modern age",
  "To make the beautiful names and attributes of GOD heard through music",
  "To treat genres as tools rather than destinations",
  "To allow the listener to become a participant in remembrance",
];

const albums = [
  [
    "ZIKR SYMPHONIC METAL",
    "Neo-Sacred Zikr / Symphonic Metal / Progressive Metal / Neoclassical Metal",
    "A 19-movement concept album centered almost entirely on HÛ, with occasional Hay / Al-Hayy. Breath, female voice, sacred choir, symphonic orchestra, pipe organ, brass and progressive neoclassical metal become one continuous act of remembrance."
  ],
  [
    "ZIKR JAZZ",
    "Neo-Sacred Zikr / Spiritual Jazz / Modal Jazz / Sacred Music",
    "A 19-track sacred jazz journey shaped by extended harmony, modal color, warm acoustic instrumentation and a calmer, more intimate form of remembrance."
  ],
  [
    "Zikr-i Batın",
    "Neo-Sacred Zikr / Sacred Choral Music / Spiritual Ambient",
    "A 19-track inward journey centered on remembrance, divine names and inner reflection, ending with an experimental Huruf al-Muqatta'at composition."
  ],
  [
    "ZIKR RAP",
    "Neo-Sacred Zikr / Spiritual Rap / Sacred Hip-Hop",
    "A 19-track project that redirects the rhythmic language of rap toward remembrance and praise of GOD, beginning with Bismillahirrahmanirrahim."
  ],
  [
    "Neo-Sacred Zikr: One God One Love",
    "Neo-Sacred Zikr / Children's Choir / Sacred Music / Spiritual Contemporary",
    "A 19-track children's choir project created from the idea that monotheist children should also have a contemporary musical language through which they can remember and glorify GOD."
  ],
  [
    "Neo-Sacred Zikr: Classical Chorus",
    "Neo-Sacred Zikr / Sacred Choral Music / Classical / Neoclassical",
    "A 19-track classical and choral project shaped by large sacred choir textures, Köksal's lifelong relationship with Mozart and the dramatic language of Requiem and Kyrie-like writing."
  ],
  [
    "ZIKR ROCK",
    "Neo-Sacred Zikr / Sacred Rock / Progressive Rock / Neoclassical",
    "A 19-track return to Köksal's rock and lead-guitar roots. The album begins with Huu and grows progressively more rhythmic, distorted and energetic toward its final Subhanallah."
  ],
  [
    "Zikr Nur",
    "Neo-Sacred Zikr / Ambient Spiritual Music / Sacred Meditation",
    "A 19-track atmospheric work built around female voices, rain ambience, distant thunder, piano, ney and gentle rhythm — a musical image of divine light falling like rain."
  ],
  [
    "Zikr Huu",
    "Neo-Sacred Zikr / Spiritual Ambient / Sacred Meditation",
    "A nine-piece minimalist album using female voices, repetition and near-silence to create a peaceful and meditative form of remembrance."
  ],
  [
    "Zikr Symphony",
    "Neo-Sacred Zikr / Symphonic Sacred Music / Progressive Rock / Neoclassical Metal",
    "The first large-scale concept album of the universe: 19 principal works, with the nineteenth work containing a further 19-part medley, creating a two-level reference to the QUR'AN's 19-based system as understood by Köksal."
  ],
  [
    "Tanrı'nın Hediyesi",
    "Neo-Sacred Zikr / Spiritual Music / Contemporary Devotional Music",
    "The first album-format release of the journey, built around Tövbe Ettim, Estağfurullah Ya Gaffar in three complementary forms: vocal, instrumental and piano/choir-centered."
  ],
];

const singles = [
  "Zikir (La ilahe illa Allah)",
  "Zikir (Allah Allah La ilahe illa Allah)",
  "Tövbe Ettim, Estağfurullah Ya Gaffar",
  "Allahu Lena – Tanrı Bizimle",
  "Tanrıya Övgüler – All Praising Be to GOD",
  "Subhanallah",
  "Allahu Ekber",
  "Ya Baki Entel Baki",
  "Rabbi Eûzu Bike",
  "Allahu Allah",
];
---

<Layout
  title="Neo-Sacred Zikr | Sacred Music Universe by Berk KÖKSAL"
  description="Discover Neo-Sacred Zikr, the monotheistic sacred music universe developed by Berk KÖKSAL, where zikr is expressed through classical music, choirs, ambient meditation, rock, rap, jazz and symphonic metal."
  canonical="/neo-sacred-zikr/"
  ogImage="/artist/neo-sacred-zikr-banner.webp"
  ogType="website"
  twitterCard="summary_large_image"
>
  <Nav />

  <section class="min-h-screen py-10 md:py-28">
    <div class="mx-auto w-full max-w-6xl space-y-10 md:space-y-28">

      <!-- HERO -->
      <header class="relative w-full overflow-hidden border-y border-accent/20 sm:rounded-[2rem] sm:border">
        <img
          src="/artist/neo-sacred-zikr-banner.webp"
          alt="Neo-Sacred Zikr"
          class="h-[460px] w-full object-cover opacity-75 md:h-[620px]"
        />

        <div class="absolute inset-0 bg-gradient-to-r from-background via-background/75 to-background/10"></div>

        <div class="absolute inset-0 flex items-center px-5 py-10 sm:p-10 md:p-16">
          <div class="max-w-3xl">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">
              Monotheistic Sacred Music Universe
            </p>

            <h1 class="mb-6 text-4xl font-heading font-bold text-maintext sm:text-5xl md:text-7xl">
              Neo-Sacred Zikr
            </h1>

            <p class="text-lg leading-8 text-subtext sm:text-xl md:text-2xl md:leading-9">
              A contemporary sacred music universe developed by Berk KÖKSAL in which
              zikr can be expressed through classical chorus, ambient meditation,
              progressive rock, rap, jazz, symphonic metal and other musical languages
              while remaining centered on the remembrance and glorification of the
              ONE GOD.
            </p>
          </div>
        </div>
      </header>

      <!-- DEFINITION -->
      <section class="grid grid-cols-1 gap-12 px-5 sm:px-0 lg:grid-cols-[0.75fr_1.25fr]">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.45em] text-accent">I</p>
          <h2 class="text-4xl font-heading font-bold text-maintext md:text-5xl">
            What is Neo-Sacred Zikr?
          </h2>
        </div>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            Neo-Sacred Zikr is not defined by one tempo, one instrument, one vocal
            style or one genre. It is an upper musical concept that allows different
            forms of contemporary music to serve the same spiritual center:
            remembrance of GOD.
          </p>

          <p>
            In Köksal's understanding, a Neo-Sacred Zikr work may use symphonic
            orchestra, sacred choir, rock guitars, jazz harmony, rap rhythm,
            children's voices, ambient sound, piano, ney, organ or technologies that
            have not yet become part of the catalogue. The musical language is free;
            the center remains monotheistic.
          </p>

          <p>
            The purpose is therefore larger than producing songs inside a fixed
            style. The aim is to create a musical space in which the ONE GOD can be
            remembered and glorified through the sound world of the modern age.
          </p>
        </div>
      </section>

      <!-- ORIGIN OF NAME -->
      <section class="w-full border-y border-accent/20 bg-accent/5 px-5 py-10 sm:rounded-[2rem] sm:border sm:p-10 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">II · Origin of the Name</p>
        <h2 class="mb-8 text-4xl font-heading font-bold text-maintext md:text-6xl">
          The music came first. The name came later.
        </h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            Köksal's first zikr singles and early albums were created before the
            phrase <strong class="text-maintext">Neo-Sacred Zikr</strong> had been
            formalized. The name emerged later, around the period of
            <strong class="text-maintext">Classical Chorus</strong> and the
            development of his website.
          </p>

          <p>
            By then, the catalogue already contained symphonic, meditative, rock and
            choral approaches. Köksal wanted a single upper structure that could bring
            all of these works together without forcing them into one conventional
            genre. Neo-Sacred Zikr became that structure.
          </p>

          <p class="text-2xl font-heading font-bold leading-9 text-maintext">
            Genres are tools. The spiritual center is the identity.
          </p>
        </div>
      </section>

                <!-- NEO-SACRED ZIKR COLLAGE -->
      <section class="w-full overflow-hidden border-y border-accent/20 sm:rounded-[2rem] sm:border">
        <a
          href="/#projects"
          aria-label="Explore the Neo-Sacred Zikr discography"
          class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <img
            src="/images/writings/collage.webp"
            alt="Neo-Sacred Zikr album artwork collection by Berk Köksal"
            width="2048"
            height="1536"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full cursor-pointer object-cover transition duration-500 group-hover:scale-[1.01] group-hover:brightness-105"
          />
        </a>
      </section>

      <!-- PRINCIPLES -->
      <section class="px-5 sm:px-0">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">III · Core Principles</p>
        <h2 class="mb-10 text-4xl font-heading font-bold text-maintext md:text-6xl">
          Music as remembrance, reflection and glorification.
        </h2>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {principles.map((item) => (
            <div class="rounded-2xl border border-accent/20 bg-accent/5 p-6">
              <p class="text-xl font-heading font-bold text-maintext">{item}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FIRST WORK -->
      <section class="grid grid-cols-1 gap-12 px-5 sm:px-0 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">IV · The First Door</p>
          <h2 class="text-4xl font-heading font-bold text-maintext md:text-5xl">
            Zikir (La ilahe illa Allah)
          </h2>
        </div>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            The foundational work of the journey was
            <strong class="text-maintext">Zikir (La ilahe illa Allah)</strong>,
            released on YouTube on 31 August 2024. Köksal describes its production as
            a difficult process involving tempo, recording, software and other
            technical problems.
          </p>

          <p>
            When he felt close to abandoning the piece, he says he prayed for help to
            complete music whose purpose was to glorify GOD. He later came to regard
            the completion of this recording as the point at which the larger sacred
            music journey was opened to him.
          </p>

          <p>
            The work also established an important direction: traditional forms could
            inspire the musical memory, but the new compositions would be built
            around Köksal's monotheistic understanding of remembering GOD alone.
          </p>
        </div>
      </section>

      <!-- SINGLES IMAGE -->
      <section class="w-full overflow-hidden border-y border-accent/20 sm:rounded-[2rem] sm:border">
        <a
          href="https://open.spotify.com/intl-tr/artist/1XO4b3ijvx48kFpjptciXp/discography/single"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Listen to Berk Köksal singles on Spotify"
          class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <img
            src="/artist/singles.webp"
            alt="Neo-Sacred Zikr singles"
            class="w-full cursor-pointer object-cover transition duration-500 group-hover:scale-[1.015] group-hover:brightness-110"
            loading="lazy"
          />
        </a>
      </section>

      <!-- EARLY SINGLES -->
      <section class="grid grid-cols-1 gap-12 px-5 sm:px-0 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">V · Early Works</p>
          <h2 class="text-4xl font-heading font-bold text-maintext md:text-5xl">The vocabulary expands</h2>
        </div>

        <div>
          <p class="mb-7 text-lg leading-8 text-subtext">
            Before the album universe fully formed, a sequence of singles explored
            repentance, praise, divine names, collective zikr and different vocal
            approaches. In one recording, Arya Belinda Köksal's childhood voice was
            preserved after she spontaneously joined her father during zikr at home.
          </p>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {singles.map((single) => (
              <div class="rounded-xl border border-accent/20 bg-accent/5 p-5 font-bold text-maintext">{single}</div>
            ))}
          </div>
        </div>
      </section>

      <!-- UNIVERSE -->
      <section>
        <div class="px-5 sm:px-0">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">VI · The Universe</p>
          <h2 class="mb-8 text-4xl font-heading font-bold text-maintext md:text-5xl">
            From near-silence to symphonic metal.
          </h2>

          <p class="mb-10 max-w-4xl text-lg leading-8 text-subtext">
            The catalogue intentionally moves between extremes. Some projects reduce
            the arrangement almost to human voice and atmosphere; others use full
            orchestra, choir, distorted guitars and progressive structures. The
            contrast is part of the concept rather than a contradiction.
          </p>
        </div>

        <div class="space-y-3 sm:space-y-5">
          {albums.map(([title, genre, description]) => (
            <div class="border-y border-accent/20 bg-accent/5 px-5 py-6 sm:rounded-2xl sm:border sm:p-6">
              <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-accent">{genre}</p>
              <h3 class="mb-3 text-2xl font-heading font-bold text-maintext md:text-3xl">{title}</h3>
              <p class="leading-7 text-subtext">{description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ZIKR SYMPHONY FEATURE -->
      <section class="w-full border-y border-accent/20 bg-accent/5 px-5 py-10 sm:rounded-[2rem] sm:border sm:p-10 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">VII · First Major Concept Album</p>
        <h2 class="mb-8 text-4xl font-heading font-bold text-maintext md:text-6xl">Zikr Symphony</h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            The idea of a “zikr symphony” had existed in Köksal's imagination long
            before the album was completed. He wanted to hear monotheistic zikr inside
            a contemporary large-scale sound: choir, orchestra, bass, drums, metal
            guitars, organ and modern production.
          </p>

          <p>
            The project was planned around 19 principal works. During production,
            roughly fifty musical sketches were created. The final architecture kept
            19 main pieces and transformed the nineteenth work into a further 19-part
            medley so that additional musical ideas could remain part of the album.
          </p>

          <p>
            For Köksal, this made the album's connection with the number 19 structural
            rather than decorative. He regards Zikr Symphony as the first truly large
            Neo-Sacred Zikr concept album, even though the umbrella name itself was
            formalized later.
          </p>
        </div>
      </section>

      <!-- CONTRAST -->
      <section class="grid grid-cols-1 gap-8 px-5 sm:px-0 lg:grid-cols-3">
        <article class="rounded-2xl border border-accent/20 bg-accent/5 p-7">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-accent">Stillness</p>
          <h3 class="mb-4 text-2xl font-heading font-bold text-maintext">Zikr Huu</h3>
          <p class="leading-7 text-subtext">
            Nine pieces, female voices, minimal instrumentation and a meditative
            approach in which space and repetition are central.
          </p>
        </article>

        <article class="rounded-2xl border border-accent/20 bg-accent/5 p-7">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-accent">Nature</p>
          <h3 class="mb-4 text-2xl font-heading font-bold text-maintext">Zikr Nur</h3>
          <p class="leading-7 text-subtext">
            Rain, distant thunder, piano, ney, gentle rhythm and female voices create
            the image of divine light falling like rain.
          </p>
        </article>

        <article class="rounded-2xl border border-accent/20 bg-accent/5 p-7">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-accent">Energy</p>
          <h3 class="mb-4 text-2xl font-heading font-bold text-maintext">ZIKR ROCK</h3>
          <p class="leading-7 text-subtext">
            Rock and neoclassical guitar return to the foreground as the album grows
            progressively more distorted and energetic across its 19 tracks.
          </p>
        </article>
      </section>

      <!-- NEWEST -->
      <section class="w-full border-y border-accent/20 bg-accent/5 px-5 py-10 sm:rounded-[2rem] sm:border sm:p-10 md:p-14">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">VIII · 2026 Concept Milestone</p>
        <h2 class="mb-8 text-4xl font-heading font-bold text-maintext md:text-6xl">ZIKR SYMPHONIC METAL</h2>

        <div class="space-y-6 text-lg leading-8 text-subtext">
          <p>
            ZIKR SYMPHONIC METAL takes the universe into a stricter concept form. Its
            19 movements are centered almost entirely on one sacred utterance:
            <strong class="text-maintext">HÛ</strong>. Selected passages also use
            <strong class="text-maintext">Hay / Al-Hayy</strong>.
          </p>

          <p>
            A fragile female voice and breath can expand into sacred choir, strings,
            brass, timpani, pipe organ, bass, drums, distorted guitar and neoclassical
            solos. Metal is used as a language of power and majesty rather than anger.
          </p>

          <p class="text-2xl font-heading font-bold leading-9 text-maintext">
            One utterance. Nineteen movements. The sound changes; the center remains.
          </p>
        </div>
      </section>

      <!-- JOURNEY -->
      <section>
        <div class="px-5 sm:px-0">
          <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">IX · Journey</p>
          <h2 class="mb-10 text-4xl font-heading font-bold text-maintext md:text-5xl">Neo-Sacred Zikr Timeline</h2>
        </div>

        <div class="space-y-3 sm:space-y-5">
          {[
            ["2024", ["Zikir (La ilahe illa Allah) and the first zikr singles", "Tanrı'nın Hediyesi"]],
            ["2025", ["Zikr Symphony"]],
            [
              "2026",
              [
                "Zikr Huu",
                "Zikr Nur",
                "ZIKR ROCK",
                "Neo-Sacred Zikr: Classical Chorus",
                "Neo-Sacred Zikr: One God One Love",
                "ZIKR RAP",
                "Zikr-i Batın",
                "ZIKR JAZZ",
                "ZIKR SYMPHONIC METAL",
              ],
            ],
          ].map(([year, titles]) => (
            <div class="grid grid-cols-1 gap-4 border-y border-accent/20 bg-accent/5 px-5 py-6 sm:rounded-2xl sm:border sm:p-6 md:grid-cols-[120px_1fr]">
              <p class="font-bold text-accent">{year}</p>
              <div class="space-y-2">
                {(titles as string[]).map((title) => (
                  <h3 class="text-xl font-heading font-bold leading-snug text-maintext md:text-2xl">{title}</h3>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- LEGACY -->
      <section class="px-5 py-8 text-center sm:px-0 md:py-16">
        <p class="mb-8 text-xs font-bold uppercase tracking-[0.45em] text-accent">X · A Living Definition</p>
        <h2 class="mx-auto max-w-5xl text-4xl font-heading font-bold leading-tight text-maintext md:text-6xl">
          Neo-Sacred Zikr is intended to be a field that other monotheist musicians can continue.
        </h2>
        <p class="mx-auto mt-8 max-w-4xl text-lg leading-8 text-subtext">
          Köksal does not see the term only as the name of his own discography. His
          hope is that it can become a lasting musical definition — a space in which
          future artists can develop new sounds while keeping remembrance of the ONE
          GOD at the center.
        </p>
      </section>

      <!-- QURAN LINK -->
      <a
        href="https://qurantft.com"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full border-y border-accent/30 bg-accent/5 px-5 py-10 text-center transition-all hover:bg-accent/10 sm:rounded-[2rem] sm:border sm:p-10 md:p-14"
      >
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.45em] text-accent">QURAN: THE FINAL TESTAMENT</p>
        <h2 class="text-3xl font-heading font-bold leading-tight text-maintext md:text-5xl">
          [87:1] Glorify the name of your Lord, the Most High.
        </h2>
        <p class="mt-6 text-sm text-accent">Quran: The Final Testament ↗</p>
      </a>

    </div>
  </section>
</Layout>
