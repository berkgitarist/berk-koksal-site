---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/nav.astro';
import {
  formatWritingDate,
  getReadingMinutes,
  getWritingHref,
} from '../../utils/writings';

export async function getStaticPaths() {
  const writings = await getCollection('writings', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writings'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const minutes = getReadingMinutes(entry.body);

const siteUrl = Astro.site ?? new URL('https://berkkoksal.com');

const ensureTrailingSlash = (path: string) => {
  if (path === '/' || path.endsWith('/')) {
    return path;
  }

  return `${path}/`;
};

const getCanonicalWritingHref = (id: string) =>
  ensureTrailingSlash(getWritingHref(id));

const canonicalPath = getCanonicalWritingHref(entry.id);
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();

const allWritings = (
  await getCollection('writings', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  })
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const currentIndex = allWritings.findIndex((item) => item.id === entry.id);
const newerArticle = currentIndex > 0 ? allWritings[currentIndex - 1] : undefined;
const olderArticle = currentIndex >= 0 ? allWritings[currentIndex + 1] : undefined;
const normalizeTag = (tag: string) =>
  tag.trim().toLocaleLowerCase('tr-TR');

const currentTags = new Set(
  (data.tags ?? []).map(normalizeTag)
);

const relatedArticles = allWritings
  .filter((item) => {
    return (
      item.id !== entry.id &&
      item.data.language === data.language
    );
  })
  .map((item) => {
    const matchingTagCount = (item.data.tags ?? []).reduce(
      (total, tag) => {
        return total + (
          currentTags.has(normalizeTag(tag)) ? 1 : 0
        );
      },
      0
    );

    return {
      entry: item,
      matchingTagCount,
    };
  })
  .filter(({ matchingTagCount }) => matchingTagCount > 0)
  .sort((a, b) => {
    if (b.matchingTagCount !== a.matchingTagCount) {
      return b.matchingTagCount - a.matchingTagCount;
    }

    return (
      b.entry.data.publishDate.getTime() -
      a.entry.data.publishDate.getTime()
    );
  })
  .slice(0, 3)
  .map(({ entry }) => entry);

const isTurkish = data.language === 'tr';

const articleMenuItems = allWritings
  .filter((article) => article.data.language === data.language)
  .map((article) => ({
    href: getCanonicalWritingHref(article.id),
    title: article.data.title,
    date: formatWritingDate(article.data.publishDate, article.data.language),
    isCurrent: article.id === entry.id,
  }));
const readingLabel = isTurkish ? `${minutes} dk okuma` : `${minutes} min read`;
const publishedLabel = isTurkish ? 'Yayın tarihi' : 'Published';
const updatedLabel = isTurkish ? 'Güncellendi' : 'Updated';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  inLanguage: data.language === 'tr' ? 'tr-TR' : data.language,
  url: canonicalUrl,

  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },

  author: {
    '@type': 'Person',
    name: data.author,
    url: new URL('/biography/', siteUrl).toString(),
  },

  publisher: {
    '@type': 'Person',
    name: data.author,
    url: siteUrl.toString(),
  },

  ...(data.image
    ? {
        image: new URL(data.image, siteUrl).toString(),
      }
    : {}),
};
---

<Layout
  title={`${data.title} | Berk KÖKSAL`}
  description={data.description}
  canonical={canonicalUrl}
  ogImage={data.image ?? '/artist/berk-portrait.webp'}
  ogType="article"
  twitterCard="summary_large_image"
  lang={data.language}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <Nav />

  <aside
    class="article-page-menu-drawer hidden lg:block"
    aria-label={isTurkish ? 'Makale menüsü' : 'Article menu'}
  >
    <details class="article-page-menu article-page-menu--desktop">
      <summary class="article-page-menu__header">
        <span class="article-page-menu__copy min-w-0">
          <span class="block text-[0.62rem] font-bold uppercase tracking-[0.22em] text-accent">
            {isTurkish ? 'Hızlı erişim' : 'Quick access'}
          </span>
          <span class="mt-0.5 block font-heading text-lg font-bold text-maintext">
            {isTurkish ? 'Tüm Makaleler' : 'All Articles'}
          </span>
        </span>

        <span class="article-page-menu__actions">
          <span class="article-page-menu__count">{articleMenuItems.length}</span>
          <span class="article-page-menu__icon" aria-hidden="true"></span>
        </span>

        <span class="sr-only">
          {isTurkish ? 'Makale menüsünü aç veya kapat' : 'Open or close article menu'}
        </span>
      </summary>

      <div class="article-page-menu__body">
        <nav aria-label={isTurkish ? 'Tüm makaleler' : 'All articles'} class="article-page-menu__scroll">
          <ol class="space-y-0.5">
            {articleMenuItems.map((article, index) => (
              <li>
                <a
                  href={article.href}
                  class="article-page-menu__link"
                  data-astro-reload
                  aria-current={article.isCurrent ? 'page' : undefined}
                >
                  <span class="article-page-menu__number">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="min-w-0">
                    <span class="article-page-menu__title">{article.title}</span>
                    <span class="article-page-menu__date">{article.date}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <a href="/writings/" class="article-page-menu__footer-link">
          <span>{isTurkish ? 'Yazılar sayfasına dön' : 'Back to writings'}</span>
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </details>
  </aside>

 <article class="article-page-shell relative w-full max-w-none px-0 pb-24 pt-24 sm:px-0 md:pt-28 lg:mx-auto lg:max-w-[1600px] lg:px-8">
    <details class="article-page-menu-mobile mb-8 w-full max-w-none rounded-none border-x-0 lg:hidden">
      <summary>
        <span class="min-w-0">
          <span class="block text-[0.62rem] font-bold uppercase tracking-[0.22em] text-accent">
            {isTurkish ? 'Hızlı erişim' : 'Quick access'}
          </span>
          <span class="mt-0.5 block font-heading text-lg font-bold text-maintext">
            {isTurkish ? 'Tüm Makaleler' : 'All Articles'}
          </span>
        </span>
        <span class="article-page-menu__count">
          {articleMenuItems.length} {isTurkish ? 'yazı' : 'articles'}
        </span>
      </summary>

      <nav aria-label={isTurkish ? 'Tüm makaleler' : 'All articles'} class="article-page-menu-mobile__content">
        <ol class="space-y-0.5">
          {articleMenuItems.map((article, index) => (
            <li>
              <a
                href={article.href}
                class="article-page-menu__link"
                data-astro-reload
                aria-current={article.isCurrent ? 'page' : undefined}
              >
                <span class="article-page-menu__number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0">
                  <span class="article-page-menu__title">{article.title}</span>
                  <span class="article-page-menu__date">{article.date}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>

    <header class="mx-auto max-w-6xl text-center">
      <a
        href="/writings/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors hover:text-maintext"
      >
        <Icon name="mdi:arrow-left" class="h-5 w-5" />
        {isTurkish ? 'Yazılara dön' : 'Back to writings'}
      </a>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs uppercase tracking-[0.2em]">
        <span class="rounded-full border border-[#D4AF37]/30 bg-[#D4AF37]/8 px-4 py-2 font-bold text-[#D4AF37]">
          {data.category}
        </span>
        <span class="rounded-full border border-accent/20 bg-accent/5 px-4 py-2 font-bold text-accent">
          {isTurkish ? 'Türkçe' : 'English'}
        </span>
        {data.draft && !import.meta.env.PROD && (
          <span class="rounded-full border border-accent/20 bg-accent/5 px-4 py-2 font-bold text-accent">
            Draft preview
          </span>
        )}
      </div>

      <h1 class="mx-auto mt-6 max-w-6xl text-4xl font-bold leading-tight text-maintext sm:text-5xl md:text-7xl">
        {data.title}
      </h1>

      <p class="mx-auto mt-5 max-w-5xl text-lg leading-8 text-subtext md:text-xl">
        {data.description}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-subtext">
        <span>
          {publishedLabel}: <time datetime={data.publishDate.toISOString()}>{formatWritingDate(data.publishDate, data.language)}</time>
        </span>
        <span aria-hidden="true">•</span>
        <span>{readingLabel}</span>
        {data.updatedDate && (
          <>
            <span aria-hidden="true">•</span>
            <span>
              {updatedLabel}: <time datetime={data.updatedDate.toISOString()}>{formatWritingDate(data.updatedDate, data.language)}</time>
            </span>
          </>
        )}
      </div>
    </header>

    {data.image && (
      <figure class="mt-6 md:mt-10 w-full max-w-none overflow-hidden rounded-none border-y border-accent/15 bg-accent/5 shadow-[0_24px_80px_rgba(0,0,0,0.3)] sm:mx-auto sm:max-w-6xl sm:rounded-[2rem] sm:border">
    <img
      src={data.image}
      alt={data.imageAlt ?? data.title}
      width="1600"
      height="900"
      loading="eager"
      class="block aspect-[16/9] w-full object-cover sm:h-[380px] sm:aspect-auto md:h-[480px] lg:h-[560px]"
    />
  </figure>
)}

    <div class="writing-prose mt-6 md:mt-10 w-full max-w-none rounded-none border-y border-accent/12 bg-background/35 px-[6px] py-7 ...">
      <Content />
    </div>

    {data.tags.length > 0 && (
      <footer class="mx-auto mt-8 flex max-w-[1400px] flex-wrap gap-2">
        {data.tags.map((tag) => (
          <span class="rounded-full border border-accent/15 bg-accent/5 px-4 py-2 text-sm text-subtext">
            #{tag}
          </span>
        ))}
      </footer>
    )}

    {relatedArticles.length > 0 && (
  <section
    aria-labelledby="related-writings-title"
    class="mx-auto mt-6 max-w-[1400px] md:mt-12"
  >
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-xs font-bold uppercase tracking-[0.3em] text-accent"
        >
          {isTurkish ? 'Keşfet' : 'Discover'}
        </p>

        <h2
          id="related-writings-title"
          class="mt-1 text-3xl font-bold text-maintext"
        >
          {isTurkish ? 'İlgili Yazılar' : 'Related Articles'}
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {relatedArticles.map((article) => (
        <a
          href={getCanonicalWritingHref(article.id)}
          class="group overflow-hidden rounded-[1.75rem] border border-accent/15 bg-accent/5 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/35"
        >
          {article.data.image && (
            <div class="aspect-[16/9] overflow-hidden">
              <img
                src={article.data.image}
                alt={article.data.imageAlt ?? article.data.title}
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.035]"
              />
            </div>
          )}

          <div class="p-6">
            <p
              class="text-xs font-bold uppercase tracking-[0.2em] text-accent"
            >
              {isTurkish &&
              article.data.category === "Qur'an Reflections"
                ? 'Kuran Tefekkürleri'
                : article.data.category}
            </p>

            <h3
              class="mt-3 text-xl font-bold leading-snug text-maintext transition-colors group-hover:text-[#D4AF37]"
            >
              {article.data.title}
            </h3>

            <p class="mt-3 line-clamp-3 leading-7 text-subtext">
              {article.data.description}
            </p>

            <span
              class="mt-5 inline-flex items-center gap-2 font-semibold text-maintext"
            >
              {isTurkish ? 'Makaleyi oku' : 'Read article'}
              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

    {(newerArticle || olderArticle) && (
      <nav aria-label={isTurkish ? 'Makale gezintisi' : 'Article navigation'} class="mx-auto mt-6 grid max-w-[1400px] grid-cols-1 gap-5 md:grid-cols-2">
        {newerArticle ? (
          <a
            href={getCanonicalWritingHref(newerArticle.id)}
            class="group rounded-[1.75rem] border border-accent/15 bg-accent/5 p-7 transition-all hover:-translate-y-1 hover:border-[#D4AF37]/30"
          >
            <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent">
              {isTurkish ? 'Daha yeni' : 'Newer'}
            </span>
            <span class="mt-3 block text-xl font-bold leading-snug text-maintext transition-colors group-hover:text-[#D4AF37]">
              {newerArticle.data.title}
            </span>
          </a>
        ) : <div />}

        {olderArticle && (
          <a
            href={getCanonicalWritingHref(olderArticle.id)}
            class="group rounded-[1.75rem] border border-accent/15 bg-accent/5 p-7 text-right transition-all hover:-translate-y-1 hover:border-[#D4AF37]/30"
          >
            <span class="text-xs font-bold uppercase tracking-[0.25em] text-accent">
              {isTurkish ? 'Daha eski' : 'Older'}
            </span>
            <span class="mt-3 block text-xl font-bold leading-snug text-maintext transition-colors group-hover:text-[#D4AF37]">
              {olderArticle.data.title}
            </span>
          </a>
        )}
      </nav>
    )}
  </article>

  <script is:inline>
    (() => {
      const setupArticleMenu = () => {
        const desktopMenu = document.querySelector('.article-page-menu--desktop');
        const mobileMenu = document.querySelector('.article-page-menu-mobile');

        if (desktopMenu instanceof HTMLDetailsElement) {
          desktopMenu.open = false;

          if (desktopMenu.dataset.menuReady !== 'true') {
            desktopMenu.dataset.menuReady = 'true';

            document.addEventListener('keydown', (event) => {
              if (event.key === 'Escape') {
                desktopMenu.open = false;
              }
            });

            document.addEventListener('pointerdown', (event) => {
              const target = event.target;
              if (!(target instanceof Node)) return;
              if (!desktopMenu.open || desktopMenu.contains(target)) return;
              desktopMenu.open = false;
            });
          }
        }

        if (mobileMenu instanceof HTMLDetailsElement) {
          mobileMenu.open = false;
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupArticleMenu, {
          once: true,
        });
      } else {
        setupArticleMenu();
      }

      window.addEventListener('pageshow', setupArticleMenu);
      document.addEventListener('astro:page-load', setupArticleMenu);
    })();
  </script>

  <div
    id="copy-protection-warning"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    {isTurkish
      ? 'Bu makalenin kopyalanmasına izin verilmemektedir. İçerik kullanımı için Berk KÖKSAL ile iletişime geçebilirsiniz.'
      : 'Copying this article is not permitted.'}
  </div>

  <script is:inline>
    (() => {
      const setupCopyProtection = () => {
        const article = document.querySelector('.writing-prose');
        const warning = document.querySelector('#copy-protection-warning');

        if (!(article instanceof HTMLElement)) return;
        if (!(warning instanceof HTMLElement)) return;
        if (article.dataset.copyProtectionReady === 'true') return;

        article.dataset.copyProtectionReady = 'true';
        article.addEventListener('click', async (event) => {
  const target = event.target;

  if (!(target instanceof HTMLImageElement)) return;

  event.preventDefault();

  try {
    if (document.fullscreenElement === target) {
      await document.exitFullscreen();
      return;
    }

    if (!document.fullscreenElement) {
      await target.requestFullscreen();
    }
  } catch (error) {
    console.error('Görsel tam ekran açılamadı:', error);
  }
});

        let warningTimeout;

        const showWarning = () => {
          warning.classList.add('is-visible');
          window.clearTimeout(warningTimeout);

          warningTimeout = window.setTimeout(() => {
            warning.classList.remove('is-visible');
          }, 2200);
        };

        const blockAction = (event) => {
          event.preventDefault();
          showWarning();
        };

        article.addEventListener('copy', blockAction);
        article.addEventListener('cut', blockAction);
        article.addEventListener('contextmenu', blockAction);
        article.addEventListener('dragstart', blockAction);
        article.addEventListener('selectstart', blockAction);

        document.addEventListener('keydown', (event) => {
          const target = event.target;
          const isEditable =
            target instanceof HTMLElement &&
            (target.matches('input, textarea, select') || target.isContentEditable);

          if (isEditable) return;

          const hasModifier = event.ctrlKey || event.metaKey;
          if (!hasModifier) return;

          const key = event.key.toLowerCase();
          const blockedKeys = ['a', 'c', 'x', 's', 'u'];

          if (!blockedKeys.includes(key)) return;

          event.preventDefault();
          showWarning();
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCopyProtection, {
          once: true,
        });
      } else {
        setupCopyProtection();
      }

      document.addEventListener('astro:page-load', setupCopyProtection);
    })();
  </script>
</Layout>

<style>
  .article-page-menu,
  .article-page-menu-mobile {
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 72%);
    background-color: color-mix(in srgb, var(--color-background), black 24%);
    background-image: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-background), black 30%),
      color-mix(in srgb, var(--color-background), var(--color-accent) 7%)
    );
    box-shadow:
      0 22px 58px rgba(0, 0, 0, 0.46),
      inset 0 1px 0 color-mix(in srgb, var(--color-maintext), transparent 88%);
    backdrop-filter: blur(24px) saturate(82%);
    -webkit-backdrop-filter: blur(24px) saturate(82%);
  }

  .article-page-menu {
    overflow: hidden;
    width: clamp(15rem, 18vw, 18rem);
    border-radius: 1.35rem;
  }

  .article-page-menu__header {
    display: flex;
    min-height: 4.15rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.8rem 0.85rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent), transparent 84%);
    user-select: none;
  }

  .article-page-menu__header::-webkit-details-marker,
  .article-page-menu-mobile > summary::-webkit-details-marker {
    display: none;
  }

  .article-page-menu__actions {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.45rem;
  }

  .article-page-menu__count {
    display: inline-flex;
    flex: 0 0 auto;
    min-width: 1.95rem;
    min-height: 1.95rem;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 76%);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent), transparent 92%);
    color: var(--color-subtext);
    font-size: 0.66rem;
    font-weight: 700;
  }

  .article-page-menu__icon {
    display: inline-grid;
    width: 1.9rem;
    height: 1.9rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 76%);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--color-accent), transparent 93%);
    color: var(--color-accent);
  }

  .article-page-menu__icon::before {
    content: "\2039";
    font-size: 1.05rem;
    line-height: 1;
  }

  .article-page-menu__body {
    overflow: hidden;
  }

  .article-page-menu__scroll {
    max-height: calc(100vh - 16.5rem);
    overflow-y: auto;
    padding: 0.45rem;
    scrollbar-width: thin;
    scrollbar-color:
      color-mix(in srgb, var(--color-accent), transparent 48%)
      transparent;
  }

  .article-page-menu__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
    padding: 0.5rem 0.55rem;
    border: 1px solid transparent;
    border-radius: 0.78rem;
    color: var(--color-subtext);
    transition:
      color 0.22s ease,
      background-color 0.22s ease,
      border-color 0.22s ease,
      transform 0.22s ease;
  }

  .article-page-menu__link:hover {
    transform: translateX(2px);
    border-color: color-mix(in srgb, var(--color-accent), transparent 80%);
    background: color-mix(in srgb, var(--color-accent), transparent 94%);
    color: var(--color-maintext);
  }

  .article-page-menu__link[aria-current="page"] {
    border-color: color-mix(in srgb, var(--color-accent), transparent 62%);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent), transparent 87%),
      color-mix(in srgb, #d4af37, transparent 94%)
    );
    color: var(--color-maintext);
  }

  .article-page-menu__number {
    padding-top: 0.06rem;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .article-page-menu__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .article-page-menu__date {
    display: block;
    margin-top: 0.18rem;
    color: var(--color-subtext);
    font-size: 0.6rem;
    opacity: 0.74;
  }

  .article-page-menu__footer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.68rem 0.9rem;
