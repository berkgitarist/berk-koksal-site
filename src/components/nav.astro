---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './theme-toggle.astro';
import {
  getLanguageFromPath,
  getLanguageSwitchHref,
  localizePath,
  stripLanguagePrefix,
  type SiteLanguage,
} from '../utils/i18n';

interface NavSubItem {
  label: Record<SiteLanguage, string>;
  path: string;
  icon: string;
  matchPrefix?: string;
}

interface NavItem {
  label: Record<SiteLanguage, string>;
  path: string;
  icon: string;
  mobileLabel?: Record<SiteLanguage, string>;
  matchPrefix?: string;
  hash?: string;
  children?: NavSubItem[];
}

const currentPath = Astro.url.pathname;
const currentUrl = `${Astro.url.pathname}${Astro.url.search}`;
const language = getLanguageFromPath(currentPath);
const baseCurrentPath = stripLanguagePrefix(currentPath);

const navItems: NavItem[] = [
  {
    label: { en: 'Home', tr: 'Ana Sayfa' },
    path: '/',
    hash: 'home',
    icon: 'mdi:home',
  },
  {
    label: { en: 'Biography', tr: 'Biyografi' },
    path: '/biography/',
    icon: 'mdi:account-music',
    matchPrefix: '/biography',
  },
  {
    label: { en: 'Discography', tr: 'Diskografi' },
    path: '/',
    hash: 'projects',
    icon: 'mdi:album',
  },
  {
    label: { en: 'Neo-Sacred Zikr', tr: 'Neo-Sacred Zikr' },
    path: '/neo-sacred-zikr/',
    icon: 'mdi:music-circle',
    matchPrefix: '/neo-sacred-zikr',
  },
  {
    label: { en: 'Quranic Concepts', tr: 'Quranic Concepts' },
    mobileLabel: { en: 'Quranic', tr: 'Quranic' },
    path: '/quranic-concepts/',
    icon: 'mdi:book-open-page-variant',
    matchPrefix: '/quranic-concepts',
  },
  {
    label: { en: 'Writings', tr: 'Yazılar' },
    path: '/writings/',
    icon: 'mdi:book-open-page-variant',
    children: [
      {
        label: { en: 'Writings', tr: 'Yazılar' },
        path: '/writings/',
        icon: 'mdi:file-document-outline',
        matchPrefix: '/writings',
      },
      {
        label: { en: 'Poems', tr: 'Şiirler' },
        path: '/poems/',
        icon: 'mdi:feather',
        matchPrefix: '/poems',
      },
      {
        label: { en: 'Why 19?', tr: 'Neden 19?' },
        path: '/why-19/',
        icon: 'mdi:help-circle-outline',
        matchPrefix: '/why-19',
      },
    ],
  },
  {
    label: { en: 'Contact', tr: 'İletişim' },
    path: '/',
    hash: 'contact',
    icon: 'mdi:email',
  },
];

function itemHref(item: NavItem): string {
  const localizedPath = localizePath(item.path, language);

  if (item.hash) {
    return `${localizedPath}#${item.hash}`;
  }

  return localizedPath;
}

function isPathActive(path: string, matchPrefix?: string): boolean {
  const prefix = matchPrefix ?? path.replace(/\/$/, '');

  return (
    baseCurrentPath === prefix ||
    baseCurrentPath === `${prefix}/` ||
    baseCurrentPath.startsWith(`${prefix}/`)
  );
}

function isItemActive(item: NavItem): boolean {
  if (item.children?.length) {
    return item.children.some((child) =>
      isPathActive(child.path, child.matchPrefix)
    );
  }

  if (item.matchPrefix) {
    return isPathActive(item.path, item.matchPrefix);
  }

  if (item.path === '/' && item.hash === 'home') {
    return baseCurrentPath === '/';
  }

  return baseCurrentPath === item.path;
}

const englishHref = getLanguageSwitchHref(currentUrl, 'en');
const turkishHref = getLanguageSwitchHref(currentUrl, 'tr');
---

<div
  id="language-toggle-wrapper"
  class="fixed left-2 top-4 z-50 reveal-content sm:left-4 md:top-4"
  style="animation-delay: 700ms;"
>
  <div class="language-switcher" aria-label={language === 'tr' ? 'Dil seçimi' : 'Language selector'}>
    <a
      href={englishHref}
      data-language-switch
      hreflang="en"
      lang="en"
      aria-current={language === 'en' ? 'page' : undefined}
      class:list={['language-switcher__item', { active: language === 'en' }]}
    >
      EN
    </a>

    <span class="language-switcher__divider" aria-hidden="true">/</span>

    <a
      href={turkishHref}
      data-language-switch
      hreflang="tr"
      lang="tr"
      aria-current={language === 'tr' ? 'page' : undefined}
      class:list={['language-switcher__item', { active: language === 'tr' }]}
    >
      TR
    </a>
  </div>
</div>

<div
  id="theme-toggle-wrapper"
  class="fixed top-4 right-4 z-50 md:top-4 md:right-4 reveal-content"
  style="animation-delay: 700ms;"
>
  <ThemeToggle />
</div>

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    aria-label={language === 'tr' ? 'Ana menü' : 'Primary navigation'}
    class="pro-glass fixed left-1/2 -translate-x-1/2 z-20 border-[1.2px] transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[90%]"
  >
    <div
      class="container mx-auto flex justify-center items-center p-3 reveal-content"
      style="animation-delay: 700ms;"
    >
      <ul class="grid grid-cols-7 w-full items-center md:flex md:w-auto md:justify-center md:gap-6 lg:gap-9">
        {
          navItems.map((item) => {
            const isActive = isItemActive(item);
            const href = itemHref(item);

            if (item.children?.length) {
              return (
                <li class="flex min-w-0 justify-center md:flex-none">
                  <details class="nav-dropdown" data-nav-dropdown>
                    <summary
                      class={`nav-dropdown__trigger flex min-w-0 flex-col items-center gap-1 text-accent transition-colors text-[0.6rem] sm:text-xs md:text-base relative group ${isActive ? 'active' : ''}`}
                      aria-haspopup="true"
                    >
                      <div class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 nav-indicator hidden md:block" />

                      <span class="md:hidden flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6">
                        <Icon
                          name={item.icon}
                          class="nav-icon w-full h-full text-accent/50 group-hover:text-accent transition-colors duration-300"
                        />
                      </span>

                      <span class="hidden md:inline-flex items-center gap-1 whitespace-nowrap">
                        <span>{item.label[language]}</span>
                        <span class="nav-dropdown__chevron" aria-hidden="true">⌄</span>
                      </span>

                      <span class="md:hidden block max-w-full truncate leading-tight">
                        {item.mobileLabel?.[language] ?? item.label[language]}
                      </span>
                    </summary>

                    <div
                      class="nav-dropdown__menu"
                      aria-label={item.label[language]}
                    >
                      {item.children.map((child) => {
                        const childIsActive = isPathActive(child.path, child.matchPrefix);
                        const childHref = localizePath(child.path, language);

                        return (
                          <a
                            href={childHref}
                            aria-current={childIsActive ? 'page' : undefined}
                            class={`nav-dropdown__item ${childIsActive ? 'active' : ''}`}
                          >
                            <Icon name={child.icon} class="nav-dropdown__item-icon" />
                            <span>{child.label[language]}</span>
                          </a>
                        );
                      })}
                    </div>
                  </details>
                </li>
              );
            }

            return (
              <li class="flex min-w-0 justify-center md:flex-none">
                <a
                  href={href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`flex min-w-0 flex-col items-center gap-1 text-accent transition-colors text-[0.6rem] sm:text-xs md:text-base relative group ${isActive ? 'active' : ''}`}
                >
                  <div class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 nav-indicator hidden md:block" />

                  <span class="md:hidden flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6">
                    <Icon
                      name={item.icon}
                      class="nav-icon w-full h-full text-accent/50 group-hover:text-accent transition-colors duration-300"
                    />
                  </span>

                  <span class="hidden md:inline-block whitespace-nowrap">
                    {item.label[language]}
                  </span>

                  <span class="md:hidden block max-w-full truncate leading-tight">
                    {item.mobileLabel?.[language] ?? item.label[language]}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.55rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 72%);
    border-radius: 9999px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-background), transparent 18%),
        color-mix(in srgb, var(--color-accent), transparent 92%)
      );
    box-shadow:
      0 12px 38px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 color-mix(in srgb, var(--color-maintext), transparent 88%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .language-switcher__item {
    display: inline-flex;
    min-width: 1.6rem;
    min-height: 1.7rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-subtext);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .language-switcher__item:hover {
    color: var(--color-maintext);
    transform: translateY(-1px);
  }

  .language-switcher__item.active {
    background: color-mix(in srgb, var(--color-accent), transparent 84%);
    color: var(--color-maintext);
  }

  .language-switcher__divider {
    color: color-mix(in srgb, var(--color-accent), transparent 38%);
    font-size: 0.68rem;
    user-select: none;
  }

  nav {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-background), transparent 24%),
        color-mix(in srgb, var(--color-accent), transparent 92%)
      );
    border-color: color-mix(in srgb, var(--color-accent) 28%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-radius: 9999px;
    box-shadow:
      0 18px 60px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 color-mix(in srgb, var(--color-maintext), transparent 86%);
    transition:
      background-color 0.4s ease,
      backdrop-filter 0.4s ease,
      border-radius 0.4s ease,
      border-color 0.4s ease,
      width 0.4s ease;
  }

  nav.scrolling {
    background-color: color-mix(in srgb, var(--color-background), transparent 75%);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 9999px;
    backdrop-filter: blur(10px);
  }

  nav a,
  nav .nav-dropdown__trigger {
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      font-weight 0.3s ease;
  }

  .nav-dropdown__trigger {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  nav a.active,
  nav .nav-dropdown__trigger.active {
    color: var(--color-maintext) !important;
    font-weight: 700;
    transform: scale(1.03);
  }

  nav a.active span,
  nav .nav-dropdown__trigger.active span {
    text-shadow: 0 0 10px color-mix(in srgb, var(--color-maintext) 30%, transparent);
  }

  nav li {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .nav-icon {
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      filter 0.3s ease;
  }

  nav a.active .nav-icon,
  nav .nav-dropdown__trigger.active .nav-icon {
    color: var(--color-maintext) !important;
    transform: scale(1.2);
    filter: drop-shadow(0 0 8px var(--color-maintext));
  }

  nav a:not(.active):hover,
  nav .nav-dropdown__trigger:not(.active):hover {
    color: var(--color-maintext) !important;
  }

  nav a:not(.active):hover span,
  nav .nav-dropdown__trigger:not(.active):hover span {
    transform: scale(1.03);
    text-shadow: 0 0 15px var(--color-accent-60);
  }

  nav a:not(.active):hover .nav-icon,
  nav .nav-dropdown__trigger:not(.active):hover .nav-icon {
    transform: scale(0.95);
    color: var(--color-maintext) !important;
  }

  #main-nav,
  #main-nav > div,
  #main-nav ul,
  .nav-dropdown {
    overflow: visible !important;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown > summary {
    list-style: none;
  }

  .nav-dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown > summary::marker {
    content: '';
  }

  .nav-dropdown__chevron {
    display: inline-block;
    font-size: 0.8em;
    line-height: 1;
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .nav-dropdown[open] .nav-dropdown__chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown__menu {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.85rem);
    z-index: 60;
    display: grid;
    min-width: 11.5rem;
    gap: 0.35rem;
    padding: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 72%);
    border-radius: 1rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-background), transparent 8%),
        color-mix(in srgb, var(--color-accent), transparent 90%)
      );
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 color-mix(in srgb, var(--color-maintext), transparent 88%);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -0.45rem) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      transform 0.2s ease;
  }

  .nav-dropdown[open] .nav-dropdown__menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
  }

  .nav-dropdown__item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.65rem 0.75rem;
    border-radius: 0.7rem;
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .nav-dropdown__item:hover {
    background: color-mix(in srgb, var(--color-accent), transparent 88%);
    color: var(--color-maintext) !important;
    transform: none !important;
  }

  .nav-dropdown__item.active {
    background: color-mix(in srgb, var(--color-accent), transparent 82%);
    color: var(--color-maintext) !important;
    transform: none !important;
  }

  .nav-dropdown__item-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    color: currentColor;
  }

  @media (max-width: 767px) {
    body {
      padding-bottom: 70px;
    }

    nav {
      width: 100% !important;
      bottom: 0;
      border-radius: 1.5rem 1.5rem 0 0;
      background-color: color-mix(in srgb, var(--color-background), transparent 10%);
      backdrop-filter: blur(10px);
      border-top: 1px solid color-mix(in srgb, var(--color-maintext) 15%, transparent);
    }

    nav.scrolling {
      border-radius: 1.5rem 1.5rem 0 0;
      width: 100% !important;
    }

    #main-nav {
      will-change: transform;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
      background-clip: padding-box;
    }

    #main-nav.nav-hidden {
      transform: translate3d(0, 110%, 0) !important;
      backdrop-filter: blur(0px);
    }

    .nav-dropdown__menu {
      top: auto;
      bottom: calc(100% + 0.85rem);
      min-width: 10.5rem;
      transform: translate(-50%, 0.45rem) scale(0.98);
      transform-origin: bottom center;
    }

    .nav-dropdown[open] .nav-dropdown__menu {
      transform: translate(-50%, 0) scale(1);
    }

    .nav-dropdown__item {
      padding: 0.7rem 0.75rem;
      font-size: 0.82rem;
    }

    #theme-toggle-wrapper,
    #language-toggle-wrapper {
      will-change: transform;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #theme-toggle-wrapper.theme-hidden,
    #language-toggle-wrapper.language-hidden {
      transform: translateY(-150%) !important;
    }
  }
  /* === WRITINGS / POEMS DROPDOWN - SOLID PURPLE === */

.nav-dropdown__menu {
  background: linear-gradient(
    145deg,
    #24194f 0%,
    #18112f 100%
  );

  border: 1px solid rgba(167, 139, 250, 0.35);

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.45),
    0 0 35px rgba(167, 139, 250, 0.10);

  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.nav-dropdown__item.active {
  background: rgba(167, 139, 250, 0.20);
  color: #ffffff !important;
}

.nav-dropdown__item:hover {
  background: rgba(167, 139, 250, 0.12);
  color: #ffffff !important;
}
</style>

<script>
  const nav = document.getElementById('main-nav');
  const themeWrapper = document.getElementById('theme-toggle-wrapper');
  const languageWrapper = document.getElementById('language-toggle-wrapper');

  const dropdowns = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]')
  );

  function closeAllDropdowns(except?: HTMLDetailsElement) {
    dropdowns.forEach((dropdown) => {
      if (dropdown !== except) {
        dropdown.removeAttribute('open');
      }
    });
  }

  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) {
        closeAllDropdowns(dropdown);
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Node)) {
      return;
    }

    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(target)) {
        dropdown.removeAttribute('open');
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeAllDropdowns();
    }
  });

  const maxScroll = 1000;
  let lastScrollY = window.scrollY;
  let rafId: number | null = null;

  function updateNav() {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 0) {
      nav?.classList.add('scrolling');

      const scrollProgress = Math.min(window.scrollY / maxScroll, 1);
      const easeProgress = 1 - Math.pow(1 - scrollProgress, 4);

      const minWidth = 1080;
      const maxWidth = window.innerWidth * 0.9;
      const currentWidth =
        maxWidth - (maxWidth - minWidth) * easeProgress;

      if (window.innerWidth >= 768) {
        nav?.style.setProperty(
          'width',
          `${Math.min(currentWidth, window.innerWidth - 32)}px`
        );
      }
    } else {
      nav?.classList.remove('scrolling');

      if (window.innerWidth >= 768) {
        nav?.style.removeProperty('width');
      }
    }

    if (window.innerWidth < 768) {
      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        closeAllDropdowns();
        nav?.classList.add('nav-hidden');
        themeWrapper?.classList.add('theme-hidden');
        languageWrapper?.classList.add('language-hidden');
      } else {
        nav?.classList.remove('nav-hidden');
        themeWrapper?.classList.remove('theme-hidden');
        languageWrapper?.classList.remove('language-hidden');
      }
    }

    lastScrollY = currentScrollY;
    rafId = null;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true }
  );

  window.addEventListener('resize', updateNav, { passive: true });

  /* =====================================================
     UNIVERSAL LANGUAGE SWITCH
     =====================================================
     Astro.url cannot receive the browser fragment (#section),
     because URL fragments never reach the server. Preserve it
     at click time so /#projects becomes /tr/#projects, etc.
  */
  document
    .querySelectorAll<HTMLAnchorElement>('[data-language-switch]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        const currentHash = window.location.hash;

        if (!currentHash) {
          return;
        }

        const target = new URL(link.href, window.location.origin);
        target.hash = currentHash;
        link.href = `${target.pathname}${target.search}${target.hash}`;
      });
    });
</script>
