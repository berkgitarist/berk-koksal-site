---
import { Icon } from 'astro-icon/components';

import localDataEn from '../data/home.json';
import localDataTr from '../data/home.tr.json';
import albumsData from '../data/albums.json';

interface Social {
  name: string;
  url: string;
  icon: string;
  showInContact?: boolean;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  intro: string;
  introHtml: string;
  resumeUrl: string;
  socials: Social[];
}

interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;
const isTurkish = lang === 'tr';

const selectedLocalData = isTurkish
  ? localDataTr
  : localDataEn;

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData;

if (!isTurkish && isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);

    if (!response.ok) {
      throw new Error('Network response was not ok');
    }

    data = await response.json();
  } catch (error) {
    console.error(
      'API Fetch failed, falling back to mock data',
      error
    );

    data = selectedLocalData as ProfileData;
  }
} else {
  data = selectedLocalData as ProfileData;
}

const {
  name,
  intro,
  introHtml,
  resumeUrl,
  socials
} = data;

const displayIntro =
  selectedLocalData.introHtml ||
  introHtml ||
  intro;

const helllAlbum = albumsData.find(
  (album) => album.slug === 'helll'
);

const copy = isTurkish
  ? {
      officialArtistWebsite: 'Resmî Sanatçı Sitesi',
      listenOnSpotify: "Spotify'da Dinle",
      officialArtistPage: 'Resmî Sanatçı Sayfası',
      creativeUniverses: 'MÜZİKAL EVRENLER',
      sacredMusicUniverse: 'Yeni Çağın Zikiri',
      neoDescription:
        'Zikir, tekrar, adanmışlık ve kutsal anış etrafında şekillenen bir müzik evreni. Merkezinde zikir vardır.',
      neoStatement:
        'Neo-Sacred Zikr dinleyiciyi hatırlamaya davet eder.',
      conceptAlbumSeries: 'Konsept Albüm Serisi',
      quranicDescription:
        'KURAN’da anlatılan belirli temalar, sahneler, sesler ve gerçeklikler etrafında kurulan konsept albümler. Müziğin biçimini konu belirler.',
      quranicStatement:
        'QURANIC CONCEPTS dinleyiciyi bu dünyaların içine girmeye davet eder.',
      hourEyebrow: '• KURAN TEFEKKÜRÜ •',
      hourTitle: 'KIYAMET SAATİ',
      hourTarget: '24 EYLÜL 2280 • 19:33 UTC',
      hourRead: 'Tefekkürü oku',
      hourYears: 'YIL',
      hourMonths: 'AY',
      hourDays: 'GÜN',
      hourHours: 'SAAT',
      hourMinutes: 'DAKİKA',
      hourSeconds: 'SANİYE',
      albumMeta: 'ALBÜM • 2026 • 19 PARÇA',
      helllStatement: 'BU ALBÜM BU DÜNYAYA AİT DEĞİL.',
      helllDescription:
        'Cehennem, hesap, pişmanlık, susuzluk, hapsedilme ve geri dönüşü olmayan sonuçlara ilişkin KURAN merkezli uyarıları tek bir tavizsiz müzikal inişe dönüştüren 19 parçalık bir konsept albüm — on dokuzun mimarisinin içinde sona eriyor.',
      magnificentDisturbance: 'Muhteşem Bir Sarsıntı',
      warningMustBeHeard: 'Uyarı Duyulmalı',
      enterHelll: "CEHENNEM'i Dinle",
    }
  : {
      officialArtistWebsite: 'Official Artist Website',
      listenOnSpotify: 'Listen on Spotify',
      officialArtistPage: 'Official Artist Page',
      creativeUniverses: 'CREATIVE UNIVERSES',
      sacredMusicUniverse: 'Sacred Music Universe',
      neoDescription:
        'Music centered on remembrance, repetition, devotion and sacred invocation. Its center is Zikr.',
      neoStatement:
        'Neo-Sacred Zikr invites the listener to remember.',
      conceptAlbumSeries: 'Concept Album Series',
      quranicDescription:
        'Concept albums built around specific themes, scenes, voices and realities described in the Quran. The subject determines the sound.',
      quranicStatement:
        'QURANIC CONCEPTS invites the listener to enter these worlds.',
      hourEyebrow: '• QURAN REFLECTION •',
      hourTitle: 'DOOMSDAY CLOCK',
      hourTarget: '24 SEPTEMBER 2280 • 19:33 UTC',
      hourRead: 'Read the reflection',
      hourYears: 'YEARS',
      hourMonths: 'MONTHS',
      hourDays: 'DAYS',
      hourHours: 'HOURS',
      hourMinutes: 'MINUTES',
      hourSeconds: 'SECONDS',
      albumMeta: 'ALBUM • 2026 • 19 TRACKS',
      helllStatement: 'THIS ALBUM DOES NOT BELONG TO THIS WORLD.',
      helllDescription:
        'A 19-track Quran-centered concept album that transforms warnings of Hell, judgment, regret, thirst, confinement and irreversible consequence into one uncompromising musical descent — ending inside the architecture of nineteen.',
      magnificentDisturbance: 'A Magnificent Disturbance',
      warningMustBeHeard: 'The Warning Must Be Heard',
      enterHelll: 'Enter HELLL',
    };

const hourHref = isTurkish
  ? '/tr/writings/kiyamet-saati/'
  : '/writings/doomsday-clock/';
const hourTarget = '2280-09-24T19:33:00Z';
---

<section
  id="home"
  class="flex min-h-[62vh] flex-col items-center justify-center gap-1 text-center section-container md:pt-30"
>
  <div
    class="relative mb-2 flex w-full self-center justify-center group reveal-content"
    style="animation-delay: 100ms;"
  >
    <div
      class="w-20 h-20 overflow-hidden border-2 rounded-full balloon-float md:w-24 md:h-24 border-accent shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)]"
    >
      <img
        src="/artist-logo.webp"
        alt={isTurkish ? 'Berk Köksal sanatçı logosu' : 'Berk Köksal artist logo'}
        class="object-cover w-full h-full scale-110"
        loading="eager"
        decoding="async"
      />
    </div>

    <div
      class="absolute top-0 left-0 -z-10 w-full h-full rounded-full balloon-float bg-accent blur-[80px] opacity-20"
    >
    </div>
  </div>

  <div
    class="reveal-content"
    style="animation-delay: 200ms;"
  >
    <p class="font-light leading-relaxed font-body text-subtext">
      {copy.officialArtistWebsite}
    </p>
  </div>

  <div
    class="relative z-0 px-6 mx-auto sm:px-14 md:px-18 lg:px-40 max-w-360 reveal-content"
    style="animation-delay: 300ms;"
  >
    <h1
      class="text-5xl font-bold tracking-tight md:text-7xl font-heading text-maintext"
    >
      {name}
    </h1>

    <br />

    <p
      class="text-lg leading-relaxed font-body text-subtext"
      set:html={displayIntro}
    />
  </div>

  <div
    class="mt-8 mb-4 reveal-content"
    style="animation-delay: 400ms;"
  >
    <a
      href={resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={copy.listenOnSpotify}
      class="relative inline-flex items-center justify-center px-10 py-3 transition-all duration-300 border rounded-full group border-accent/50 text-maintext font-body bg-accent/10 hover:bg-accent/20 md:shadow-none md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] hover:scale-105"
    >
      <div class="flex items-center gap-3">
        <Icon
          name="mdi:spotify"
          class="w-5 h-5 transition-colors duration-300 text-maintext group-hover:text-accent"
        />

        <div class="flex flex-col items-start text-left">
          <span
            class="text-sm font-medium tracking-wide md:text-base"
          >
            {copy.listenOnSpotify}
          </span>

          <span
            class="text-[10px] text-subtext font-light whitespace-nowrap"
          >
            {copy.officialArtistPage}
          </span>
        </div>
      </div>

      <div
        class="absolute inset-0 -z-10 rounded-full blur-md bg-accent/20 opacity-100 transition-opacity duration-500 md:opacity-0 md:group-hover:opacity-100"
      >
      </div>
    </a>
  </div>

  <div
    class="flex w-full items-center justify-center gap-6 mt-4 mb-4 md:mb-0 reveal-content"
    style="animation-delay: 500ms;"
  >
    {
      socials
        .filter(
          (social) =>
            social.url &&
            social.url !== '#' &&
            social.url !== ''
        )
        .map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="relative flex flex-col items-center justify-center transition-all duration-300 group hover:scale-110"
          >
            <Icon
              name={social.icon}
              class="w-8 h-8 transition-colors duration-300 text-maintext group-hover:text-accent"
            />

            <span
              class="absolute -bottom-6 scale-0 opacity-0 transition-all duration-300 text-xs text-accent font-body group-hover:scale-100 group-hover:opacity-100"
            >
              {social.name}
            </span>
          </a>
        ))
    }
  </div>

  <a
    href={hourHref}
    class="doomsday-clock reveal-content"
    style="animation-delay: 575ms;"
    aria-label={`${copy.hourTitle} — ${copy.hourRead}`}
  >
    <span class="doomsday-clock__glow" aria-hidden="true"></span>

    <div class="doomsday-clock__topline">
      <span class="doomsday-clock__seal-spacer" aria-hidden="true"></span>

      <div class="doomsday-clock__titles">
        <p class="doomsday-clock__eyebrow">{copy.hourEyebrow}</p>
        <h2 class="doomsday-clock__title">{copy.hourTitle}</h2>
      </div>

      <span class="doomsday-clock__seal" aria-hidden="true">19:33</span>
    </div>

    <div
      class="doomsday-clock__digits"
      data-doomsday-clock
      data-target={hourTarget}
      aria-hidden="true"
    >
      <div class="doomsday-clock__unit">
        <span class="doomsday-clock__value" data-clock-years>000</span>
        <span class="doomsday-clock__label">{copy.hourYears}</span>
      </div>
      <div class="doomsday-clock__unit">
        <span class="doomsday-clock__value" data-clock-months>00</span>
        <span class="doomsday-clock__label">{copy.hourMonths}</span>
      </div>
      <div class="doomsday-clock__unit">
        <span class="doomsday-clock__value" data-clock-days>00</span>
        <span class="doomsday-clock__label">{copy.hourDays}</span>
      </div>
      <div class="doomsday-clock__unit">
        <span class="doomsday-clock__value" data-clock-hours>00</span>
        <span class="doomsday-clock__label">{copy.hourHours}</span>
      </div>
      <div class="doomsday-clock__unit">
        <span class="doomsday-clock__value" data-clock-minutes>00</span>
        <span class="doomsday-clock__label">{copy.hourMinutes}</span>
      </div>
      <div class="doomsday-clock__unit">
        <span class="doomsday-clock__value" data-clock-seconds>00</span>
        <span class="doomsday-clock__label">{copy.hourSeconds}</span>
      </div>
    </div>

    <div class="doomsday-clock__footer">
      <time datetime={hourTarget}>{copy.hourTarget}</time>
      <span class="doomsday-clock__cta">{copy.hourRead} <span aria-hidden="true">→</span></span>
    </div>
  </a>
</section>

<section class="mt-6 mb-8 md:-mt-6">
  <div class="mb-6 flex items-center gap-2">
    <Icon name="mdi:vector-arrange-above" class="h-5 w-5 text-accent" />
    <span class="text-xs font-semibold uppercase tracking-[0.35em] text-accent">
      {copy.creativeUniverses}
    </span>
  </div>

  <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
    <a
      href={isTurkish ? "/tr/neo-sacred-zikr/" : "/neo-sacred-zikr/"}
      class="group rounded-[2rem] border border-accent/20 bg-accent/5 p-7 no-underline transition-all duration-300 hover:-translate-y-1 hover:border-accent/45 hover:bg-accent/10 md:p-9"
    >
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.35em] text-accent">
        {copy.sacredMusicUniverse}
      </p>
      <h2 class="text-3xl font-heading font-bold text-maintext md:text-4xl">
        Neo-Sacred Zikr
      </h2>
      <p class="mt-4 max-w-xl leading-7 text-subtext">
        {copy.neoDescription}
      </p>
      <p class="mt-7 font-heading text-lg font-bold text-maintext">
        {copy.neoStatement}
      </p>
    </a>

    <a
      href={isTurkish ? "/tr/quranic-concepts/" : "/quranic-concepts/"}
      class="group rounded-[2rem] border border-[#6f1010]/45 bg-black/25 p-7 no-underline transition-all duration-300 hover:-translate-y-1 hover:border-[#a51d1d]/70 hover:bg-black/40 md:p-9"
    >
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.35em] text-[#b74a4a]">
        {copy.conceptAlbumSeries}
      </p>
      <h2 class="text-3xl font-heading font-bold text-maintext md:text-4xl">
        QURANIC CONCEPTS
      </h2>
      <p class="mt-4 max-w-xl leading-7 text-subtext">
        {copy.quranicDescription}
      </p>
      <p class="mt-7 font-heading text-lg font-bold text-maintext">
        {copy.quranicStatement}
      </p>
    </a>
  </div>
</section>

<section class="mb-6">
  <div
    class="relative overflow-hidden rounded-[2rem] border border-[#6f1010]/40 bg-black/35 p-6 backdrop-blur-xl md:p-8"
  >
    <div
      class="pointer-events-none absolute -right-10 top-1/2 -translate-y-1/2 select-none text-[17rem] font-heading font-bold leading-none tracking-[-0.06em] text-[#8f1c1c]/[0.12] md:-right-16 md:text-[28rem]"
      aria-hidden="true"
    >
      XIX
    </div>

    <div class="mb-6 flex items-center gap-2">
      <Icon name="mdi:album" class="h-5 w-5 text-[#b74a4a]" />

      <span class="text-xs font-semibold uppercase tracking-[0.35em] text-[#b74a4a]">
        QURANIC CONCEPTS
      </span>
    </div>

    <div class="grid items-center grid-cols-1 gap-10 lg:grid-cols-[340px_1fr]">
      <a href={isTurkish ? "/tr/albums/helll/" : "/albums/helll/"} class="group">
        <img
          src="/albums/helll.png"
          alt={isTurkish ? 'Berk KÖKSAL imzalı HELLL albüm kapağı' : 'HELLL album cover by Berk KÖKSAL'}
          loading="lazy"
          decoding="async"
          class="w-full rounded-3xl border border-white/10 bg-black shadow-[0_0_80px_rgba(120,0,0,0.16)] transition duration-500 group-hover:scale-[1.02]"
        />
      </a>

      <div>
        <div class="mb-2 text-sm uppercase tracking-[0.35em] text-[#b74a4a]">
          {copy.albumMeta}
        </div>

        <h2 class="mb-3 text-5xl font-bold leading-none text-maintext md:text-7xl">
          HELLL CEHENNEMM
        </h2>

        <p class="mb-5 font-heading text-xl font-bold uppercase tracking-[0.08em] text-maintext/90 md:text-2xl">
          {copy.helllStatement}
        </p>

        <p class="mb-8 max-w-3xl text-lg leading-8 text-subtext">
          {copy.helllDescription}
        </p>

        <div class="mb-8 flex flex-wrap gap-2 text-xs uppercase tracking-widest">
          <span class="rounded-full border border-[#8f1c1c]/35 bg-[#8f1c1c]/10 px-4 py-2 text-[#d16c6c]">{copy.magnificentDisturbance}</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-maintext/75">19 × 19</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-maintext/75">XIX</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-maintext/75">{copy.warningMustBeHeard}</span>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href={helllAlbum?.spotify ?? resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-full border border-[#1DB954]/30 bg-[#1DB954]/10 px-7 py-4 font-semibold text-maintext transition hover:bg-[#1DB954]/20"
          >
            <Icon name="mdi:spotify" class="h-5 w-5 text-[#1DB954]" />
            Spotify
          </a>

          <a
            href={isTurkish ? "/tr/albums/helll/" : "/albums/helll/"}
            class="inline-flex items-center gap-3 rounded-full border border-[#8f1c1c]/45 bg-[#8f1c1c]/10 px-7 py-4 font-semibold text-maintext transition hover:bg-[#8f1c1c]/20"
          >
            {copy.enterHelll}
          </a>

          <a
            href={isTurkish ? "/tr/quranic-concepts/" : "/quranic-concepts/"}
            class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 px-7 py-4 font-semibold text-maintext transition hover:bg-white/10"
          >
            QURANIC CONCEPTS
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation:
      revealIn
      0.8s
      cubic-bezier(0.2, 0.8, 0.2, 1)
      forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .balloon-float {
    will-change: transform;
    animation:
      floating-balloon
      8s
      ease-in-out
      infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform:
        translate(0, 0)
        rotate(0deg);
    }

    33% {
      transform:
        translate(3px, -8px)
        rotate(1deg);
    }

    66% {
      transform:
        translate(-3px, -4px)
        rotate(-1deg);
    }

    100% {
      transform:
        translate(0, 0)
        rotate(0deg);
    }
  }


  /* === Kıyamet Saati / homepage countdown === */
  .doomsday-clock {
    position: relative;
    isolation: isolate;
    width: min(980px, calc(100% - 1.5rem));
    margin-top: 2.15rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 48%);
    border-radius: 30px;
    padding: 1.35rem 1.45rem 1.15rem;
    color: var(--color-maintext);
    text-align: left;
    text-decoration: none;
    background:
      radial-gradient(circle at 82% 15%, color-mix(in srgb, var(--color-accent), transparent 78%), transparent 26%),
      linear-gradient(135deg, rgba(3, 2, 18, 0.88), color-mix(in srgb, var(--color-background), black 8%));
    box-shadow:
      0 28px 90px rgba(0, 0, 0, 0.38),
      0 0 70px color-mix(in srgb, var(--color-accent), transparent 88%),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .doomsday-clock::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.045) 50%, transparent 100%);
    transform: translateX(-110%);
    transition: transform 0.9s ease;
  }

  .doomsday-clock:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--color-accent), transparent 22%);
    box-shadow:
      0 34px 100px rgba(0, 0, 0, 0.44),
      0 0 95px color-mix(in srgb, var(--color-accent), transparent 78%),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .doomsday-clock:hover::before {
    transform: translateX(110%);
  }

  .doomsday-clock__glow {
    position: absolute;
    right: -8rem;
    top: -8rem;
    z-index: -1;
    width: 22rem;
    height: 22rem;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 84%);
    border-radius: 999px;
    box-shadow:
      0 0 0 28px color-mix(in srgb, var(--color-accent), transparent 95%),
      0 0 0 74px color-mix(in srgb, var(--color-accent), transparent 97%);
  }

  .doomsday-clock__topline {
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr) 68px;
    align-items: center;
    gap: 1rem;
  }

  .doomsday-clock__titles {
    min-width: 0;
    text-align: center;
  }

  .doomsday-clock__seal-spacer {
    width: 68px;
    height: 68px;
  }

  .doomsday-clock__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .doomsday-clock__eyebrow {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .doomsday-clock__title {
    margin: 0.3rem 0 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    font-weight: 750;
    letter-spacing: 0.02em;
  }

  .doomsday-clock__seal {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 48%);
    border-radius: 999px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent), transparent 94%);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    box-shadow: inset 0 0 28px color-mix(in srgb, var(--color-accent), transparent 90%);
  }

  .doomsday-clock__digits {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.2rem;
    padding: 1.15rem 1rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.24);
    box-shadow: inset 0 14px 34px rgba(0, 0, 0, 0.2);
  }

  .doomsday-clock__unit {
    position: relative;
    min-width: 0;
    text-align: center;
  }

  .doomsday-clock__unit + .doomsday-clock__unit {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .doomsday-clock__value {
    display: block;
    overflow: hidden;
    color: #fff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-variant-numeric: tabular-nums lining-nums;
    font-size: clamp(1.7rem, 3.15vw, 3.35rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: 0.035em;
    text-shadow:
      0 0 18px color-mix(in srgb, var(--color-accent), transparent 52%),
      0 0 42px color-mix(in srgb, var(--color-accent), transparent 78%);
  }

  .doomsday-clock__label {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-subtext);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.28em;
  }

  .doomsday-clock__footer {
    margin-top: 1rem;
    color: var(--color-subtext);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  .doomsday-clock__cta {
    color: var(--color-maintext);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .doomsday-clock__digits {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .doomsday-clock__unit:nth-child(4) {
      border-left: 0;
    }
  }

  @media (max-width: 640px) {
    .doomsday-clock {
      width: calc(100% - 0.5rem);
      margin-top: 1.75rem;
      padding: 1.1rem;
      border-radius: 22px;
    }

    .doomsday-clock__topline {
      grid-template-columns: 54px minmax(0, 1fr) 54px;
      gap: 0.55rem;
    }

    .doomsday-clock__seal-spacer,
    .doomsday-clock__seal {
      width: 54px;
      height: 54px;
    }

    .doomsday-clock__seal {
      font-size: 0.72rem;
    }

    .doomsday-clock__eyebrow {
      font-size: 0.58rem;
      letter-spacing: 0.22em;
    }

    .doomsday-clock__digits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
      padding: 0.8rem;
    }

    .doomsday-clock__unit {
      padding: 0.7rem 0.25rem;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.018);
    }

    .doomsday-clock__unit + .doomsday-clock__unit {
      border-left: 1px solid rgba(255, 255, 255, 0.06);
    }

    .doomsday-clock__unit:nth-child(odd) {
      border-left: 0;
    }

    .doomsday-clock__unit:nth-child(even) {
      border-left: 1px solid rgba(255, 255, 255, 0.06);
    }

    .doomsday-clock__value {
      font-size: clamp(2rem, 13vw, 3.2rem);
    }

    .doomsday-clock__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .doomsday-clock,
    .doomsday-clock::before {
      transition: none;
    }
  }
</style>


<script>
  const initDoomsdayClocks = () => {
    document.querySelectorAll('[data-doomsday-clock]').forEach((clock) => {
      if (!(clock instanceof HTMLElement) || clock.dataset.clockReady === 'true') {
        return;
      }

      const target = Date.parse(clock.dataset.target ?? '');
      const yearsNode = clock.querySelector('[data-clock-years]');
      const monthsNode = clock.querySelector('[data-clock-months]');
      const daysNode = clock.querySelector('[data-clock-days]');
      const hoursNode = clock.querySelector('[data-clock-hours]');
      const minutesNode = clock.querySelector('[data-clock-minutes]');
      const secondsNode = clock.querySelector('[data-clock-seconds]');

      if (
        Number.isNaN(target) ||
        !yearsNode ||
        !monthsNode ||
        !daysNode ||
        !hoursNode ||
        !minutesNode ||
        !secondsNode
      ) {
        return;
      }

      const pad = (value, width = 2) => String(value).padStart(width, '0');
      const DAY_MS = 24 * 60 * 60 * 1000;
      const HOUR_MS = 60 * 60 * 1000;
      const MINUTE_MS = 60 * 1000;
      const SECOND_MS = 1000;

      const daysInUtcMonth = (year, month) =>
        new Date(Date.UTC(year, month + 1, 0)).getUTCDate();

      const buildUtcDate = (source, year, month) => {
        const day = Math.min(
          source.getUTCDate(),
          daysInUtcMonth(year, month)
        );

        return new Date(
          Date.UTC(
            year,
            month,
            day,
            source.getUTCHours(),
            source.getUTCMinutes(),
            source.getUTCSeconds(),
            source.getUTCMilliseconds()
          )
        );
      };

      const addUtcYears = (source, years) =>
        buildUtcDate(
          source,
          source.getUTCFullYear() + years,
          source.getUTCMonth()
        );

      const addUtcMonths = (source, months) => {
        const totalMonths =
          source.getUTCFullYear() * 12 +
          source.getUTCMonth() +
          months;
        const year = Math.floor(totalMonths / 12);
        const month = totalMonths - year * 12;

        return buildUtcDate(source, year, month);
      };

      const update = () => {
        const now = new Date();
        const targetDate = new Date(target);

        if (now.getTime() >= target) {
          yearsNode.textContent = '000';
          monthsNode.textContent = '00';
          daysNode.textContent = '00';
          hoursNode.textContent = '00';
          minutesNode.textContent = '00';
          secondsNode.textContent = '00';
          return;
        }

        let years = targetDate.getUTCFullYear() - now.getUTCFullYear();
        let cursor = addUtcYears(now, years);

        if (cursor.getTime() > target) {
          years -= 1;
          cursor = addUtcYears(now, years);
        }

        let months =
          (targetDate.getUTCFullYear() - cursor.getUTCFullYear()) * 12 +
          (targetDate.getUTCMonth() - cursor.getUTCMonth());
        let monthCursor = addUtcMonths(cursor, months);

        if (monthCursor.getTime() > target) {
          months -= 1;
          monthCursor = addUtcMonths(cursor, months);
        }

        const remainingAfterMonths = target - monthCursor.getTime();
        const days = Math.floor(remainingAfterMonths / DAY_MS);
        let remainder = remainingAfterMonths - days * DAY_MS;

        const hours = Math.floor(remainder / HOUR_MS);
        remainder -= hours * HOUR_MS;

        const minutes = Math.floor(remainder / MINUTE_MS);
        remainder -= minutes * MINUTE_MS;

        const seconds = Math.floor(remainder / SECOND_MS);

        yearsNode.textContent = pad(years, 3);
        monthsNode.textContent = pad(months);
        daysNode.textContent = pad(days);
        hoursNode.textContent = pad(hours);
        minutesNode.textContent = pad(minutes);
        secondsNode.textContent = pad(seconds);
      };

      clock.dataset.clockReady = 'true';
      update();
      window.setInterval(update, 1000);
    });
  };

  initDoomsdayClocks();
  document.addEventListener('astro:page-load', initDoomsdayClocks);
</script>
