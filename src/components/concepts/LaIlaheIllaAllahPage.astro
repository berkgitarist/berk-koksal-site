---
import albumRecordsEn from '../../data/albums.json';
import albumRecordsTr from '../../data/albums.tr.json';
import content from '../../data/la-ilahe-illa-allah-content.json';

interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;
const tr = lang === 'tr';
const prefix = tr ? '/tr' : '';
const c = tr ? content.tr : content.en;
const albums = tr ? albumRecordsTr : albumRecordsEn;
const album = albums.find((entry) => entry.slug === 'la-ilahe-illa-allah');
if (!album) throw new Error('Missing la-ilahe-illa-allah album record');

const romans = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV', 'XVI', 'XVII', 'XVIII', 'XIX'];
const songPhrase = album.tracks[0]?.split(' \u2014 ').slice(1).join(' \u2014 ') || album.title;
const spotifyId = album.spotify?.match(/^https:\/\/open\.spotify\.com\/(?:intl-[^/]+\/)?album\/([A-Za-z0-9]+)(?:[/?#]|$)/)?.[1];
const spotifySource = spotifyId ? `https://open.spotify.com/album/${spotifyId}` : null;
const spotifyEmbed = spotifyId ? `https://open.spotify.com/embed/album/${spotifyId}` : null;
---

<main class="bkx" id="main-xix">
  <div class="bkx__inner">
    <div class="bkx__masthead" aria-label={tr ? 'Alb\u00fcm serisi' : 'Album series'}>
      <span>BERK K&#214;KSAL</span>
      <span>NEO-SACRED ZIKR <span aria-hidden="true">/</span> XIX <span aria-hidden="true">/</span> 2026</span>
    </div>

    <section class="bkx-hero" aria-labelledby="bkx-hero-title">
      <div class="bkx-hero__art">
        <a href={album.cover} target="_blank" rel="noopener noreferrer" aria-label={c.coverAlt} class="bkx-hero__cover">
          <img src={album.cover} alt={c.coverAlt} width="2048" height="2048" fetchpriority="high" decoding="async" />
        </a>
        <span class="bkx-hero__caption">BERK K&#214;KSAL <span aria-hidden="true">/</span> XIX <span aria-hidden="true">/</span> 19 TRACKS OF ZIKR</span>
      </div>
      <div class="bkx-hero__copy">
        <p class="bkx-eyebrow">{c.heroEyebrow}</p>
        <h1 id="bkx-hero-title">{album.title}</h1>
        <p class="bkx-hero__claim">{c.heroSubtitle}</p>
        <p class="bkx-hero__intro">{c.heroLead}</p>
        <div class="bkx-chips" aria-label={tr ? 'Alb\u00fcm bilgileri' : 'Album facts'}>
          <span>XIX</span><span>19 {tr ? 'BESTE' : 'COMPOSITIONS'}</span><span>2026</span><span>NEO-SACRED ZIKR</span>
        </div>
        <nav class="bkx-hero__links" aria-label={tr ? 'Sayfa b\u00f6l\u00fcmleri' : 'Page sections'}>
          <a href="#concept">{c.conceptNav} <span aria-hidden="true">&#8595;</span></a>
          <a href="#works">{c.tracksNav} <span aria-hidden="true">&#8595;</span></a>
          <a href="#manifesto">{c.manifestoNav} <span aria-hidden="true">&#8595;</span></a>
        </nav>
      </div>
    </section>

    {spotifySource && spotifyEmbed ? (
      <section class="bkx-stream" id="stream" aria-label={c.statusLive}>
        <div class="bkx-stream__row"><span class="bkx-signal" aria-hidden="true">&#9673;</span><strong>{c.statusLive}</strong><a href={spotifySource} target="_blank" rel="noopener noreferrer">{c.playButton} <span aria-hidden="true">&#8599;</span></a></div>
        <iframe src={spotifyEmbed} title={c.statusLive} width="100%" height="440" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
      </section>
    ) : (
      <section class="bkx-status" role="status" aria-label={c.statusLabel}>
        <span class="bkx-status__dot" aria-hidden="true"></span>
        <div><strong>{c.statusLabel}</strong><p>{c.statusPending}</p></div>
      </section>
    )}

    <section id="concept" class="bkx-section bkx-question" aria-labelledby="bkx-concept-heading">
      <div><span class="bkx-eyebrow">{c.conceptEyebrow}</span><h2 id="bkx-concept-heading">{c.conceptTitle}</h2></div>
      <div class="bkx-prose">{c.conceptParagraphs.map((p) => <p>{p}</p>)}</div>
    </section>

    <section class="bkx-section bkx-voice" aria-labelledby="bkx-voice-heading">
      <span class="bkx-watermark" aria-hidden="true">XIX</span>
      <div class="bkx-voice__body"><span class="bkx-eyebrow">{c.identityEyebrow}</span><h2 id="bkx-voice-heading">{c.identityTitle}</h2><div class="bkx-prose">{c.identityParagraphs.map((p) => <p>{p}</p>)}</div></div>
    </section>

    <section id="works" class="bkx-section bkx-works" aria-labelledby="bkx-works-heading">
      <div class="bkx-section__heading"><span class="bkx-eyebrow">{c.tracksEyebrow}</span><h2 id="bkx-works-heading">{c.tracksTitle}</h2><p>{c.tracksIntro}</p></div>
      <ol class="bkx-works__list">
        {album.tracks.map((track, index) => (
          <li class="bkx-track">
            <span class="bkx-track__index" aria-hidden="true">{romans[index]}</span>
            <span class="bkx-track__name">{track.split(' \u2014 ').slice(1).join(' \u2014 ') || track}</span>
            <span class="bkx-track__position" aria-label={tr ? `Eser ${index + 1}` : `Work ${index + 1}`}>{String(index + 1).padStart(2, '0')}</span>
          </li>
        ))}
      </ol>
    </section>

    <section id="lyrics" class="bkx-section bkx-lyrics" aria-labelledby="bkx-lyrics-heading">
      <span class="bkx-eyebrow">{c.lyricsEyebrow}</span><h2 id="bkx-lyrics-heading">{c.lyricsTitle}</h2>
      <p class="bkx-lyrics__phrase">{songPhrase}</p><p class="bkx-lyrics__subtitle">{c.lyricsSubtitle}</p>
    </section>

    <section id="artwork" class="bkx-section bkx-artwork" aria-labelledby="bkx-art-heading">
      <div><span class="bkx-eyebrow">{c.artEyebrow}</span><h2 id="bkx-art-heading">{c.artTitle}</h2><div class="bkx-prose">{c.artParagraphs.map((p) => <p>{p}</p>)}</div><a href={`${prefix}/why-19/`} class="bkx-inline-link">{c.why19Link} <span aria-hidden="true">&#8599;</span></a></div>
      <div class="bkx-artwork__seal" aria-hidden="true"><span>XIX</span><small>19 TRACKS OF ZIKR</small></div>
    </section>

    <section id="manifesto" class="bkx-section bkx-manifesto" aria-labelledby="bkx-manifesto-heading">
      <div class="bkx-section__heading"><span class="bkx-eyebrow">{c.manifestoEyebrow}</span><h2 id="bkx-manifesto-heading">{c.manifestoTitle}</h2></div>
      <div class="bkx-manifesto__paper">
        <div class="bkx-manifesto__symbol" aria-hidden="true">XIX</div>
        <div class="bkx-prose bkx-manifesto__lead">{c.manifestoIntro.map((p) => <p>{p}</p>)}</div>
        {c.manifestoSections.map((section) => (
          <article class="bkx-manifesto__chapter"><h3>{section.title}</h3><div class="bkx-prose">{section.paragraphs.map((p) => <p>{p}</p>)}</div></article>
        ))}
        <p class="bkx-manifesto__note">{c.manifestoNote}</p>
      </div>
    </section>

    <footer class="bkx-footer">
      <span aria-hidden="true">XIX</span>
      <div class="bkx-footer__links"><a href={`${prefix}/neo-sacred-zikr/`}>{c.footerBack} <span aria-hidden="true">&#8599;</span></a><a href={`${prefix}/writings/`}>{c.footerWritings} <span aria-hidden="true">&#8599;</span></a></div>
      <p>BERK K&#214;KSAL <span aria-hidden="true">/</span> NEO-SACRED ZIKR <span aria-hidden="true">/</span> 2026</p>
    </footer>
  </div>
</main>

<style>
  .bkx{--night:#080d2d;--navy:#111b58;--cyan:#36e4d1;--sky:#9ac9de;--ivory:#fffef3;--mute:#b5c5da;position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 48% 2%,rgba(26,44,123,.80),transparent 39%),radial-gradient(ellipse at 100% 38%,rgba(12,112,122,.13),transparent 39%),linear-gradient(150deg,#090e30 2%,#0b1646 48%,#090e31 100%);color:var(--ivory);font-family:Inter,system-ui,sans-serif;padding:2.15rem 1rem 4rem;min-height:100vh;}
  .bkx:before{content:'';position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);opacity:.75;}
  .bkx__inner{max-width:1190px;margin:0 auto;}
  .bkx__masthead{display:flex;justify-content:space-between;gap:1rem;align-items:center;color:#87d5d5;font-size:.65rem;letter-spacing:.2em;font-weight:700;margin:0 0 3.3rem;}
  .bkx__masthead>span:last-child{color:#94a7c4;text-align:right;}
  .bkx-hero{display:grid;grid-template-columns:minmax(0,.94fr) minmax(0,1.06fr);gap:clamp(2rem,5vw,5rem);align-items:center;padding-bottom:clamp(3.4rem,7vw,7rem);}
  .bkx-hero__art{min-width:0;}
  .bkx-hero__cover{display:block;border-radius:8px;padding:9px;background:linear-gradient(145deg,#39e5d2,#a8fcfa 23%,#102765 65%,#34dcd7);box-shadow:0 34px 80px rgba(0,0,0,.35),0 0 95px rgba(18,221,207,.1);transition:transform .25s ease,box-shadow .25s ease;}
  .bkx-hero__cover:hover{transform:translateY(-3px);box-shadow:0 38px 100px rgba(0,0,0,.42),0 0 110px rgba(18,221,207,.2);}
  .bkx-hero__cover:focus-visible,.bkx a:focus-visible{outline:3px solid var(--cyan);outline-offset:4px;}
  .bkx-hero__cover img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;background:white;border-radius:2px;}
  .bkx-hero__caption{display:block;margin-top:1.05rem;color:#98b9cd;text-align:center;letter-spacing:.15em;font-weight:700;font-size:.65rem;}
  .bkx-eyebrow{display:block;color:var(--cyan);letter-spacing:.21em;font-size:.7rem;line-height:1.7;font-weight:800;text-transform:uppercase;}
  .bkx-hero h1{color:var(--ivory);font:700 clamp(3.1rem,5.7vw,6.1rem)/1.05 Georgia,'Times New Roman',serif;letter-spacing:-.055em;margin:.75rem 0 1.6rem;overflow-wrap:anywhere;}
  .bkx-hero__claim{font-weight:800;font-size:clamp(1.02rem,1.6vw,1.25rem);line-height:1.65;letter-spacing:.05em;color:#9cf5e6;margin:0 0 1.2rem;}
  .bkx-hero__intro{max-width:580px;font-size:1.03rem;line-height:1.9;color:#cfdeed;margin:0;}
  .bkx-chips{display:flex;flex-wrap:wrap;gap:.6rem;margin:2rem 0;}
  .bkx-chips span{border:1px solid rgba(63,226,210,.28);background:rgba(45,219,210,.07);border-radius:20rem;font-size:.63rem;color:#b7edf0;letter-spacing:.07em;font-weight:700;padding:.58rem .83rem;}
  .bkx-hero__links{display:flex;gap:.6rem;flex-wrap:wrap;}
  .bkx-hero__links a{color:#e9fefb;display:inline-flex;gap:.7rem;align-items:center;text-decoration:none;border:1px solid rgba(129,217,219,.35);background:rgba(255,255,255,.055);padding:.78rem 1rem;border-radius:999px;font-size:.76rem;font-weight:700;transition:background .2s;}
  .bkx-hero__links a:hover{background:rgba(49,209,201,.2);}
  .bkx-status{display:flex;gap:1.1rem;align-items:start;border:1px solid rgba(81,212,205,.23);background:rgba(35,206,187,.055);border-radius:18px;padding:1.35rem 1.55rem;margin-bottom:4rem;}
  .bkx-status__dot{flex:none;width:11px;height:11px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 5px rgba(54,228,209,.12);margin-top:.22rem;}
  .bkx-status strong{color:#b5f1e9;font-size:.72rem;letter-spacing:.17em;}
  .bkx-status p{color:#b8cede;line-height:1.7;margin:.45rem 0 0;font-size:.91rem;}
  .bkx-stream{margin-bottom:4rem;padding:1.15rem;background:rgba(29,185,84,.07);border:1px solid rgba(29,185,84,.26);border-radius:20px;}
  .bkx-stream__row{display:flex;align-items:center;gap:.8rem;margin-bottom:1rem;font-size:.82rem;}
  .bkx-stream__row strong{color:#a4efc6;letter-spacing:.08em;}
  .bkx-stream__row a{margin-left:auto;color:#d7ffe5;font-weight:700;text-decoration:none;}
  .bkx-stream iframe{display:block;width:100%;height:clamp(340px,40vw,440px);border:0;border-radius:12px;}
  .bkx-signal{color:#1db954;font-size:1.2rem;}
  .bkx-section{padding:clamp(3.4rem,6.5vw,6.3rem) 0;position:relative;scroll-margin-top:100px;border-bottom:1px solid rgba(144,213,226,.14);}
  .bkx-section h2{font:600 clamp(2rem,4vw,4rem)/1.16 Georgia,'Times New Roman',serif;letter-spacing:-.032em;margin:.7rem 0 0;color:#f9fcf4;}
  .bkx-prose{font-size:1.02rem;line-height:1.88;color:#c0cfe0;}
  .bkx-prose p{margin:0 0 1.15rem;}
  .bkx-prose p:last-child{margin-bottom:0;}
  .bkx-question{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,5vw,5rem);}
  .bkx-voice{overflow:hidden;min-height:310px;display:flex;align-items:center;padding-inline:clamp(1.5rem,5vw,5rem);border:1px solid rgba(52,226,209,.2);border-radius:28px;background:radial-gradient(ellipse at 90% 20%,rgba(36,221,197,.13),transparent 46%),rgba(10,23,72,.8);}
  .bkx-voice__body{position:relative;z-index:1;max-width:850px;}
  .bkx-voice h2{margin-bottom:1.6rem;}
  .bkx-watermark{position:absolute;right:-1rem;bottom:-5rem;color:rgba(140,233,227,.04);font:600 clamp(12rem,26vw,27rem)/1 Georgia,serif;pointer-events:none;}
  .bkx-section__heading{max-width:920px;margin-bottom:2.3rem;}
  .bkx-section__heading>p{margin:1.15rem 0 0;color:#c0cfe0;line-height:1.8;max-width:770px;}
  .bkx-works__list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem 1rem;margin:0;padding:0;}
  .bkx-track{display:grid;grid-template-columns:56px minmax(0,1fr) 30px;gap:.95rem;align-items:center;padding:1.17rem 1.2rem;border-radius:13px;background:rgba(255,255,255,.035);border:1px solid rgba(185,221,230,.105);min-width:0;}
  .bkx-track__index{font:600 1.36rem Georgia,serif;color:var(--cyan);}
  .bkx-track__name{font-weight:650;font-size:.96rem;line-height:1.55;color:#f4f7fa;min-width:0;overflow-wrap:anywhere;}
  .bkx-track__position{color:#7e9fbc;font:700 .65rem Inter,system-ui,sans-serif;justify-self:end;}
  .bkx-lyrics{text-align:center;padding:5rem 1rem;background:radial-gradient(ellipse at center,rgba(40,220,212,.065),transparent 65%);}
  .bkx-lyrics h2{font-size:clamp(1.7rem,3vw,2.8rem);}
  .bkx-lyrics__phrase{font:500 clamp(2rem,5.5vw,5.8rem)/1.2 Georgia,serif;color:#fdfcf1;letter-spacing:-.03em;margin:2rem auto 1.2rem;max-width:1000px;}
  .bkx-lyrics__subtitle{color:#8ec8d1;letter-spacing:.12em;font-size:.77rem;}
  .bkx-artwork{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);align-items:center;gap:3rem;}
  .bkx-artwork h2{margin-bottom:1.55rem;}
  .bkx-inline-link{display:inline-flex;gap:.65rem;margin-top:1.4rem;font-weight:800;font-size:.88rem;color:#9cf6e8;text-decoration:underline;text-underline-offset:6px;}
  .bkx-artwork__seal{width:min(100%,265px);aspect-ratio:1;margin:auto;border:3px solid #3fd2c6;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.35rem;box-shadow:0 0 0 8px rgba(58,207,201,.06),0 0 0 17px rgba(58,207,201,.025);}
  .bkx-artwork__seal span{font:400 clamp(5rem,10vw,7.7rem)/1 Georgia,serif;color:#fbfaee;}
  .bkx-artwork__seal small{font-size:.6rem;letter-spacing:.13em;color:#79d4d4;font-weight:800;}
  .bkx-manifesto__paper{position:relative;overflow:hidden;margin-top:2.4rem;padding:clamp(1.45rem,5.6vw,5.3rem);background:linear-gradient(150deg,rgba(17,31,84,.96),rgba(8,18,61,.93));border:1px solid rgba(95,218,213,.27);border-radius:24px;}
  .bkx-manifesto__symbol{position:absolute;right:-.8rem;top:-5.4rem;color:rgba(72,223,211,.04);font:500 clamp(12rem,27vw,27rem)/1 Georgia,serif;pointer-events:none;}
  .bkx-manifesto__lead{position:relative;max-width:820px;font-size:1.08rem;color:#e0e9ee;margin-bottom:2.5rem;}
  .bkx-manifesto__lead p:first-child{font:600 clamp(1.4rem,2.3vw,2.2rem)/1.45 Georgia,serif;color:#fffdf0;margin-bottom:1.2rem;}
  .bkx-manifesto__chapter{position:relative;border-top:1px solid rgba(143,217,222,.18);padding:2.15rem 0 1rem;max-width:920px;}
  .bkx-manifesto__chapter h3{color:#9ef4e5;font:600 clamp(1.4rem,2.2vw,2.05rem)/1.35 Georgia,serif;margin:0 0 1.05rem;}
  .bkx-manifesto__note{border-top:1px solid rgba(143,217,222,.14);padding-top:1.4rem;margin-top:1rem;font-size:.77rem;line-height:1.6;color:#91acc4;}
  .bkx-footer{padding:3rem 0 0;text-align:center;}
  .bkx-footer>span{font:400 clamp(6rem,13vw,11rem)/1 Georgia,serif;color:rgba(155,247,235,.2);}
  .bkx-footer__links{display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;margin:1.5rem 0 2.6rem;}
  .bkx-footer__links a{color:#a8f1e9;text-decoration:none;border-bottom:1px solid rgba(104,218,207,.4);padding-bottom:.4rem;font-weight:700;font-size:.83rem;}
  .bkx-footer p{letter-spacing:.19em;color:#799bb7;font-size:.65rem;font-weight:700;}
  @media(max-width:900px){.bkx-hero,.bkx-question,.bkx-artwork{grid-template-columns:1fr;}.bkx-hero__art{max-width:580px;margin:0 auto;width:100%;}.bkx-hero__copy{max-width:760px;}.bkx-artwork__seal{margin:2rem auto 0;}.bkx-works__list{grid-template-columns:1fr;}.bkx-hero{gap:2.5rem;}}
  @media(max-width:550px){.bkx{padding:1.2rem .82rem 3rem;}.bkx__masthead{font-size:.55rem;letter-spacing:.08em;margin:0 0 1.55rem;}.bkx-hero h1{font-size:clamp(2.65rem,12vw,4.4rem);}.bkx-hero__claim{font-size:.94rem;}.bkx-hero__cover{padding:5px;}.bkx-hero__caption{font-size:.52rem;letter-spacing:.05em;}.bkx-chips{gap:.4rem;}.bkx-chips span{font-size:.57rem;padding:.43rem .6rem;}.bkx-hero__links a{font-size:.69rem;padding:.65rem .8rem;}.bkx-track{grid-template-columns:42px minmax(0,1fr) 23px;padding:.9rem .75rem;gap:.6rem;}.bkx-track__index{font-size:1.1rem;}.bkx-track__name{font-size:.82rem;}.bkx-voice{padding:2rem 1.15rem;}.bkx-prose{font-size:.94rem;}.bkx-section{padding:3rem 0;}}
  @media(prefers-reduced-motion:reduce){.bkx-hero__cover,.bkx-hero__links a{transition:none;}}
</style>
