---
import { Icon } from "astro-icon/components";

interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;
const isTurkish = lang === 'tr';

const copy = isTurkish
  ? {
      platform: 'KURAN Araştırma Platformu',
      tagline: 'KURAN çalışması, ayet analizi ve araştırma araçları.',
      paragraph1: 'Berk KÖKSAL, müziğin yanı sıra KuranTeyit.com’un da yaratıcısıdır. KuranTeyit; KURAN ayetlerini okumak, incelemek ve analiz etmek için odaklı bir dijital deneyim sunan modern bir KURAN araştırma platformudur.',
      paragraph2: 'Proje; KURAN okuma, Arapça metin, çeviriler, ayet tabanlı araçlar, notlar ve analiz özelliklerini daha derin tefekkür ve araştırma için tek bir yapıda bir araya getirir.',
      paragraph3: "KuranTeyit, Neo-Sacred Zikr'in arkasındaki aynı vizyonun araştırma ve yazılım yönünü temsil eder: TANRI'yı hatırlamak, KURAN üzerinde tefekkür etmek ve kutsal bilgiyi daha erişilebilir hâle getirmek.",
      paragraph4: 'KuranTeyit; modern web teknolojilerini KURAN merkezli araştırma araçlarıyla birleştiren, fikir aşamasından tasarımına ve geliştirilmesine kadar Berk KÖKSAL tarafından bağımsız olarak oluşturulmuş bir yazılım projesidir.',
      visit: "KuranTeyit'i Ziyaret Et",
      android: 'Android Uygulamasını İndir',
      visitAria: "KuranTeyit.com'u ziyaret et",
      androidAria: "KuranTeyit Android uygulamasını Google Play'den indir",
      imageAlt: 'KuranTeyit.com masaüstü ve mobil KURAN araştırma platformu ön izlemesi',
    }
  : {
      platform: 'Quran Research Platform',
      tagline: 'Quran study, verse analysis and research tools.',
      paragraph1: 'Beyond music, Berk KÖKSAL is also the creator of KuranTeyit.com — a modern Quran research platform designed for reading, studying and analyzing Quran verses with a focused digital experience.',
      paragraph2: 'The project brings together Quran reading, Arabic text, translations, verse-based tools, notes and analysis features for deeper reflection and research.',
      paragraph3: 'KuranTeyit represents the research and software side of the same vision behind Neo-Sacred Zikr: remembering GOD, reflecting on the Quran and making sacred knowledge more accessible.',
      paragraph4: 'KuranTeyit is an independent software project fully conceived, designed and developed from the ground up by Berk KÖKSAL, combining modern web technologies with Quran-centered research tools.',
      visit: 'Visit KuranTeyit',
      android: 'Get Android App',
      visitAria: 'Visit KuranTeyit.com',
      androidAria: 'Download KuranTeyit for Android on Google Play',
      imageAlt: 'KuranTeyit.com desktop and mobile Quran research platform preview',
    };
---

<section class="quran-research-section mt-6 md:mt-16">
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.05fr] gap-10 items-center rounded-[2rem] border border-accent/20 bg-accent/5 p-6 md:p-10 overflow-hidden">

    <div class="relative group order-2 lg:order-1">
      <div class="absolute -inset-6 rounded-[2rem] bg-accent/20 blur-3xl opacity-40 group-hover:opacity-70 transition-opacity duration-700"></div>

      <a
        href="https://kuranteyit.com"
        target="_blank"
        rel="noopener noreferrer"
        class="relative block overflow-hidden rounded-[1.5rem] border border-accent/20 bg-black/10 p-2 md:p-3 shadow-2xl shadow-accent/10"
        aria-label={copy.visitAria}
      >
        <img
          src="/kuranteyit-preview-v3.png"
          alt={copy.imageAlt}
          width="2560"
          height="3419"
          loading="lazy"
          decoding="async"
          class="mx-auto block w-auto max-w-full object-contain transition-transform duration-700 group-hover:scale-[1.02]"
        />
      </a>
    </div>

    <div class="space-y-6 order-1 lg:order-2">

      <div>
        <p class="text-accent text-xs uppercase tracking-[0.35em] font-bold mb-4">
          {copy.platform}
        </p>

        <h2 class="text-4xl md:text-5xl font-heading font-bold text-maintext leading-tight">
          KuranTeyit.com
        </h2>

        <p class="text-accent/90 mt-3 font-body">
          {copy.tagline}
        </p>
      </div>

      <div class="space-y-4 text-subtext font-body leading-8">
        <p>{copy.paragraph1}</p>
        <p>{copy.paragraph2}</p>
        <p>{copy.paragraph3}</p>
        <p>{copy.paragraph4}</p>
      </div>

      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="https://kuranteyit.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-full border border-accent/30 bg-accent/10 px-7 py-3 text-maintext hover:bg-accent/20 hover:scale-105 transition-all"
        >
          <Icon name="mdi:book-open-page-variant" class="w-5 h-5" />
          {copy.visit}
        </a>

        <a
          href="https://play.google.com/store/apps/details?id=com.berkkoksal.kuranteyit"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-full border border-[#D4AF37]/30 bg-[#D4AF37]/10 px-7 py-3 text-maintext hover:bg-[#D4AF37]/20 hover:scale-105 transition-all"
          aria-label={copy.androidAria}
        >
          <Icon name="mdi:google-play" class="w-5 h-5" />
          {copy.android}
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  .quran-research-section {
    opacity: 0;
    transform: translateY(28px);
    animation: quranResearchReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.15s;
  }

  @keyframes quranResearchReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
