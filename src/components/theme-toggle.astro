---
---

<div class="top-controls">
  <!-- =========================================================
       AMBIENT SYMBOL / FALLING NOTES TOGGLE
       ========================================================= -->
  <button
    id="ambient-toggle"
    type="button"
    aria-label="Hide falling notes and Allah names"
    aria-pressed="false"
    data-enabled="true"
    title="Hide falling notes and Allah names"
  >
    <svg
      class="drop-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <!-- Damla -->
      <path
        d="M12 2.75C12 2.75 5.5 9.25 5.5 14.25C5.5 17.84 8.41 20.75 12 20.75C15.59 20.75 18.5 17.84 18.5 14.25C18.5 9.25 12 2.75 12 2.75Z"
      />

      <!-- Animasyon kapalıyken görünen çizgi -->
      <line
        class="drop-off-mark"
        x1="5"
        y1="5"
        x2="19"
        y2="19"
      />
    </svg>
  </button>

  <!-- =========================================================
       THEME TOGGLE
       ========================================================= -->
  <button
    id="theme-toggle"
    type="button"
    aria-label="Toggle Theme"
  >
    <!-- SUN -->
    <svg
      class="sun-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="5"></circle>

      <line x1="12" y1="1" x2="12" y2="3"></line>

      <line x1="12" y1="21" x2="12" y2="23"></line>

      <line
        x1="4.22"
        y1="4.22"
        x2="5.64"
        y2="5.64"
      ></line>

      <line
        x1="18.36"
        y1="18.36"
        x2="19.78"
        y2="19.78"
      ></line>

      <line
        x1="1"
        y1="12"
        x2="3"
        y2="12"
      ></line>

      <line
        x1="21"
        y1="12"
        x2="23"
        y2="12"
      ></line>

      <line
        x1="4.22"
        y1="19.78"
        x2="5.64"
        y2="18.36"
      ></line>

      <line
        x1="18.36"
        y1="5.64"
        x2="19.78"
        y2="4.22"
      ></line>
    </svg>

    <!-- MOON -->
    <svg
      class="moon-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      ></path>
    </svg>
  </button>
</div>

<style>
  /* =========================================================
     TOP RIGHT CONTROLS
     Damla solda, tema düğmesi sağda
     ========================================================= */

  .top-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
  }

  #ambient-toggle,
  #theme-toggle {
    width: 40px;
    height: 40px;

    padding: 0.5rem;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    background: transparent;
    border: none;
    border-radius: 50%;

    color: var(--color-maintext);

    cursor: pointer;

    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  #ambient-toggle:hover,
  #theme-toggle:hover {
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  #ambient-toggle:active,
  #theme-toggle:active {
    transform: scale(0.92);
  }

  #ambient-toggle:focus-visible,
  #theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* =========================================================
     DAMLA
     ========================================================= */

  .drop-icon {
    width: 24px;
    height: 24px;

    overflow: visible;

    transition:
      transform 0.25s ease,
      filter 0.25s ease;
  }

  #ambient-toggle:hover .drop-icon {
    transform: scale(1.06);
  }

  /*
   * Normal durumda çapraz çizgi görünmez.
   */
  .drop-off-mark {
    opacity: 0;

    transition:
      opacity 0.2s ease;
  }

  /*
   * Animasyon kapatıldığında:
   * - hafif accent arka plan
   * - çapraz çizgi
   * - hafif glow
   */
  #ambient-toggle[data-enabled="false"] {
    color: var(--color-accent);

    background:
      color-mix(
        in srgb,
        var(--color-accent),
        transparent 86%
      );

    box-shadow:
      0 0 16px
      color-mix(
        in srgb,
        var(--color-accent),
        transparent 80%
      );
  }

  #ambient-toggle[data-enabled="false"]
  .drop-off-mark {
    opacity: 1;
  }

  #ambient-toggle[data-enabled="false"]:hover {
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  /* =========================================================
     THEME ICON STATE
     ========================================================= */

  :global([data-theme$="-dark"]) .sun-icon {
    display: none;
  }

  :global([data-theme$="-light"]) .moon-icon {
    display: none;
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    #ambient-toggle,
    #theme-toggle,
    .drop-icon,
    .drop-off-mark {
      transition: none;
    }
  }
</style>

<script>
  const AMBIENT_STORAGE_KEY =
    'ambient-symbols-enabled';

  /**
   * localStorage'daki mevcut tercihi döndürür.
   *
   * Kayıt yoksa varsayılan olarak semboller açıktır.
   */
  function getAmbientSymbolsEnabled(): boolean {
    const savedValue =
      localStorage.getItem(
        AMBIENT_STORAGE_KEY
      );

    return savedValue !== 'false';
  }

  /**
   * Damla düğmesinin görsel ve erişilebilirlik
   * durumunu günceller.
   */
  function updateAmbientButton(
    button: HTMLButtonElement,
    enabled: boolean
  ): void {
    button.dataset.enabled =
      enabled
        ? 'true'
        : 'false';

    /*
     * aria-pressed burada "gizleme modu aktif mi?"
     * anlamında kullanılıyor.
     *
     * Semboller açıksa false,
     * semboller gizliyse true.
     */
    button.setAttribute(
      'aria-pressed',
      enabled
        ? 'false'
        : 'true'
    );

    const label =
      enabled
        ? 'Hide falling notes and Allah names'
        : 'Show falling notes and Allah names';

    button.setAttribute(
      'aria-label',
      label
    );

    button.title = label;
  }

  /**
   * Damla ve tema kontrollerini başlatır.
   *
   * data-bound sayesinde Astro sayfa geçişlerinde
   * aynı düğmeye iki kere listener eklenmez.
   */
  function initializeTopControls(): void {
    const ambientToggle =
      document.getElementById(
        'ambient-toggle'
      );

    const themeToggle =
      document.getElementById(
        'theme-toggle'
      );

    /* =======================================================
       AMBIENT / DAMLA TOGGLE
       ======================================================= */

    if (
      ambientToggle instanceof
      HTMLButtonElement
    ) {
      const enabled =
        getAmbientSymbolsEnabled();

      /*
       * İlk kullanım ise varsayılan tercihi kaydet.
       */
      if (
        localStorage.getItem(
          AMBIENT_STORAGE_KEY
        ) === null
      ) {
        localStorage.setItem(
          AMBIENT_STORAGE_KEY,
          'true'
        );
      }

      updateAmbientButton(
        ambientToggle,
        enabled
      );

      if (
        ambientToggle.dataset.bound !==
        'true'
      ) {
        ambientToggle.dataset.bound =
          'true';

        ambientToggle.addEventListener(
          'click',
          () => {
            const currentEnabled =
              getAmbientSymbolsEnabled();

            const nextEnabled =
              !currentEnabled;

            localStorage.setItem(
              AMBIENT_STORAGE_KEY,
              nextEnabled
                ? 'true'
                : 'false'
            );

            updateAmbientButton(
              ambientToggle,
              nextEnabled
            );

            /*
             * Layout.astro bu eventi dinliyor.
             *
             * false:
             * tüm semboller ANINDA silinir.
             *
             * true:
             * üretim yeniden başlar.
             */
            window.dispatchEvent(
              new CustomEvent(
                'ambient-symbols-change',
                {
                  detail: {
                    enabled:
                      nextEnabled
                  }
                }
              )
            );
          }
        );
      }
    }

    /* =======================================================
       THEME TOGGLE
       ======================================================= */

    if (
      themeToggle instanceof
      HTMLButtonElement &&
      themeToggle.dataset.bound !==
        'true'
    ) {
      themeToggle.dataset.bound =
        'true';

      themeToggle.addEventListener(
        'click',
        () => {
          const currentTheme =
            document.documentElement
              .getAttribute(
                'data-theme'
              ) ||
            'default-dark';

          const isDark =
            currentTheme.endsWith(
              '-dark'
            );

          const newTheme =
            isDark
              ? currentTheme.replace(
                  '-dark',
                  '-light'
                )
              : currentTheme.replace(
                  '-light',
                  '-dark'
                );

          document.documentElement
            .setAttribute(
              'data-theme',
              newTheme
            );

          localStorage.setItem(
            'theme',
            newTheme
          );
        }
      );
    }
  }

  initializeTopControls();

  /*
   * Astro View Transitions kullanılırsa
   * yeni sayfadaki düğmeleri yeniden hazırlar.
   */
  document.addEventListener(
    'astro:page-load',
    initializeTopControls
  );
</script>