---
import '../styles/global.css';

import SEO from '../components/seo.astro';
import { SITE_CONFIG } from '../config.ts';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'music.album';
  twitterCard?: 'summary' | 'summary_large_image';
  lang?: 'en' | 'tr';
}

const {
  title,
  description = 'Berk KÖKSAL - Composer, Guitarist, Music Producer, Software Engineer. Founder of Neo-Sacred Zikr.',
  canonical = Astro.url.pathname,
  ogImage = '/artist/berk-portrait.webp',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  lang = 'en'
} = Astro.props;

const baseTheme = SITE_CONFIG.baseTheme;
const defaultTheme = `${baseTheme}-dark`;
---

<!doctype html>

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png?v=2"
    />

    <link
      rel="apple-touch-icon"
      href="/artist-logo.webp"
    />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      twitterCard={twitterCard}
    />

    <script
      is:inline
      define:vars={{ baseTheme, defaultTheme }}
    >
      const savedTheme =
        localStorage.getItem(
          'theme'
        );

      if (
        savedTheme &&
        savedTheme.startsWith(
          baseTheme
        )
      ) {
        document.documentElement
          .setAttribute(
            'data-theme',
            savedTheme
          );
      } else {
        document.documentElement
          .setAttribute(
            'data-theme',
            defaultTheme
          );

        localStorage.setItem(
          'theme',
          defaultTheme
        );
      }
    </script>
  </head>

  <body
    class="relative min-h-screen overflow-x-hidden antialiased bg-container"
  >
    <!-- =====================================================
         FALLING NOTES / ALLAH NAMES CONTAINER
         ===================================================== -->

    <div
      id="matrix-container"
      aria-hidden="true"
      class="fixed top-0 left-0 w-full h-full pointer-events-none -z-10"
      style="mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 100%);"
    >
    </div>

    <!-- =====================================================
         PAGE CONTENT
         ===================================================== -->

    <main
      class="relative z-0 px-2 mx-auto sm:px-12 md:px-14 lg:px-28 max-w-360"
    >
      <slot />
    </main>

    <!-- =====================================================
         BACK TO TOP
         ===================================================== -->

    <button
      id="to-top"
      type="button"
      aria-label="Back to top"
      class="fixed bottom-8 right-8 z-50 flex items-center justify-center p-0 transition-all duration-500 translate-y-20 border rounded-full opacity-0 cursor-pointer group bg-background border-accent/10 shadow-2xl"
    >
      <svg
        class="w-14 h-14 -rotate-90"
        aria-hidden="true"
      >
        <circle
          cx="28"
          cy="28"
          r="24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          class="text-accent/5"
        >
        </circle>

        <circle
          id="progress-circle"
          cx="28"
          cy="28"
          r="24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-dasharray="150.7"
          stroke-dashoffset="150.7"
          stroke-linecap="round"
          class="transition-all duration-100 text-accent"
        >
        </circle>
      </svg>

      <div
        class="absolute transition-transform text-accent group-hover:scale-110"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M13.0001 7.82843V20H11.0001V7.82843L5.63614 13.1924L4.22192 11.7782L12.0001 4L19.7783 11.7782L18.3641 13.1924L13.0001 7.82843Z"
          >
          </path>
        </svg>
      </div>
    </button>

    <!-- =====================================================
         AMBIENT SYMBOLS + BACK TO TOP SCRIPT
         ===================================================== -->

    <script>
      /* =====================================================
         AMBIENT SYMBOL SYSTEM
         ===================================================== */

      const AMBIENT_STORAGE_KEY =
        'ambient-symbols-enabled';

      /*
       * Astro View Transition gibi durumlarda
       * önceki sayfadan kalan interval/listener varsa
       * temizleyebilmek için global controller.
       */
      type AmbientController = {
        destroy: () => void;
      };

      type AmbientWindow =
        Window & {
          __berkAmbientController?:
            AmbientController;
        };

      const ambientWindow =
        window as AmbientWindow;

      /*
       * Önceki sayfadan bir controller kaldıysa
       * kapat.
       */
      ambientWindow
        .__berkAmbientController
        ?.destroy();

      const ambientAbortController =
        new AbortController();

      const container =
        document.getElementById(
          'matrix-container'
        );

      const notes = [
        '♪',
        '♫',
        '♬',
        '♩',
        '♭',
        '♯'
      ];

      /*
       * Masaüstündeki sürekli üretim interval'i.
       */
      let ambientIntervalId:
        number | null = null;

      /*
       * Ekran yeniden boyutlandırıldığında
       * çok sık yeniden çizim yapılmasını engeller.
       */
      let ambientResizeTimeout:
        number | null = null;

      /*
       * Her düşen sembolün kendi silme timeout'u
       * burada tutulur.
       *
       * Damla kapatıldığında bunların tamamı
       * iptal edilir.
       */
      const removalTimeoutIds =
        new Set<number>();

      type AmbientMode =
        | 'desktop'
        | 'mobile'
        | null;

      let currentAmbientMode:
        AmbientMode = null;

      /*
       * Kullanıcının tercihi.
       *
       * localStorage'da false yoksa
       * varsayılan olarak AÇIK.
       */
      let ambientSymbolsEnabled =
        localStorage.getItem(
          AMBIENT_STORAGE_KEY
        ) !== 'false';

      /*
       * İşletim sisteminde Reduce Motion
       * seçilmişse hareketli arka plan
       * otomatik oluşturulmaz.
       */
      const prefersReducedMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

      /* =====================================================
         RANDOM SYMBOL
         ===================================================== */

      function randomSymbol(): string {
        const randomValue =
          Math.random();

        /*
         * Yaklaşık %2:
         * هو
         */
        if (
          randomValue < 0.02
        ) {
          return 'هو';
        }

        /*
         * Yaklaşık %8:
         * ﷲ
         */
        if (
          randomValue < 0.1
        ) {
          return 'ﷲ';
        }

        /*
         * Geri kalan:
         * müzik notaları.
         */
        const noteIndex =
          Math.floor(
            Math.random() *
            notes.length
          );

        return (
          notes[noteIndex] ??
          '♪'
        );
      }

      /* =====================================================
         DESKTOP FALLING SYMBOL
         ===================================================== */

      function createLetter(): void {
        /*
         * Kullanıcı sistemi kapattıysa
         * hiçbir şey oluşturma.
         */
        if (
          !container ||
          !ambientSymbolsEnabled
        ) {
          return;
        }

        const span =
          document.createElement(
            'span'
          );

        const character =
          randomSymbol();

        const color =
          '#D4AF37';

        const left =
          Math.random() * 100;

        const duration =
          8 +
          Math.random() * 10;

        const size =
          12 +
          Math.random() * 16;

        const drift =
          -30 +
          Math.random() * 60;

        const rotate =
          -40 +
          Math.random() * 80;

        span.innerText =
          character;

        span.className =
          'falling-letter falling-note';

        span.style.left =
          `${left}vw`;

        span.style.color =
          color;

        span.style.fontSize =
          `${size}px`;

        span.style.animationDuration =
          `${duration}s`;

        span.style.setProperty(
          '--note-drift',
          `${drift}px`
        );

        span.style.setProperty(
          '--note-rotate',
          `${rotate}deg`
        );

        span.style.textShadow =
          `0 0 8px ${color}, ` +
          '0 0 20px rgba(212, 175, 55, 0.35)';

        container.appendChild(
          span
        );

        /*
         * Normal şartlarda animasyon süresi
         * bittiğinde span DOM'dan kaldırılır.
         */
        const removalTimeoutId =
          window.setTimeout(
            () => {
              span.remove();

              removalTimeoutIds
                .delete(
                  removalTimeoutId
                );
            },
            duration * 1000
          );

        removalTimeoutIds.add(
          removalTimeoutId
        );
      }

      /* =====================================================
         MOBILE STATIC SYMBOL
         ===================================================== */

      function createStaticLetter():
        void {
        /*
         * Kullanıcı sistemi kapattıysa
         * statik sembol de oluşturma.
         */
        if (
          !container ||
          !ambientSymbolsEnabled
        ) {
          return;
        }

        const span =
          document.createElement(
            'span'
          );

        const character =
          randomSymbol();

        const color =
          '#D4AF37';

        const left =
          Math.random() * 100;

        const top =
          Math.random() * 90;

        const size =
          12 +
          Math.random() * 14;

        span.innerText =
          character;

        span.className =
          'falling-letter falling-note';

        span.style.animation =
          'none';

        span.style.left =
          `${left}vw`;

        span.style.top =
          `${top}vh`;

        span.style.color =
          color;

        span.style.fontSize =
          `${size}px`;

        span.style.opacity =
          (
            0.08 +
            Math.random() * 0.2
          ).toString();

        span.style.textShadow =
          `0 0 8px ${color}`;

        container.appendChild(
          span
        );
      }

      /* =====================================================
         REMOVE EVERYTHING
         ===================================================== */

      function clearAmbientSymbols():
        void {
        if (
          !container
        ) {
          return;
        }

        /*
         * EN ÖNEMLİ KISIM:
         *
         * Kullanıcı damlaya bastığında
         * semboller oldukları yerde DONMUYOR.
         *
         * Tamamen DOM'dan SİLİNİYOR.
         */
        container.replaceChildren();
      }

      /* =====================================================
         CLEAR SYMBOL REMOVAL TIMERS
         ===================================================== */

      function clearRemovalTimeouts():
        void {
        removalTimeoutIds.forEach(
          (timeoutId) => {
            window.clearTimeout(
              timeoutId
            );
          }
        );

        removalTimeoutIds.clear();
      }

      /* =====================================================
         STOP AMBIENT SYSTEM
         ===================================================== */

      function stopAmbientSymbols():
        void {
        /*
         * Yeni sembol üreten interval'i kapat.
         */
        if (
          ambientIntervalId !==
          null
        ) {
          window.clearInterval(
            ambientIntervalId
          );

          ambientIntervalId =
            null;
        }

        /*
         * Eski sembollerin timeout'larını kapat.
         */
        clearRemovalTimeouts();

        /*
         * Ekranda o anda bulunan
         * BÜTÜN nota / Allah / Hu sembollerini
         * ANINDA tamamen sil.
         */
        clearAmbientSymbols();

        currentAmbientMode =
          null;
      }

      /* =====================================================
         START AMBIENT SYSTEM
         ===================================================== */

      function startAmbientSymbols():
        void {
        /*
         * Önce eski sistemden kalan ne varsa
         * tamamen temizle.
         */
        stopAmbientSymbols();

        if (
          !container ||
          !ambientSymbolsEnabled ||
          prefersReducedMotion
        ) {
          return;
        }

        /*
         * Masaüstü.
         */
        if (
          window.innerWidth >
          768
        ) {
          currentAmbientMode =
            'desktop';

          /*
           * İlk sembolün görünmesi için
           * 450 ms beklemek zorunda kalmasın.
           */
          createLetter();

          /*
           * Sonrasında eski sistemdeki gibi
           * her 450 ms'de yeni sembol.
           */
          ambientIntervalId =
            window.setInterval(
              createLetter,
              450
            );

          return;
        }

        /*
         * Mobil.
         *
         * Orijinal tasarımındaki gibi
         * 18 adet statik sembol.
         */
        currentAmbientMode =
          'mobile';

        const mobileCount =
          18;

        for (
          let index = 0;
          index < mobileCount;
          index += 1
        ) {
          createStaticLetter();
        }
      }

      /* =====================================================
         TOGGLE EVENT
         ===================================================== */

      function handleAmbientChange(
        event: Event
      ): void {
        const customEvent =
          event as CustomEvent<{
            enabled?: boolean;
          }>;

        const enabled =
          customEvent.detail
            ?.enabled;

        if (
          typeof enabled !==
          'boolean'
        ) {
          return;
        }

        ambientSymbolsEnabled =
          enabled;

        /*
         * localStorage'ı Layout tarafında da
         * garanti altına al.
         */
        localStorage.setItem(
          AMBIENT_STORAGE_KEY,
          enabled
            ? 'true'
            : 'false'
        );

        if (
          enabled
        ) {
          /*
           * Tekrar açıldı.
           * Sistemi sıfırdan başlat.
           */
          startAmbientSymbols();

          return;
        }

        /*
         * KAPATILDI.
         *
         * Interval kapanır.
         * Timeout'lar kapanır.
         * Mevcut tüm semboller silinir.
         */
        stopAmbientSymbols();
      }

      window.addEventListener(
        'ambient-symbols-change',
        handleAmbientChange,
        {
          signal:
            ambientAbortController
              .signal
        }
      );

      /* =====================================================
         RESPONSIVE AMBIENT SYSTEM
         ===================================================== */

      function handleAmbientResize():
        void {
        if (
          !ambientSymbolsEnabled ||
          prefersReducedMotion
        ) {
          return;
        }

        if (
          ambientResizeTimeout !==
          null
        ) {
          window.clearTimeout(
            ambientResizeTimeout
          );
        }

        ambientResizeTimeout =
          window.setTimeout(
            () => {
              const nextMode:
                AmbientMode =
                window.innerWidth >
                768
                  ? 'desktop'
                  : 'mobile';

              /*
               * Sadece breakpoint değiştiyse
               * sistemi yeniden kur.
               */
              if (
                nextMode !==
                currentAmbientMode
              ) {
                startAmbientSymbols();
              }

              ambientResizeTimeout =
                null;
            },
            180
          );
      }

      window.addEventListener(
        'resize',
        handleAmbientResize,
        {
          passive: true,
          signal:
            ambientAbortController
              .signal
        }
      );

      /* =====================================================
         INITIAL AMBIENT STATE
         ===================================================== */

      /*
       * Sayfa ilk açıldığında kullanıcının
       * daha önce kaydettiği tercihe bakılır.
       *
       * false ise:
       * hiçbir sembol oluşturulmaz.
       *
       * true ise:
       * normal sistem başlar.
       */
      if (
        ambientSymbolsEnabled
      ) {
        startAmbientSymbols();
      } else {
        stopAmbientSymbols();
      }

      /* =====================================================
         CONTROLLER CLEANUP
         ===================================================== */

      ambientWindow
        .__berkAmbientController = {
          destroy: () => {
            ambientAbortController
              .abort();

            if (
              ambientResizeTimeout !==
              null
            ) {
              window.clearTimeout(
                ambientResizeTimeout
              );

              ambientResizeTimeout =
                null;
            }

            stopAmbientSymbols();
          }
        };

      /* =====================================================
         BACK TO TOP
         ===================================================== */

      const toTopButton =
        document.getElementById(
          'to-top'
        );

      const progressCircle =
        document.getElementById(
          'progress-circle'
        );

      const arrowIcon =
        toTopButton?.querySelector<
          HTMLElement
        >(
          '.absolute'
        );

      const circumference =
        150.796;

      function handleScroll():
        void {
        const scrollableHeight =
          document.documentElement
            .scrollHeight -
          window.innerHeight;

        const scrollPercentage =
          scrollableHeight > 0
            ? window.scrollY /
              scrollableHeight
            : 0;

        const boundedPercentage =
          Math.min(
            Math.max(
              scrollPercentage,
              0
            ),
            1
          );

        const offset =
          circumference -
          boundedPercentage *
          circumference;

        if (
          progressCircle
        ) {
          progressCircle.style
            .strokeDashoffset =
            offset.toString();
        }

        if (
          boundedPercentage >
          0.5
        ) {
          toTopButton?.classList
            .remove(
              'translate-y-20',
              'opacity-0'
            );

          toTopButton?.classList
            .add(
              'translate-y-0',
              'opacity-100'
            );
        } else {
          toTopButton?.classList
            .add(
              'translate-y-20',
              'opacity-0'
            );

          toTopButton?.classList
            .remove(
              'translate-y-0',
              'opacity-100'
            );
        }

        if (
          boundedPercentage >
          0.98
        ) {
          arrowIcon?.classList
            .add(
              'animate-bounce-twice'
            );
        } else {
          arrowIcon?.classList
            .remove(
              'animate-bounce-twice'
            );
        }
      }

      window.addEventListener(
        'scroll',
        handleScroll,
        {
          passive: true
        }
      );

      handleScroll();

      toTopButton?.addEventListener(
        'click',
        () => {
          if (
            prefersReducedMotion
          ) {
            window.scrollTo({
              top: 0,
              behavior: 'auto'
            });

            return;
          }

          arrowIcon?.classList.add(
            'launching'
          );

          const startPosition =
            window.scrollY;

          const duration =
            750;

          let startTime:
            number | null = null;

          let requestId:
            number | null = null;

          const stopAnimation =
            (): void => {
              if (
                requestId !==
                null
              ) {
                cancelAnimationFrame(
                  requestId
                );
              }

              arrowIcon?.classList
                .remove(
                  'launching'
                );

              window
                .removeEventListener(
                  'wheel',
                  stopAnimation
                );

              window
                .removeEventListener(
                  'touchmove',
                  stopAnimation
                );
            };

          function easeOutQuad(
            elapsed: number,
            start: number,
            change: number,
            totalDuration: number
          ): number {
            const normalized =
              elapsed /
              totalDuration;

            return (
              -change *
                normalized *
                (
                  normalized -
                  2
                ) +
              start
            );
          }

          function animation(
            currentTime: number
          ): void {
            if (
              startTime ===
              null
            ) {
              startTime =
                currentTime;
            }

            const timeElapsed =
              currentTime -
              startTime;

            const nextPosition =
              easeOutQuad(
                timeElapsed,
                startPosition,
                -startPosition,
                duration
              );

            window.scrollTo(
              0,
              nextPosition
            );

            if (
              timeElapsed <
              duration
            ) {
              requestId =
                requestAnimationFrame(
                  animation
                );
            } else {
              stopAnimation();
            }
          }

          window.addEventListener(
            'wheel',
            stopAnimation,
            {
              once: true
            }
          );

          window.addEventListener(
            'touchmove',
            stopAnimation,
            {
              once: true
            }
          );

          requestId =
            requestAnimationFrame(
              animation
            );
        }
      );
    </script>

    <!-- =====================================================
         PRO CARD MOUSE EFFECT
         ===================================================== -->

    <script is:inline>
      document
        .querySelectorAll(
          '.pro-card'
        )
        .forEach(
          (card) => {
            card.addEventListener(
              'mousemove',
              (event) => {
                if (
                  !(
                    card instanceof
                    HTMLElement
                  ) ||
                  !(
                    event instanceof
                    MouseEvent
                  )
                ) {
                  return;
                }

                const rectangle =
                  card
                    .getBoundingClientRect();

                card.style
                  .setProperty(
                    '--mouse-x',
                    `${event.clientX - rectangle.left}px`
                  );

                card.style
                  .setProperty(
                    '--mouse-y',
                    `${event.clientY - rectangle.top}px`
                  );
              }
            );
          }
        );
    </script>
  </body>
</html>